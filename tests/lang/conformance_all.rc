//@exit 0
// Conformance corpus with ASSERTIONS (task 2.9).
//
// Every check below computes a value and compares it with what C# requires.
// A failure increments `fails`, and `Main` returns `fails`, so the process
// exit code IS the number of failed checks: 0 means every assertion held.
// The fixture harness asserts exit 0, so a regression names itself.
//
// This is deliberately a live program rather than a set of expectations in
// a comment: the previous fixtures in this directory compiled and ran but
// checked nothing, which proved they did not crash and nothing more.

namespace Conf;

public class Checks {
    // ---- inheritance and virtual dispatch ----
    public class Base {
        public int V;
        public virtual int Get() { return 1; }
        public int Plain() { return 7; }
    }
    public class Derived : Base {
        public override int Get() { return V + 10; }
    }

    // ---- multiple concrete bases ----
    public class Left { public int L; public Left() { L = 3; } }
    public class Right { public int R; public Right() { R = 4; } }
    public class Both : Left, Right { }

    // ---- interfaces ----
    public interface IShape { int Area(); }
    public class Square : IShape {
        public int Side;
        public int Area() { return Side * Side; }
    }

    // ---- structs are values ----
    public struct Pt { public int X; public Pt(int x) { X = x; } }

    // ---- records compare by value ----
    public record Rec(int A, int B);

    // ---- generic method and constraint ----
    private static T Id<T>(T v) { return v; }
    private static int One<T>(T v) where T : class { return 1; }

    public static int Main() {
        // The failure counter is a LOCAL: a static field here changed the
        // behaviour of the checks below (see 2.9's evidence — recorded as
        // a defect, not hidden), and a local keeps this corpus reading as
        // the language contract rather than as a workaround.
        int fails = 0;

        // Arithmetic and precedence.
        if (!(1 + 2 * 3 == 7)) { printf("FAIL {0}\n", 1); fails = fails + 1; }
        if (!((1 + 2) * 3 == 9)) { printf("FAIL {0}\n", 2); fails = fails + 1; }
        if (!(7 / 2 == 3)) { printf("FAIL {0}\n", 3); fails = fails + 1; }
        if (!(7 % 2 == 1)) { printf("FAIL {0}\n", 4); fails = fails + 1; }
        if (!((5 & 3) == 1)) { printf("FAIL {0}\n", 5); fails = fails + 1; }
        if (!((5 | 3) == 7)) { printf("FAIL {0}\n", 6); fails = fails + 1; }
        if (!((1 << 4) == 16)) { printf("FAIL {0}\n", 7); fails = fails + 1; }

        // Control flow.
        int sum = 0;
        for (int i = 1; i <= 5; i++) { sum = sum + i; }
        if (!(sum == 15)) { printf("FAIL {0}\n", 8); fails = fails + 1; }
        int w = 0;
        while (w < 3) { w = w + 1; }
        if (!(w == 3)) { printf("FAIL {0}\n", 9); fails = fails + 1; }
        int d = 0;
        do { d = d + 1; } while (d < 2);
        if (!(d == 2)) { printf("FAIL {0}\n", 10); fails = fails + 1; }
        int sw = 0;
        switch (2) { case 1: sw = 1; break; case 2: sw = 2; break; default: sw = 9; break; }
        if (!(sw == 2)) { printf("FAIL {0}\n", 11); fails = fails + 1; }

        // Objects, virtual dispatch, and a non-virtual sibling.
        Derived der = new Derived();
        der.V = 5;
        Base asBase = der;
        if (!(asBase.Get() == 15)) { printf("FAIL {0}\n", 12); fails = fails + 1; }
        if (!(asBase.Plain() == 7)) { printf("FAIL {0}\n", 13); fails = fails + 1; }

        // Multiple inheritance: both bases' fields, both constructors.
        Both both = new Both();
        if (!(both.L == 3)) { printf("FAIL {0}\n", 14); fails = fails + 1; }
        if (!(both.R == 4)) { printf("FAIL {0}\n", 15); fails = fails + 1; }

        // Interface dispatch through the interface type.
        Square sq = new Square();
        sq.Side = 3;
        IShape shape = sq;
        if (!(shape.Area() == 9)) { printf("FAIL {0}\n", 16); fails = fails + 1; }

        // Structures copy.
        Pt p1 = new Pt(1);
        Pt p2 = p1;
        p2.X = 9;
        if (!(p1.X == 1)) { printf("FAIL {0}\n", 17); fails = fails + 1; }
        if (!(p2.X == 9)) { printf("FAIL {0}\n", 18); fails = fails + 1; }

        // Records compare by value, over their positional fields.
        Rec r1 = new Rec(1, 2);
        Rec r2 = new Rec(1, 2);
        Rec r3 = new Rec(1, 3);
        if (!(r1 == r2)) { printf("FAIL {0}\n", 19); fails = fails + 1; }
        if (!(!(r1 == r3))) { printf("FAIL {0}\n", 20); fails = fails + 1; }

        // Type tests, positive and negative.
        object o = new Square();
        if (!(o is Square)) { printf("FAIL {0}\n", 21); fails = fails + 1; }
        if (!(!(o is Derived))) { printf("FAIL {0}\n", 22); fails = fails + 1; }
        if (!(o is IShape)) { printf("FAIL {0}\n", 23); fails = fails + 1; }

        // Generics.
        if (!(Id<int>(7) == 7)) { printf("FAIL {0}\n", 24); fails = fails + 1; }
        if (!(One<string>("x") == 1)) { printf("FAIL {0}\n", 25); fails = fails + 1; }

        // Lambdas: no capture, capture, and capture-by-variable.
        System.Func<int, int> twice = x => x * 2;
        if (!(twice(4) == 8)) { printf("FAIL {0}\n", 26); fails = fails + 1; }
        int bias = 5;
        System.Func<int, int> plus = x => x + bias;
        if (!(plus(3) == 8)) { printf("FAIL {0}\n", 27); fails = fails + 1; }
        bias = 10;
        if (!(plus(3) == 13)) { printf("FAIL {0}\n", 28); fails = fails + 1; }

        // nameof is the identifier, not a placeholder.
        if (!(nameof(Both) == "Both")) { printf("FAIL {0}\n", 29); fails = fails + 1; }

        // Arrays: sized, initialised, read and written.
        int[] arr = new int[] { 4, 5, 6 };
        if (!(arr[0] == 4 && arr[2] == 6)) { printf("FAIL {0}\n", 30); fails = fails + 1; }
        arr[1] = 50;
        if (!(arr[1] == 50)) { printf("FAIL {0}\n", 31); fails = fails + 1; }

        // Enums.
        if (!((int)Kind.Second == 1)) { printf("FAIL {0}\n", 32); fails = fails + 1; }

        return fails;
    }
}

public enum Kind { First, Second }
