        {
            printf("TRACE|GENERIC_CONSTRAINT|DEFAULT_BASE|STRUCT_OVERLOAD|hasValue={0}\n", value.HasValue);
        }

        public abstract void Select<T>(T? value);
    }

    public class DefaultConstraintDerived : DefaultConstraintBase
    {
        public override void Select<T>(T? value) where T : default
        {
            printf("TRACE|GENERIC_CONSTRAINT|DEFAULT|OVERRIDE|isNull={0}\n", value is null);
        }
    }

    public class GenericInheritanceBase<T1, T2>
    {
        public T1 First;
        public T2 Second;

        public GenericInheritanceBase(T1 first, T2 second)
        {
            First = first;
            Second = second;
            printf("TRACE|GENERIC_INHERITANCE|BASE|CTOR\n");
        }

        public virtual T1 GetFirst() => First;
    }

    public class GenericInheritanceDerived<T1, T2, T3> : GenericInheritanceBase<T1, T2>, IGeneric3<T1, T2, T3>
    {
        public T3 Third;

        public GenericInheritanceDerived(T1 first, T2 second, T3 third)
            : base(first, second)
        {
            Third = third;
            printf("TRACE|GENERIC_INHERITANCE|DERIVED|CTOR\n");
        }

        public override T1 GetFirst()
        {
            printf("TRACE|GENERIC_INHERITANCE|DERIVED|GET_FIRST\n");
            return First;
        }
    }

    public class GenericConstraintBase
    {
        public int Value;
        public GenericConstraintBase() { Value = 100; }
    }

    public interface IGenericConstraintInterface
    {
        int ConstraintValue();
    }

    public class GenericConstraintDerived : GenericConstraintBase, IGenericConstraintInterface
    {
        public GenericConstraintDerived() { Value = 200; }
        public int ConstraintValue() => Value + 1;
    }

    public struct UnmanagedPair
    {
        public int A;
        public long B;
        public UnmanagedPair(int a, long b) { A = a; B = b; }
    }

    public static class GenericConstraints
    {
        public static T StructConstraint<T>(T value) where T : struct
        {
            printf("TRACE|GENERIC_CONSTRAINT|STRUCT|PASS\n");
            return value;
        }

        public static T ClassConstraint<T>(T value) where T : class
        {
            printf("TRACE|GENERIC_CONSTRAINT|CLASS|PASS\n");
            return value;
        }

        public static T UnmanagedConstraint<T>(T value) where T : unmanaged
        {
            printf("TRACE|GENERIC_CONSTRAINT|UNMANAGED|PASS\n");
            return value;
        }

        public static T NotNullConstraint<T>(T value) where T : notnull
        {
            printf("TRACE|GENERIC_CONSTRAINT|NOTNULL|PASS\n");
            return value;
        }

        public static T NewConstraint<T>() where T : new()
        {
            printf("TRACE|GENERIC_CONSTRAINT|NEW|CREATE\n");
            return new T();
        }

        public static int BaseConstraint<T>(T value) where T : GenericConstraintBase
        {
            printf("TRACE|GENERIC_CONSTRAINT|BASE|value={0}\n", value.Value);
            return value.Value;
        }

        public static int InterfaceConstraint<T>(T value) where T : IGenericConstraintInterface
        {
            int result = value.ConstraintValue();
            printf("TRACE|GENERIC_CONSTRAINT|INTERFACE|value={0}\n", result);
            return result;
        }

        public static int CombinedConstraint<T>(T value)
            where T : GenericConstraintBase, IGenericConstraintInterface, new()
        {
            T created = new T();
            int result = value.Value + value.ConstraintValue() + created.Value;
            printf("TRACE|GENERIC_CONSTRAINT|COMBINED|result={0}\n", result);
            return result;
        }

        public static TDerived TypeParameterConstraint<TBase, TDerived>(TDerived value)
            where TDerived : TBase
        {
            printf("TRACE|GENERIC_CONSTRAINT|TYPE_PARAMETER|PASS\n");
            return value;
        }

        public static T EnumConstraint<T>(T value) where T : System.Enum
        {
            printf("TRACE|GENERIC_CONSTRAINT|ENUM|PASS\n");
            return value;
        }

        public static T DelegateConstraint<T>(T value) where T : System.Delegate
        {
            printf("TRACE|GENERIC_CONSTRAINT|DELEGATE|PASS\n");
            return value;
        }
    }

    public static class GenericAlgorithms
    {
        public static T Identity<T>(int caseId, string label, T value)
        {
            printf("TRACE|GENERIC|IDENTITY|ENTER|case={0}|label={1}\n", caseId, label);
            printf("TRACE|GENERIC|IDENTITY|RETURN|case={0}|label={1}\n", caseId, label);
            return value;
        }

        public static TResult Convert<T, TResult>(int caseId, string label, T input, TResult result)
        {
            printf("TRACE|GENERIC|CONVERT|ENTER|case={0}|label={1}\n", caseId, label);
            printf("TRACE|GENERIC|CONVERT|RETURN|case={0}|label={1}\n", caseId, label);
            return result;
        }

        public static T[] MakeArray<T>(T value1, T value2, T value3)
        {
            printf("TRACE|GENERIC_SHAPE|MAKE_ARRAY|ENTER\n");
            T[] result = new T[] { value1, value2, value3 };
            printf("TRACE|GENERIC_SHAPE|MAKE_ARRAY|RETURN|length={0}\n", result.Length);
            return result;
        }

        public static T[,] MakeMatrix<T>(T value1, T value2, T value3, T value4)
        {
            printf("TRACE|GENERIC_SHAPE|MAKE_MATRIX|ENTER\n");
            T[,] result = new T[,] { { value1, value2 }, { value3, value4 } };
            printf("TRACE|GENERIC_SHAPE|MAKE_MATRIX|RETURN|rows={0}|columns={1}\n", result.GetLength(0), result.GetLength(1));
            return result;
        }

        public static GenericBox<T> MakeBox<T>(T value)
        {
            printf("TRACE|GENERIC_SHAPE|MAKE_BOX|ENTER\n");
            return new GenericBox<T>(value);
        }

        public static Generic2<T1, T2> MakePair<T1, T2>(T1 value1, T2 value2)
        {
            printf("TRACE|GENERIC_SHAPE|MAKE_PAIR|ENTER\n");
            return new Generic2<T1, T2>(value1, value2);
        }

        public static Generic3<T1, T2, T3> MakeTriple<T1, T2, T3>(T1 value1, T2 value2, T3 value3)
        {
            printf("TRACE|GENERIC_SHAPE|MAKE_TRIPLE|ENTER\n");
            return new Generic3<T1, T2, T3>(value1, value2, value3);
        }

        public static T DefaultValue<T>()
        {
            T value = default(T)!;
            printf("TRACE|GENERIC_SHAPE|DEFAULT_T|RETURN\n");
            return value;
        }

        public static T DefaultLiteral<T>()
        {
            T value = default!;
            printf("TRACE|GENERIC_SHAPE|DEFAULT_LITERAL|RETURN\n");
            return value;
        }

        public static T? NullableStructValue<T>(T value) where T : struct
        {
            printf("TRACE|GENERIC_SHAPE|NULLABLE_STRUCT|RETURN\n");
            return value;
        }

        public static T? NullableClassValue<T>(T? value) where T : class
        {
            printf("TRACE|GENERIC_SHAPE|NULLABLE_CLASS|RETURN|isNull={0}\n", value is null);
            return value;
        }

        public static ref T RefElement<T>(T[] values, int index)
        {
            printf("TRACE|GENERIC_SHAPE|REF_ELEMENT|index={0}\n", index);
            return ref values[index];
        }

        public static int ParamsLength<T>(params T[] values)
        {
            printf("TRACE|GENERIC_SHAPE|PARAMS|length={0}\n", values.Length);
            return values.Length;
        }

        public static T AddStatic<T>(T left, T right)
            where T : IStaticNumber<T>
        {
            printf("TRACE|GENERIC_MATH|ADD|ENTER\n");
            T result = left + right;
            printf("TRACE|GENERIC_MATH|ADD|RETURN\n");
            return result;
        }

        public static T MultiplyStatic<T>(T left, T right)
            where T : IStaticNumber<T>
        {
            printf("TRACE|GENERIC_MATH|MUL|ENTER\n");
            T result = left * right;
            printf("TRACE|GENERIC_MATH|MUL|RETURN\n");
            return result;
        }

        public static T UnsignedShiftStatic<T>(T value, int amount)
            where T : IStaticNumber<T>
        {
            printf("TRACE|GENERIC_MATH|USHR|ENTER|amount={0}\n", amount);
            T result = value >>> amount;
            printf("TRACE|GENERIC_MATH|USHR|RETURN\n");
            return result;
        }

        public static int StaticVirtualKind<T>() where T : IStaticNumber<T>
        {
            int result = T.Kind;
            printf("TRACE|GENERIC_MATH|STATIC_VIRTUAL|kind={0}\n", result);
            return result;
        }
    }
