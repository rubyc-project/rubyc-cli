            X = x;
            Y = y;
            printf("TRACE|CTOR|TestStruct|CREATE|x={0}|y={1}\n", X, Y);
        }

        public int Sum()
        {
            int result = X + Y;
            printf("TRACE|METHOD|TestStruct.Sum|RETURN|result={0}\n", result);
            return result;
        }

        public void Deconstruct(out int x, out int y)
        {
            x = X;
            y = Y;
            printf("TRACE|DECONSTRUCT|TestStruct|VALUES|x={0}|y={1}\n", x, y);
        }
    }

