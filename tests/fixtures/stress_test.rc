    public class IntBag
    {
        private int[] _values = new int[64];
        private int _count;

        public int Count => _count;

        public void Add(int value)
        {
            _values[_count] = value;
            printf("TRACE|COLLECTION_INIT|IntBag|ADD|index={0}|value={1}\n", _count, value);
            _count++;
        }

        public int this[int index] => _values[index];

        public IntBagEnumerator GetEnumerator() => new IntBagEnumerator(this);

        public class IntBagEnumerator
        {
            private IntBag _bag;
            private int _index;

            public IntBagEnumerator(IntBag bag)
            {
                _bag = bag;
                _index = -1;
                printf("TRACE|FOREACH|IntBagEnumerator|CTOR|count={0}\n", bag.Count);
            }

            public int Current => _bag[_index];

            public bool MoveNext()
            {
                _index++;
                bool result = _index < _bag.Count;
                printf("TRACE|FOREACH|IntBagEnumerator|MOVE_NEXT|index={0}|result={1}\n", _index, result);
                return result;
            }
        }
    }

    public delegate bool IntPredicate(int value);
    public delegate int IntSelector(int value);

    public class IntSequence
    {
        private int[] _values;
        private int _count;

        public IntSequence(int[] values, int count)
        {
            _values = values;
            _count = count;
            printf("TRACE|QUERY|IntSequence|CTOR|count={0}\n", count);
        }

        public IntSequence Where(IntPredicate predicate)
        {
            int[] output = new int[_count];
            int outputCount = 0;
            for (int i = 0; i < _count; i++)
            {
                bool keep = predicate(_values[i]);
                printf("TRACE|QUERY|WHERE|index={0}|value={1}|keep={2}\n", i, _values[i], keep);
                if (keep)
                {
                    output[outputCount] = _values[i];
                    outputCount++;
                }
            }
            return new IntSequence(output, outputCount);
        }

        public IntSequence Select(IntSelector selector)
        {
            int[] output = new int[_count];
            for (int i = 0; i < _count; i++)
            {
                output[i] = selector(_values[i]);
                printf("TRACE|QUERY|SELECT|index={0}|input={1}|output={2}\n", i, _values[i], output[i]);
            }
            return new IntSequence(output, _count);
        }

        public IntSequenceEnumerator GetEnumerator() => new IntSequenceEnumerator(this);

        public class IntSequenceEnumerator
        {
            private IntSequence _sequence;
            private int _index = -1;

            public IntSequenceEnumerator(IntSequence sequence)
            {
                _sequence = sequence;
            }

            public int Current => _sequence._values[_index];

            public bool MoveNext()
            {
                _index++;
                bool result = _index < _sequence._count;
                printf("TRACE|QUERY|ENUM|index={0}|result={1}\n", _index, result);
                return result;
            }
        }
    }

    public class EventSource
    {
        public event IntUnary? Changed;

        public int Raise(int value)
        {
            printf("TRACE|EVENT|EventSource|RAISE_ENTER|value={0}\n", value);
            IntUnary? handler = Changed;
            if (handler is null)
            {
                printf("TRACE|EVENT|EventSource|NO_HANDLER|value={0}\n", value);
                return -1;
            }

            int result = handler(value);
            printf("TRACE|EVENT|EventSource|RAISE_EXIT|result={0}\n", result);
            return result;
        }
    }

    public class DeterministicResource : System.IDisposable
    {
        public int Id;

        public DeterministicResource(int id)
        {
            Id = id;
            printf("TRACE|RESOURCE|DeterministicResource|CTOR|id={0}\n", Id);
        }

        public void Dispose()
        {
            printf("TRACE|RESOURCE|DeterministicResource|DISPOSE|id={0}\n", Id);
        }

        ~DeterministicResource()
        {
            printf("FINALIZER|DeterministicResource|id={0}\n", Id);
        }
    }

    public class CompilerTestException : System.Exception
    {
        public int Code;

        public CompilerTestException(int code, string message)
            : base(message)
        {
            Code = code;
            printf("TRACE|EXCEPTION|CompilerTestException|CTOR|code={0}|message={1}\n", Code, message);
        }
    }

    public class DerivedCompilerTestException : CompilerTestException
    {
        public int Detail;

        public DerivedCompilerTestException(int code, int detail, string message)
            : base(code, message)
        {
            Detail = detail;
            printf("TRACE|EXCEPTION|DerivedCompilerTestException|CTOR|code={0}|detail={1}|message={2}\n", Code, Detail, message);
        }
    }

    public partial class PartialThing
    {
        private int _value;

        partial void OnValueChanged(int value);
        public partial int Compute(int value);

        public void SetValue(int value)
        {
            _value = value;
            printf("TRACE|PARTIAL|PartialThing|SET|value={0}\n", _value);
            OnValueChanged(value);
        }
    }

    public partial class PartialThing
    {
        partial void OnValueChanged(int value)
        {
            printf("TRACE|PARTIAL|PartialThing|ON_CHANGED|value={0}\n", value);
        }

        public partial int Compute(int value)
        {
            int result = _value + value;
            printf("TRACE|PARTIAL|PartialThing|COMPUTE|value={0}|result={1}\n", value, result);
            return result;
        }
    }

    public static class ExtensionMethods
    {
        public static int Triple(this int value)
        {
            int result = value * 3;
            printf("TRACE|EXTENSION|int.Triple|value={0}|result={1}\n", value, result);
            return result;
        }

        public static string AppendToken(this string value, string token)
        {
            string result = value + token;
            printf("TRACE|EXTENSION|string.AppendToken|value={0}|token={1}|result={2}\n", value, token, result);
            return result;
        }
    }

