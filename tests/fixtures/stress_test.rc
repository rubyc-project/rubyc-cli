                else if (whileStringGuard == 2) whileString += "C";
                else if (whileStringGuard == 3) whileString = whileString.AppendToken("D");
                else whileString = "DONE";
                printf("TRACE|LOOP|WHILE_STRING|MUTATE|text={0}|guard={1}\n", whileString, whileStringGuard);
            }

            bool whileBool = true;
            int whileBoolGuard = 0;
            while (whileBool)
            {
                printf("TRACE|LOOP|WHILE_BOOL|ITER|guard={0}\n", whileBoolGuard);
                whileBoolGuard++;
                whileBool = whileBoolGuard < 3;
                printf("TRACE|LOOP|WHILE_BOOL|MUTATE|value={0}|guard={1}\n", whileBool, whileBoolGuard);
            }

            object doObject = 1;
            int doObjectGuard = 0;
            do
            {
                printf("TRACE|LOOP|DO_OBJECT|ITER|guard={0}\n", doObjectGuard);
                if (doObjectGuard == 0) doObject = "OBJECT_TEXT";
                else if (doObjectGuard == 1) doObject = new TestStruct(2, 3);
                else doObject = 999;
