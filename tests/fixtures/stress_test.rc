    public static unsafe class UnsafeTests
    {
        public static int AddPointerTarget(int left, int right)
        {
            int result = left + right;
            printf("TRACE|UNSAFE|FUNCTION_TARGET|left={0}|right={1}|result={2}\n", left, right, result);
            return result;
        }

        public static int Run(int seed)
        {
            printf("TRACE|UNSAFE|RUN|BEGIN|seed={0}\n", seed);
            int local = seed;
            int* pointer = &local;
            printf("TRACE|UNSAFE|ADDRESS_OF|value={0}\n", *pointer);
            *pointer += 5;
            printf("TRACE|UNSAFE|DEREFERENCE_WRITE|value={0}\n", local);

            int* stack = stackalloc int[6];
            for (int i = 0; i < 6; i++)
            {
                stack[i] = seed + i * 3;
                printf("TRACE|UNSAFE|STACKALLOC|index={0}|value={1}\n", i, stack[i]);
            }

            int[] managed = new int[] { 10, 20, 30, 40 };
            fixed (int* managedPointer = managed)
            {
                printf("TRACE|UNSAFE|FIXED_ARRAY|v0={0}|v1={1}|v2={2}|v3={3}\n", managedPointer[0], managedPointer[1], managedPointer[2], managedPointer[3]);
                managedPointer[2] += seed;
                printf("TRACE|UNSAFE|FIXED_ARRAY_MUTATE|v2={0}\n", managedPointer[2]);
            }

            delegate*<int, int, int> functionPointer = &AddPointerTarget;
            int functionResult = functionPointer(seed, 9);
            printf("TRACE|UNSAFE|FUNCTION_POINTER|result={0}\n", functionResult);

            int intSize = sizeof(int);
            int longSize = sizeof(long);
            int structSize = sizeof(UnmanagedPair);
            printf("TRACE|UNSAFE|SIZEOF|int={0}|long={1}|unmanagedPair={2}\n", intSize, longSize, structSize);

            FixedBufferStruct fixedBuffer = default;
            fixed (int* fixedPointer = fixedBuffer.Values)
            {
                for (int i = 0; i < 8; i++)
                {
                    fixedPointer[i] = seed + i;
                    printf("TRACE|UNSAFE|FIXED_BUFFER|index={0}|value={1}\n", i, fixedPointer[i]);
                }
            }

            printf("TRACE|UNSAFE|RUN|END|local={0}|functionResult={1}\n", local, functionResult);
            return local + functionResult + managed[2];
        }
    }

    public static class IteratorTests
    {
        public static System.Collections.Generic.IEnumerable<int> YieldValues(int start, int count)
        {
            printf("TRACE|YIELD|METHOD|BEGIN|start={0}|count={1}\n", start, count);
            for (int i = 0; i < count; i++)
            {
                int value = start + i;
                printf("TRACE|YIELD|METHOD|YIELD_RETURN|index={0}|value={1}\n", i, value);
                yield return value;
            }
            printf("TRACE|YIELD|METHOD|END\n");
        }
    }

    #endregion

    #region Runtime stress methods

    public static class TraceHelpers
    {
        public static bool Bool(int id, bool value)
        {
            printf("TRACE|COND_COMPONENT|BOOL|id={0}|value={1}\n", id, value);
            return value;
        }

        public static int Int(int id, int value)
        {
            printf("TRACE|VALUE_COMPONENT|INT|id={0}|value={1}\n", id, value);
            return value;
        }

        public static long Long(int id, long value)
        {
            printf("TRACE|VALUE_COMPONENT|LONG|id={0}|value={1}\n", id, value);
            return value;
        }

        public static string String(int id, string value)
        {
            printf("TRACE|VALUE_COMPONENT|STRING|id={0}|value={1}\n", id, value);
            return value;
        }
    }

    /// <summary>Main deterministic stress runner. FINALIZER records are tracked separately.</summary>
    public class Program
    {
#if COMPILER_MEGA_FIXTURE
        public const int PreprocessorBranchValue = 1;
#elif COMPILER_MEGA_FIXTURE_ALTERNATE
        public const int PreprocessorBranchValue = 2;
#else
        public const int PreprocessorBranchValue = 3;
#endif

        public const string ConstantA = "CONST_A";
        public const string ConstantB = "CONST_B";
        public const string ConstantInterpolated = $"{ConstantA}-{ConstantB}";
        public static readonly int StaticReadonly = 9191;
        public static int StaticMutable = 0;
        public static volatile int VolatileValue = 0;

        public static int AddOne(int value)
        {
            int result = value + 1;
            printf("TRACE|METHOD|AddOne|RETURN|value={0}|result={1}\n", value, result);
            return result;
        }

        public static int AddTwo(int left, int right)
        {
            int result = left + right;
            printf("TRACE|METHOD|AddTwo|RETURN|left={0}|right={1}|result={2}\n", left, right, result);
            return result;
        }

        public static int OptionalNamedParams(int required, int optional = 17, string label = "DEFAULT")
        {
            int result = required + optional + label.Length;
            printf("TRACE|PARAMS|OPTIONAL_NAMED|KEYS|required={0}|optional={1}|label={2}|result={3}\n", required, optional, label, result);
            return result;
        }

        public static int ParamsSum(string label, params int[] values)
        {
            int sum = 0;
            for (int i = 0; i < values.Length; i++)
            {
                sum += values[i];
                printf("TRACE|PARAMS|PARAMS_SUM|label={0}|index={1}|value={2}|sum={3}\n", label, i, values[i], sum);
            }
            return sum;
        }

        public static void RefOutIn(scoped ref int refValue, out int outValue, in int inValue)
        {
            printf("TRACE|REF|REF_OUT_IN|ENTER|ref={0}|in={1}\n", refValue, inValue);
            refValue += inValue;
            outValue = refValue * 2;
            printf("TRACE|REF|REF_OUT_IN|EXIT|ref={0}|out={1}|in={2}\n", refValue, outValue, inValue);
        }

        public static ref int RefReturn(int[] values, int index)
        {
            printf("TRACE|REF|REF_RETURN|index={0}|value={1}\n", index, values[index]);
            return ref values[index];
        }

        public static ref readonly int RefReadonlyReturn(in int value)
        {
            printf("TRACE|REF|REF_READONLY_RETURN|value={0}\n", value);
            return ref value;
        }

        public static string EnsureString(string? value)
        {
            printf("TRACE|THROW_EXPR|ENSURE_STRING|valueIsNull={0}\n", value is null);
            return value ?? throw new CompilerTestException(9001, "ENSURE_STRING_NULL");
        }

        [NameMarker(nameof(value))]
        public static int ExtendedNameofAttribute(int value)
        {
            printf("TRACE|NAMEOF|EXTENDED_ATTRIBUTE|name={0}|value={1}\n", nameof(value), value);
            return value;
        }

        public static int ThrowLevel3(int code)
        {
            printf("TRACE|EXCEPTION|THROW_LEVEL3|ENTER|code={0}\n", code);
            if ((code & 1) == 0)
            {
                printf("TRACE|EXCEPTION|THROW_LEVEL3|THROW_DERIVED|code={0}\n", code);
                throw new DerivedCompilerTestException(code, code * 10, "EVEN_CODE");
            }

            printf("TRACE|EXCEPTION|THROW_LEVEL3|THROW_BASE|code={0}\n", code);
            throw new CompilerTestException(code, "ODD_CODE");
        }

        public static int ThrowLevel2(int code)
        {
            printf("TRACE|EXCEPTION|THROW_LEVEL2|ENTER|code={0}\n", code);
            try
            {
                return ThrowLevel3(code);
            }
            finally
            {
                printf("TRACE|EXCEPTION|THROW_LEVEL2|FINALLY|code={0}\n", code);
            }
        }

        public static int ThrowLevel1(int code)
        {
            printf("TRACE|EXCEPTION|THROW_LEVEL1|ENTER|code={0}\n", code);
            try
            {
                return ThrowLevel2(code);
            }
            catch (DerivedCompilerTestException exception) when (TraceHelpers.Bool(60000 + code, exception.Detail > 0 && (exception.Code % 4 == 0)))
            {
                printf("TRACE|EXCEPTION|THROW_LEVEL1|FILTERED_DERIVED_CATCH|code={0}|detail={1}\n", exception.Code, exception.Detail);
                return exception.Code + exception.Detail;
            }
            catch (DerivedCompilerTestException exception)
            {
                printf("TRACE|EXCEPTION|THROW_LEVEL1|DERIVED_CATCH_RETHROW|code={0}|detail={1}\n", exception.Code, exception.Detail);
                throw;
            }
            catch (CompilerTestException exception)
            {
                printf("TRACE|EXCEPTION|THROW_LEVEL1|BASE_CATCH|code={0}\n", exception.Code);
                return -exception.Code;
            }
        }

        public static int PatternSwitchInt(int value)
        {
            printf("TRACE|SWITCH_PATTERN|INT|ENTER|value={0}\n", value);
            switch (value)
            {
                case 0:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_ZERO|value={0}\n", value);
                    return 0;
                case > 0 and < 10:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_1_9|value={0}\n", value);
                    return 1;
                case >= 10 and <= 100 when (value & 1) == 0:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_10_100_EVEN|value={0}\n", value);
                    return 2;
                case >= 10 and <= 100:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_10_100_ODD|value={0}\n", value);
                    return 3;
                case < 0 and not -777:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_NEGATIVE_NOT_777|value={0}\n", value);
                    return 4;
                case -777:
                    printf("TRACE|SWITCH_PATTERN|INT|CASE_NEGATIVE_777|value={0}\n", value);
                    return 5;
                default:
                    printf("TRACE|SWITCH_PATTERN|INT|DEFAULT|value={0}\n", value);
                    return 6;
            }
        }

        public static int PatternSwitchString(string? value)
        {
            printf("TRACE|SWITCH_PATTERN|STRING|ENTER|isNull={0}\n", value is null);
            switch (value)
            {
                case null:
                    printf("TRACE|SWITCH_PATTERN|STRING|NULL\n");
                    return 0;
                case "alpha":
                    printf("TRACE|SWITCH_PATTERN|STRING|ALPHA\n");
                    return 1;
                case "beta" or "gamma":
                    printf("TRACE|SWITCH_PATTERN|STRING|BETA_GAMMA|value={0}\n", value);
                    return 2;
                case { Length: > 10 } longText when longText[0] == 'L':
                    printf("TRACE|SWITCH_PATTERN|STRING|LONG_L|value={0}|length={1}\n", longText, longText.Length);
                    return 3;
                case { Length: >= 3 and <= 10 } mediumText:
                    printf("TRACE|SWITCH_PATTERN|STRING|MEDIUM|value={0}|length={1}\n", mediumText, mediumText.Length);
                    return 4;
                default:
                    printf("TRACE|SWITCH_PATTERN|STRING|DEFAULT|value={0}\n", value);
                    return 5;
            }
        }

        public static int PatternSwitchObject(object? value)
        {
            printf("TRACE|SWITCH_PATTERN|OBJECT|ENTER|isNull={0}\n", value is null);
            switch (value)
            {
                case null:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|NULL\n");
                    return 0;
                case int number when number is > 100 and < 1000:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|INT_100_1000|value={0}\n", number);
                    return 1;
                case string { Length: >= 3 and <= 8 } text:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|STRING|value={0}\n", text);
                    return 2;
                case TestStruct(var x, var y) when x != y:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|TEST_STRUCT|x={0}|y={1}\n", x, y);
                    return 3;
                case TestRecord(var id, var name) when id > 0:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|TEST_RECORD|id={0}|name={1}\n", id, name);
                    return 4;
                case DerivedTestClass { PublicValue: > 0, DerivedValue: > 0 } derived:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|DERIVED_CLASS|public={0}|derived={1}\n", derived.PublicValue, derived.DerivedValue);
                    return 5;
                case TestClass { Name.Length: > 2, PublicValue: >= 0 } testClass:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|TEST_CLASS_EXTENDED_PROPERTY|public={0}|name={1}\n", testClass.PublicValue, testClass.Name);
                    return 6;
                case var anything:
                    printf("TRACE|SWITCH_PATTERN|OBJECT|VAR_PATTERN|notNull={0}\n", anything is not null);
                    return 7;
            }
        }

        public static int PatternSwitchArray(int[] values)
        {
            printf("TRACE|SWITCH_PATTERN|ARRAY|ENTER|length={0}\n", values.Length);
            return values switch
            {
                [] => TraceHelpers.Int(61001, 0),
                [1] => TraceHelpers.Int(61002, 1),
                [1, 2] => TraceHelpers.Int(61003, 2),
                [1, 2, 3] => TraceHelpers.Int(61004, 3),
                [> 0, > 0, > 0] => TraceHelpers.Int(61005, 4),
                [1, .., 9] => TraceHelpers.Int(61006, 5),
                [var first, .. var middle, var last] when first < last && middle.Length >= 1 => TraceHelpers.Int(61007, 6),
                _ => TraceHelpers.Int(61008, 7)
            };
        }

        public static int PatternSwitchNumericTypes(long longValue, uint uintValue, ulong ulongValue, float floatValue, double doubleValue, decimal decimalValue, char charValue, bool boolValue, TestEnum enumValue)
        {
            int result = 0;

            result += longValue switch
            {
                < 0L => 1,
                0L => 2,
                > 0L and < 1000L => 3,
                _ => 4
            };
            printf("TRACE|SWITCH_EXPR|LONG|value={0}|result={1}\n", longValue, result);

            result += uintValue switch
            {
                0U => 10,
                < 10U => 11,
                >= 10U and <= 100U => 12,
                _ => 13
            };
            printf("TRACE|SWITCH_EXPR|UINT|value={0}|result={1}\n", uintValue, result);

            result += ulongValue switch
            {
                0UL => 20,
                < 10UL => 21,
                >= 10UL and <= 100UL => 22,
                _ => 23
            };
            printf("TRACE|SWITCH_EXPR|ULONG|value={0}|result={1}\n", ulongValue, result);

            result += floatValue switch
            {
                < 0.0f => 30,
                0.0f => 31,
                > 0.0f and < 10.0f => 32,
                _ => 33
            };
            printf("TRACE|SWITCH_EXPR|FLOAT|value={0}|result={1}\n", floatValue, result);

            result += doubleValue switch
            {
                < 0.0 => 40,
                0.0 => 41,
                > 0.0 and < 10.0 => 42,
                _ => 43
            };
            printf("TRACE|SWITCH_EXPR|DOUBLE|value={0}|result={1}\n", doubleValue, result);

            result += decimalValue switch
            {
                < 0.0m => 50,
                0.0m => 51,
                > 0.0m and < 10.0m => 52,
                _ => 53
            };
            printf("TRACE|SWITCH_EXPR|DECIMAL|value={0}|result={1}\n", decimalValue, result);

            result += charValue switch
            {
                'A' => 60,
                >= 'B' and <= 'M' => 61,
                >= 'N' and <= 'Z' => 62,
                _ => 63
            };
            printf("TRACE|SWITCH_EXPR|CHAR|value={0}|result={1}\n", charValue, result);

            result += boolValue switch
            {
                true => 70,
                false => 71
            };
            printf("TRACE|SWITCH_EXPR|BOOL|value={0}|result={1}\n", boolValue, result);

            result += enumValue switch
            {
                TestEnum.Zero => 80,
                TestEnum.One or TestEnum.Two => 81,
                TestEnum.Three => 82,
                _ => 83
            };
            printf("TRACE|SWITCH_EXPR|ENUM|value={0}|result={1}\n", (int)enumValue, result);

            return result;
        }

        public static int RunExceptionTorture(int seed)
        {
            int accumulator = seed;
            printf("TRACE|EXCEPTION|TORTURE|BEGIN|seed={0}\n", seed);

            for (int outer = 0; outer < 6; outer++)
            {
                printf("TRACE|EXCEPTION|TORTURE|OUTER_FOR|outer={0}|acc={1}\n", outer, accumulator);
                try
                {
                    int middle = 0;
                    while (middle < 4)
                    {
                        printf("TRACE|EXCEPTION|TORTURE|MIDDLE_WHILE|outer={0}|middle={1}|acc={2}\n", outer, middle, accumulator);
                        int inner = 0;
                        do
                        {
                            printf("TRACE|EXCEPTION|TORTURE|INNER_DO|outer={0}|middle={1}|inner={2}|acc={3}\n", outer, middle, inner, accumulator);
                            try
                            {
                                bool throwCondition =
                                    TraceHelpers.Bool(62000 + outer * 100 + middle * 10 + inner,
                                        (((outer + middle + inner) % 5) == 3 && ((accumulator & 3) != 2)) ||
                                        (outer == 5 && middle == 3 && inner == 2));

                                printf("TRACE|EXCEPTION|TORTURE|THROW_CONDITION|outer={0}|middle={1}|inner={2}|result={3}\n", outer, middle, inner, throwCondition);

                                if (throwCondition)
                                {
                                    accumulator += 17;
                                    printf("TRACE|EXCEPTION|TORTURE|BEFORE_THROW|outer={0}|middle={1}|inner={2}|acc={3}\n", outer, middle, inner, accumulator);
                                    if (((outer + inner) & 1) == 0)
                                    {
                                        printf("TRACE|EXCEPTION|TORTURE|THROW_DERIVED|code={0}\n", 7000 + outer * 100 + middle * 10 + inner);
                                        throw new DerivedCompilerTestException(7000 + outer * 100 + middle * 10 + inner, inner + 1, "NESTED_DERIVED");
                                    }
                                    else
                                    {
                                        printf("TRACE|EXCEPTION|TORTURE|THROW_BASE|code={0}\n", 8000 + outer * 100 + middle * 10 + inner);
                                        throw new CompilerTestException(8000 + outer * 100 + middle * 10 + inner, "NESTED_BASE");
                                    }
                                }

                                accumulator += outer + middle + inner;
                                printf("TRACE|EXCEPTION|TORTURE|NORMAL_INNER|acc={0}\n", accumulator);
                            }
                            catch (DerivedCompilerTestException exception) when (TraceHelpers.Bool(63000 + inner, exception.Detail == 1 || exception.Detail == 3))
                            {
                                printf("TRACE|EXCEPTION|TORTURE|FILTERED_DERIVED_CATCH|code={0}|detail={1}\n", exception.Code, exception.Detail);
                                accumulator += exception.Detail * 100;
                                printf("TRACE|EXCEPTION|TORTURE|FILTERED_DERIVED_MUTATE|acc={0}\n", accumulator);
                            }
                            catch (DerivedCompilerTestException exception)
                            {
                                printf("TRACE|EXCEPTION|TORTURE|DERIVED_CATCH|code={0}|detail={1}\n", exception.Code, exception.Detail);
                                accumulator += 200;
                                if ((exception.Code & 1) == 0)
                                {
                                    printf("TRACE|EXCEPTION|TORTURE|DERIVED_RETHROW|code={0}\n", exception.Code);
                                    throw;
                                }
                            }
                            catch (CompilerTestException exception)
                            {
                                printf("TRACE|EXCEPTION|TORTURE|BASE_CATCH|code={0}\n", exception.Code);
                                accumulator -= 50;
                            }
                            finally
                            {
                                accumulator ^= outer + middle + inner;
                                printf("TRACE|EXCEPTION|TORTURE|INNER_FINALLY|outer={0}|middle={1}|inner={2}|acc={3}\n", outer, middle, inner, accumulator);
                            }

                            inner++;
                            printf("TRACE|EXCEPTION|TORTURE|INNER_INCREMENT|inner={0}\n", inner);
                        }
                        while (inner < 3);

                        middle++;
                        printf("TRACE|EXCEPTION|TORTURE|MIDDLE_INCREMENT|middle={0}\n", middle);
                    }
                }
                catch (DerivedCompilerTestException exception)
                {
                    printf("TRACE|EXCEPTION|TORTURE|OUTER_DERIVED_CATCH|code={0}|detail={1}\n", exception.Code, exception.Detail);
                    accumulator += 1000;
                }
                finally
                {
                    accumulator += outer;
                    printf("TRACE|EXCEPTION|TORTURE|OUTER_FINALLY|outer={0}|acc={1}\n", outer, accumulator);
                }
            }

            printf("TRACE|EXCEPTION|TORTURE|END|acc={0}\n", accumulator);
            return accumulator;
        }

        public static int RunMegaNest(int seed)
        {
            int accumulator = seed;
            printf("TRACE|MEGA_NEST|ROOT|BEGIN|seed={0}\n", seed);

            for (int level1For = 0; level1For < 3; level1For++)
            {
                printf("TRACE|MEGA_NEST|L1_FOR|ITER|i={0}|acc={1}\n", level1For, accumulator);
                long level2While = 0L;
                while (level2While < 3L)
                {
                    printf("TRACE|MEGA_NEST|L2_WHILE|ITER|i={0}|j={1}|acc={2}\n", level1For, level2While, accumulator);
                    double level3Do = 0.0;
                    do
                    {
                        printf("TRACE|MEGA_NEST|L3_DO|ITER|i={0}|j={1}|k={2}|acc={3}\n", level1For, level2While, level3Do, accumulator);
                        bool level4Condition =
                            TraceHelpers.Bool(64000 + level1For * 100 + (int)level2While * 10 + (int)level3Do,
                                (((level1For + level2While) % 2L == 0L) &&
                                 ((level3Do >= 0.0 && level3Do < 3.0) || accumulator > 100)) &&
                                ((((accumulator << 2) ^ (accumulator >>> 1)) & 7) != 6 || level1For == 2));

                        printf("TRACE|MEGA_NEST|L4_IF|COND|result={0}|i={1}|j={2}|k={3}|acc={4}\n", level4Condition, level1For, level2While, level3Do, accumulator);
                        if (level4Condition)
                        {
                            printf("TRACE|MEGA_NEST|L4_IF|TRUE\n");
                            for (decimal level5For = 0.0m; level5For < 2.0m; level5For += 1.0m)
                            {
                                printf("TRACE|MEGA_NEST|L5_FOR_DECIMAL|ITER|v={0}|acc={1}\n", level5For, accumulator);
                                string level6While = "A";
                                int level6Guard = 0;
                                while (level6While != "DONE" && level6Guard < 4)
                                {
                                    printf("TRACE|MEGA_NEST|L6_WHILE_STRING|ITER|text={0}|guard={1}|acc={2}\n", level6While, level6Guard, accumulator);
                                    char level7Do = 'a';
                                    do
                                    {
                                        printf("TRACE|MEGA_NEST|L7_DO_CHAR|ITER|char={0}|acc={1}\n", level7Do, accumulator);
                                        bool level8Condition =
                                            TraceHelpers.Bool(65000 + level7Do,
                                                ((level7Do is >= 'a' and <= 'd') &&
                                                 ((level6Guard & 1) == 0 || level5For == 1.0m)) &&
                                                ((accumulator % 5 != 4) || level1For == 1));

                                        printf("TRACE|MEGA_NEST|L8_IF|COND|result={0}|char={1}\n", level8Condition, level7Do);
                                        if (level8Condition)
                                        {
                                            printf("TRACE|MEGA_NEST|L8_IF|TRUE\n");
                                            for (uint level9For = 0U; level9For < 2U; level9For++)
                                            {
                                                printf("TRACE|MEGA_NEST|L9_FOR_UINT|ITER|v={0}|acc={1}\n", level9For, accumulator);
                                                ulong level10While = 0UL;
                                                while (level10While < 2UL)
                                                {
                                                    printf("TRACE|MEGA_NEST|L10_WHILE_ULONG|ITER|v={0}|acc={1}\n", level10While, accumulator);
                                                    float level11Do = 0.0f;
                                                    do
                                                    {
                                                        printf("TRACE|MEGA_NEST|L11_DO_FLOAT|ITER|v={0}|acc={1}\n", level11Do, accumulator);
                                                        int selector = (level1For + (int)level2While + (int)level3Do + (int)level5For + level6Guard + level7Do + (int)level9For + (int)level10While + (int)level11Do + accumulator) & 7;
                                                        printf("TRACE|MEGA_NEST|L12_SWITCH|SELECTOR|value={0}\n", selector);
                                                        switch (selector)
                                                        {
                                                            case 0:
                                                                printf("TRACE|MEGA_NEST|L12_SWITCH|CASE_0\n");
                                                                accumulator += 3;
                                                                break;
                                                            case 1 or 2:
                                                                printf("TRACE|MEGA_NEST|L12_SWITCH|CASE_1_OR_2|selector={0}\n", selector);
                                                                accumulator ^= selector * 11;
                                                                break;
                                                            case >= 3 and <= 5 when ((accumulator & 1) == 0):
                                                                printf("TRACE|MEGA_NEST|L12_SWITCH|CASE_3_5_EVEN|selector={0}\n", selector);
                                                                accumulator += selector * 7;
                                                                break;
                                                            case >= 3 and <= 5:
                                                                printf("TRACE|MEGA_NEST|L12_SWITCH|CASE_3_5_ODD|selector={0}\n", selector);
                                                                accumulator -= selector * 5;
                                                                break;
                                                            default:
                                                                printf("TRACE|MEGA_NEST|L12_SWITCH|DEFAULT|selector={0}\n", selector);
                                                                accumulator += 1;
                                                                break;
                                                        }

                                                        level11Do += 1.0f;
                                                        printf("TRACE|MEGA_NEST|L11_DO_FLOAT|MUTATE|v={0}\n", level11Do);
                                                    }
                                                    while (level11Do < 2.0f);

                                                    level10While++;
                                                    printf("TRACE|MEGA_NEST|L10_WHILE_ULONG|MUTATE|v={0}\n", level10While);
                                                }
                                            }
                                        }
                                        else
                                        {
                                            printf("TRACE|MEGA_NEST|L8_IF|FALSE\n");
                                            accumulator -= 13;
                                        }

                                        level7Do++;
                                        printf("TRACE|MEGA_NEST|L7_DO_CHAR|MUTATE|char={0}\n", level7Do);
                                    }
                                    while (level7Do <= 'd');

                                    level6Guard++;
                                    if (level6Guard == 1)
                                    {
                                        level6While = "B";
                                    }
                                    else if (level6Guard == 2)
                                    {
                                        level6While = "C";
                                    }
                                    else if (level6Guard >= 3)
                                    {
                                        level6While = "DONE";
                                    }
                                    printf("TRACE|MEGA_NEST|L6_WHILE_STRING|MUTATE|text={0}|guard={1}\n", level6While, level6Guard);
                                }
                            }
                        }
                        else
                        {
                            printf("TRACE|MEGA_NEST|L4_IF|FALSE\n");
                            accumulator -= 17;
                        }

                        level3Do += 1.0;
                        printf("TRACE|MEGA_NEST|L3_DO|MUTATE|k={0}\n", level3Do);
                    }
                    while (level3Do < 3.0);

                    level2While++;
                    printf("TRACE|MEGA_NEST|L2_WHILE|MUTATE|j={0}\n", level2While);
                }
            }

            printf("TRACE|MEGA_NEST|ROOT|END|acc={0}\n", accumulator);
            return accumulator;
        }

        public static void InterpolatedHandlerTarget(
            int contextId,
            [System.Runtime.CompilerServices.InterpolatedStringHandlerArgument("contextId")] TraceInterpolatedStringHandler handler)
        {
            printf("TRACE|INTERPOLATED_HANDLER|TARGET|context={0}|score={1}\n", contextId, handler.Score);
        }

        public static void CallerInfoTarget(
            int value,
            [System.Runtime.CompilerServices.CallerMemberName] string member = "",
            [System.Runtime.CompilerServices.CallerLineNumber] int line = 0)
        {
            printf("TRACE|CALLER_INFO|TARGET|value={0}|member={1}|linePositive={2}\n", value, member, line > 0);
        }

        public static void CallerArgumentTarget(
            int value,
            [System.Runtime.CompilerServices.CallerArgumentExpression("value")] string? expression = null)
        {
            printf("TRACE|CALLER_ARGUMENT|TARGET|value={0}|expression={1}\n", value, expression ?? "NULL");
        }

        public static string NextLoopString(string value)
        {
            string result = value switch
            {
                "A" => "B",
                "B" => "C",
                "C" => "DONE",
                _ => "DONE"
            };
            printf("TRACE|LOOP_HELPER|NEXT_STRING|input={0}|output={1}\n", value, result);
            return result;
        }

        public static int RunAllTypeLoopMatrix()
        {
            int accumulator = 0;
            printf("TRACE|LOOP_MATRIX|ALL_TYPES|BEGIN\n");

            for (byte v = 0; v < 3; v++) { printf("TRACE|LOOP_MATRIX|FOR_BYTE|ITER|v={0}\n", v); accumulator += v; }
            byte wb = 0; while (wb < 3) { printf("TRACE|LOOP_MATRIX|WHILE_BYTE|ITER|v={0}\n", wb); accumulator += wb; wb++; printf("TRACE|LOOP_MATRIX|WHILE_BYTE|MUTATE|v={0}\n", wb); }
            byte db = 0; do { printf("TRACE|LOOP_MATRIX|DO_BYTE|ITER|v={0}\n", db); accumulator += db; db++; printf("TRACE|LOOP_MATRIX|DO_BYTE|MUTATE|v={0}\n", db); } while (db < 3);

            for (sbyte v = -1; v < 2; v++) { printf("TRACE|LOOP_MATRIX|FOR_SBYTE|ITER|v={0}\n", v); accumulator += v; }
            sbyte wsb = -1; while (wsb < 2) { printf("TRACE|LOOP_MATRIX|WHILE_SBYTE|ITER|v={0}\n", wsb); accumulator += wsb; wsb++; printf("TRACE|LOOP_MATRIX|WHILE_SBYTE|MUTATE|v={0}\n", wsb); }
            sbyte dsb = -1; do { printf("TRACE|LOOP_MATRIX|DO_SBYTE|ITER|v={0}\n", dsb); accumulator += dsb; dsb++; printf("TRACE|LOOP_MATRIX|DO_SBYTE|MUTATE|v={0}\n", dsb); } while (dsb < 2);

            for (short v = -1; v < 2; v++) { printf("TRACE|LOOP_MATRIX|FOR_SHORT|ITER|v={0}\n", v); accumulator += v; }
            short ws = -1; while (ws < 2) { printf("TRACE|LOOP_MATRIX|WHILE_SHORT|ITER|v={0}\n", ws); accumulator += ws; ws++; printf("TRACE|LOOP_MATRIX|WHILE_SHORT|MUTATE|v={0}\n", ws); }
            short ds = -1; do { printf("TRACE|LOOP_MATRIX|DO_SHORT|ITER|v={0}\n", ds); accumulator += ds; ds++; printf("TRACE|LOOP_MATRIX|DO_SHORT|MUTATE|v={0}\n", ds); } while (ds < 2);

            for (ushort v = 0; v < 3; v++) { printf("TRACE|LOOP_MATRIX|FOR_USHORT|ITER|v={0}\n", v); accumulator += v; }
            ushort wus = 0; while (wus < 3) { printf("TRACE|LOOP_MATRIX|WHILE_USHORT|ITER|v={0}\n", wus); accumulator += wus; wus++; printf("TRACE|LOOP_MATRIX|WHILE_USHORT|MUTATE|v={0}\n", wus); }
            ushort dus = 0; do { printf("TRACE|LOOP_MATRIX|DO_USHORT|ITER|v={0}\n", dus); accumulator += dus; dus++; printf("TRACE|LOOP_MATRIX|DO_USHORT|MUTATE|v={0}\n", dus); } while (dus < 3);

            for (int v = -1; v < 2; v++) { printf("TRACE|LOOP_MATRIX|FOR_INT|ITER|v={0}\n", v); accumulator += v; }
            int wi = -1; while (wi < 2) { printf("TRACE|LOOP_MATRIX|WHILE_INT|ITER|v={0}\n", wi); accumulator += wi; wi++; printf("TRACE|LOOP_MATRIX|WHILE_INT|MUTATE|v={0}\n", wi); }
            int di = -1; do { printf("TRACE|LOOP_MATRIX|DO_INT|ITER|v={0}\n", di); accumulator += di; di++; printf("TRACE|LOOP_MATRIX|DO_INT|MUTATE|v={0}\n", di); } while (di < 2);

            for (uint v = 0U; v < 3U; v++) { printf("TRACE|LOOP_MATRIX|FOR_UINT|ITER|v={0}\n", v); accumulator += (int)v; }
            uint wui = 0U; while (wui < 3U) { printf("TRACE|LOOP_MATRIX|WHILE_UINT|ITER|v={0}\n", wui); accumulator += (int)wui; wui++; printf("TRACE|LOOP_MATRIX|WHILE_UINT|MUTATE|v={0}\n", wui); }
            uint dui = 0U; do { printf("TRACE|LOOP_MATRIX|DO_UINT|ITER|v={0}\n", dui); accumulator += (int)dui; dui++; printf("TRACE|LOOP_MATRIX|DO_UINT|MUTATE|v={0}\n", dui); } while (dui < 3U);

            for (long v = -1L; v < 2L; v++) { printf("TRACE|LOOP_MATRIX|FOR_LONG|ITER|v={0}\n", v); accumulator += (int)v; }
            long wl = -1L; while (wl < 2L) { printf("TRACE|LOOP_MATRIX|WHILE_LONG|ITER|v={0}\n", wl); accumulator += (int)wl; wl++; printf("TRACE|LOOP_MATRIX|WHILE_LONG|MUTATE|v={0}\n", wl); }
            long dl = -1L; do { printf("TRACE|LOOP_MATRIX|DO_LONG|ITER|v={0}\n", dl); accumulator += (int)dl; dl++; printf("TRACE|LOOP_MATRIX|DO_LONG|MUTATE|v={0}\n", dl); } while (dl < 2L);

            for (ulong v = 0UL; v < 3UL; v++) { printf("TRACE|LOOP_MATRIX|FOR_ULONG|ITER|v={0}\n", v); accumulator += (int)v; }
            ulong wul = 0UL; while (wul < 3UL) { printf("TRACE|LOOP_MATRIX|WHILE_ULONG|ITER|v={0}\n", wul); accumulator += (int)wul; wul++; printf("TRACE|LOOP_MATRIX|WHILE_ULONG|MUTATE|v={0}\n", wul); }
            ulong dul = 0UL; do { printf("TRACE|LOOP_MATRIX|DO_ULONG|ITER|v={0}\n", dul); accumulator += (int)dul; dul++; printf("TRACE|LOOP_MATRIX|DO_ULONG|MUTATE|v={0}\n", dul); } while (dul < 3UL);

            for (nint v = (nint)0; v < (nint)3; v++) { printf("TRACE|LOOP_MATRIX|FOR_NINT|ITER|v={0}\n", v); accumulator += (int)v; }
            nint wni = (nint)0; while (wni < (nint)3) { printf("TRACE|LOOP_MATRIX|WHILE_NINT|ITER|v={0}\n", wni); accumulator += (int)wni; wni++; printf("TRACE|LOOP_MATRIX|WHILE_NINT|MUTATE|v={0}\n", wni); }
            nint dni = (nint)0; do { printf("TRACE|LOOP_MATRIX|DO_NINT|ITER|v={0}\n", dni); accumulator += (int)dni; dni++; printf("TRACE|LOOP_MATRIX|DO_NINT|MUTATE|v={0}\n", dni); } while (dni < (nint)3);

            for (nuint v = (nuint)0; v < (nuint)3; v++) { printf("TRACE|LOOP_MATRIX|FOR_NUINT|ITER|v={0}\n", v); accumulator += (int)v; }
            nuint wnui = (nuint)0; while (wnui < (nuint)3) { printf("TRACE|LOOP_MATRIX|WHILE_NUINT|ITER|v={0}\n", wnui); accumulator += (int)wnui; wnui++; printf("TRACE|LOOP_MATRIX|WHILE_NUINT|MUTATE|v={0}\n", wnui); }
            nuint dnui = (nuint)0; do { printf("TRACE|LOOP_MATRIX|DO_NUINT|ITER|v={0}\n", dnui); accumulator += (int)dnui; dnui++; printf("TRACE|LOOP_MATRIX|DO_NUINT|MUTATE|v={0}\n", dnui); } while (dnui < (nuint)3);

            for (char v = 'a'; v <= 'c'; v++) { printf("TRACE|LOOP_MATRIX|FOR_CHAR|ITER|v={0}\n", v); accumulator += v; }
            char wc = 'a'; while (wc <= 'c') { printf("TRACE|LOOP_MATRIX|WHILE_CHAR|ITER|v={0}\n", wc); accumulator += wc; wc++; printf("TRACE|LOOP_MATRIX|WHILE_CHAR|MUTATE|v={0}\n", wc); }
            char dc = 'a'; do { printf("TRACE|LOOP_MATRIX|DO_CHAR|ITER|v={0}\n", dc); accumulator += dc; dc++; printf("TRACE|LOOP_MATRIX|DO_CHAR|MUTATE|v={0}\n", dc); } while (dc <= 'c');

            for (float v = 0.0f; v < 1.5f; v += 0.5f) { printf("TRACE|LOOP_MATRIX|FOR_FLOAT|ITER|v={0}\n", v); accumulator += (int)(v * 10); }
            float wf = 0.0f; while (wf < 1.5f) { printf("TRACE|LOOP_MATRIX|WHILE_FLOAT|ITER|v={0}\n", wf); accumulator += (int)(wf * 10); wf += 0.5f; printf("TRACE|LOOP_MATRIX|WHILE_FLOAT|MUTATE|v={0}\n", wf); }
            float df = 0.0f; do { printf("TRACE|LOOP_MATRIX|DO_FLOAT|ITER|v={0}\n", df); accumulator += (int)(df * 10); df += 0.5f; printf("TRACE|LOOP_MATRIX|DO_FLOAT|MUTATE|v={0}\n", df); } while (df < 1.5f);

            for (double v = 0.0; v < 1.5; v += 0.5) { printf("TRACE|LOOP_MATRIX|FOR_DOUBLE|ITER|v={0}\n", v); accumulator += (int)(v * 10); }
            double wd = 0.0; while (wd < 1.5) { printf("TRACE|LOOP_MATRIX|WHILE_DOUBLE|ITER|v={0}\n", wd); accumulator += (int)(wd * 10); wd += 0.5; printf("TRACE|LOOP_MATRIX|WHILE_DOUBLE|MUTATE|v={0}\n", wd); }
            double dd = 0.0; do { printf("TRACE|LOOP_MATRIX|DO_DOUBLE|ITER|v={0}\n", dd); accumulator += (int)(dd * 10); dd += 0.5; printf("TRACE|LOOP_MATRIX|DO_DOUBLE|MUTATE|v={0}\n", dd); } while (dd < 1.5);

            for (decimal v = 0.0m; v < 1.5m; v += 0.5m) { printf("TRACE|LOOP_MATRIX|FOR_DECIMAL|ITER|v={0}\n", v); accumulator += (int)(v * 10m); }
            decimal wdec = 0.0m; while (wdec < 1.5m) { printf("TRACE|LOOP_MATRIX|WHILE_DECIMAL|ITER|v={0}\n", wdec); accumulator += (int)(wdec * 10m); wdec += 0.5m; printf("TRACE|LOOP_MATRIX|WHILE_DECIMAL|MUTATE|v={0}\n", wdec); }
            decimal ddec = 0.0m; do { printf("TRACE|LOOP_MATRIX|DO_DECIMAL|ITER|v={0}\n", ddec); accumulator += (int)(ddec * 10m); ddec += 0.5m; printf("TRACE|LOOP_MATRIX|DO_DECIMAL|MUTATE|v={0}\n", ddec); } while (ddec < 1.5m);

            for (bool v = true; v; v = false) { printf("TRACE|LOOP_MATRIX|FOR_BOOL|ITER|v={0}\n", v); accumulator += 1; }
            bool wbool = true; int wboolGuard = 0; while (wbool) { printf("TRACE|LOOP_MATRIX|WHILE_BOOL|ITER|v={0}|guard={1}\n", wbool, wboolGuard); accumulator++; wboolGuard++; wbool = wboolGuard < 2; printf("TRACE|LOOP_MATRIX|WHILE_BOOL|MUTATE|v={0}|guard={1}\n", wbool, wboolGuard); }
            bool dbool = true; int dboolGuard = 0; do { printf("TRACE|LOOP_MATRIX|DO_BOOL|ITER|v={0}|guard={1}\n", dbool, dboolGuard); accumulator++; dboolGuard++; dbool = dboolGuard < 2; printf("TRACE|LOOP_MATRIX|DO_BOOL|MUTATE|v={0}|guard={1}\n", dbool, dboolGuard); } while (dbool);

            for (string v = "A"; v != "DONE"; v = NextLoopString(v)) { printf("TRACE|LOOP_MATRIX|FOR_STRING|ITER|v={0}\n", v); accumulator += v.Length; }
            string wstr = "A"; while (wstr != "DONE") { printf("TRACE|LOOP_MATRIX|WHILE_STRING|ITER|v={0}\n", wstr); accumulator += wstr.Length; wstr = NextLoopString(wstr); printf("TRACE|LOOP_MATRIX|WHILE_STRING|MUTATE|v={0}\n", wstr); }
            string dstr = "A"; do { printf("TRACE|LOOP_MATRIX|DO_STRING|ITER|v={0}\n", dstr); accumulator += dstr.Length; dstr = NextLoopString(dstr); printf("TRACE|LOOP_MATRIX|DO_STRING|MUTATE|v={0}\n", dstr); } while (dstr != "DONE");

            for (TestEnum v = TestEnum.Zero; v != TestEnum.Three; v = (TestEnum)((int)v + 1)) { printf("TRACE|LOOP_MATRIX|FOR_ENUM|ITER|v={0}\n", (int)v); accumulator += (int)v; }
            TestEnum wenum = TestEnum.Zero; while (wenum != TestEnum.Three) { printf("TRACE|LOOP_MATRIX|WHILE_ENUM|ITER|v={0}\n", (int)wenum); accumulator += (int)wenum; wenum = (TestEnum)((int)wenum + 1); printf("TRACE|LOOP_MATRIX|WHILE_ENUM|MUTATE|v={0}\n", (int)wenum); }
            TestEnum denum = TestEnum.Zero; do { printf("TRACE|LOOP_MATRIX|DO_ENUM|ITER|v={0}\n", (int)denum); accumulator += (int)denum; denum = (TestEnum)((int)denum + 1); printf("TRACE|LOOP_MATRIX|DO_ENUM|MUTATE|v={0}\n", (int)denum); } while (denum != TestEnum.Three);

            object objectLoop = 0; int objectGuard = 0;
            for (; objectLoop is not string && objectGuard < 2; objectLoop = objectGuard == 0 ? (object)1 : "DONE") { printf("TRACE|LOOP_MATRIX|FOR_OBJECT|ITER|guard={0}|isString={1}\n", objectGuard, objectLoop is string); accumulator++; objectGuard++; }
            objectLoop = 0; objectGuard = 0; while (objectLoop is not string && objectGuard < 2) { printf("TRACE|LOOP_MATRIX|WHILE_OBJECT|ITER|guard={0}\n", objectGuard); objectGuard++; objectLoop = objectGuard < 2 ? (object)1 : "DONE"; }
            objectLoop = 0; objectGuard = 0; do { printf("TRACE|LOOP_MATRIX|DO_OBJECT|ITER|guard={0}\n", objectGuard); objectGuard++; objectLoop = objectGuard < 2 ? (object)1 : "DONE"; } while (objectLoop is not string && objectGuard < 2);

            dynamic dynamicFor = 0; for (; dynamicFor < 3; dynamicFor++) { printf("TRACE|LOOP_MATRIX|FOR_DYNAMIC|ITER|v={0}\n", dynamicFor); accumulator += (int)dynamicFor; }
            dynamic dynamicWhile = 0; while (dynamicWhile < 3) { printf("TRACE|LOOP_MATRIX|WHILE_DYNAMIC|ITER|v={0}\n", dynamicWhile); accumulator += (int)dynamicWhile; dynamicWhile++; }
            dynamic dynamicDo = 0; do { printf("TRACE|LOOP_MATRIX|DO_DYNAMIC|ITER|v={0}\n", dynamicDo); accumulator += (int)dynamicDo; dynamicDo++; } while (dynamicDo < 3);

            printf("TRACE|LOOP_MATRIX|ALL_TYPES|END|acc={0}\n", accumulator);
            return accumulator;
        }

        public static int RunAllTypeSwitchMatrix()
        {
            int result = 0;
            printf("TRACE|SWITCH_MATRIX|ALL_TYPES|BEGIN\n");

            byte b = 2; switch (b) { case 0: result += 1; printf("TRACE|SWITCH_MATRIX|BYTE|ZERO\n"); break; case > 0 and < 5: result += 2; printf("TRACE|SWITCH_MATRIX|BYTE|RANGE|v={0}\n", b); break; default: result += 3; printf("TRACE|SWITCH_MATRIX|BYTE|DEFAULT\n"); break; }
            sbyte sb = -2; switch (sb) { case < 0: result += 4; printf("TRACE|SWITCH_MATRIX|SBYTE|NEG|v={0}\n", sb); break; default: result += 5; break; }
            short sh = 12; switch (sh) { case >= 10 and <= 20: result += 6; printf("TRACE|SWITCH_MATRIX|SHORT|RANGE|v={0}\n", sh); break; default: result += 7; break; }
            ushort ush = 12; result += ush switch { 0 => 8, > 0 and < 20 => 9, _ => 10 }; printf("TRACE|SWITCH_MATRIX|USHORT|v={0}|result={1}\n", ush, result);
            int i = 33; result += i switch { < 0 => 11, >= 0 and <= 100 => 12, _ => 13 }; printf("TRACE|SWITCH_MATRIX|INT|v={0}|result={1}\n", i, result);
            uint ui = 44U; result += ui switch { 0U => 14, < 100U => 15, _ => 16 }; printf("TRACE|SWITCH_MATRIX|UINT|v={0}|result={1}\n", ui, result);
            long l = -55L; result += l switch { < 0L => 17, 0L => 18, _ => 19 }; printf("TRACE|SWITCH_MATRIX|LONG|v={0}|result={1}\n", l, result);
            ulong ul = 66UL; result += ul switch { < 100UL => 20, _ => 21 }; printf("TRACE|SWITCH_MATRIX|ULONG|v={0}|result={1}\n", ul, result);
            nint ni = (nint)7; switch (ni) { case 7: result += 22; printf("TRACE|SWITCH_MATRIX|NINT|SEVEN\n"); break; default: result += 23; break; }
            nuint nui = (nuint)8; switch (nui) { case 8: result += 24; printf("TRACE|SWITCH_MATRIX|NUINT|EIGHT\n"); break; default: result += 25; break; }
            char c = 'M'; result += c switch { >= 'A' and <= 'Z' => 26, _ => 27 }; printf("TRACE|SWITCH_MATRIX|CHAR|v={0}|result={1}\n", c, result);
            float f = 2.5f; result += f switch { < 0f => 28, > 0f and < 3f => 29, _ => 30 }; printf("TRACE|SWITCH_MATRIX|FLOAT|v={0}|result={1}\n", f, result);
            double d = 3.5; result += d switch { < 0.0 => 31, > 0.0 and < 4.0 => 32, _ => 33 }; printf("TRACE|SWITCH_MATRIX|DOUBLE|v={0}|result={1}\n", d, result);
            decimal dec = 4.5m; result += dec switch { < 0m => 34, > 0m and < 5m => 35, _ => 36 }; printf("TRACE|SWITCH_MATRIX|DECIMAL|v={0}|result={1}\n", dec, result);
            bool bo = true; result += bo switch { true => 37, false => 38 }; printf("TRACE|SWITCH_MATRIX|BOOL|v={0}|result={1}\n", bo, result);
            string str = "alpha"; switch (str) { case "alpha": result += 39; printf("TRACE|SWITCH_MATRIX|STRING|ALPHA\n"); break; case { Length: > 3 }: result += 40; break; default: result += 41; break; }
            TestEnum en = TestEnum.Two; result += en switch { TestEnum.Zero => 42, TestEnum.One or TestEnum.Two => 43, _ => 44 }; printf("TRACE|SWITCH_MATRIX|ENUM|v={0}|result={1}\n", (int)en, result);
            int? nullable = 9; result += nullable switch { null => 45, 9 => 46, > 0 => 47, _ => 48 }; printf("TRACE|SWITCH_MATRIX|NULLABLE|value={0}|result={1}\n", nullable, result);
            object obj = new TestStruct(1, 2); result += obj switch { TestStruct(var x, var y) when x + y == 3 => 49, string => 50, _ => 51 }; printf("TRACE|SWITCH_MATRIX|OBJECT|result={0}\n", result);
            dynamic dyn = "dynamic"; switch (dyn) { case string { Length: 7 } text: result += 52; printf("TRACE|SWITCH_MATRIX|DYNAMIC_STRING|text={0}\n", text); break; case int number: result += number; break; default: result += 53; break; }
            TestClass cls = new TestClass(7, "SWITCH_CLASS"); result += cls switch { DerivedTestClass => 54, TestClass { PublicValue: 7 } => 55, _ => 56 }; printf("TRACE|SWITCH_MATRIX|CLASS|result={0}\n", result);
            TestRecord rec = new TestRecord(8, "SWITCH_RECORD") { Score = 9 }; result += rec switch { TestRecord(8, "SWITCH_RECORD") { Score: 9 } => 57, _ => 58 }; printf("TRACE|SWITCH_MATRIX|RECORD|result={0}\n", result);
            int[] arr = new int[] { 1, 2, 3, 4 }; result += arr switch { [1, 2, ..] => 59, [] => 60, _ => 61 }; printf("TRACE|SWITCH_MATRIX|ARRAY_LIST_PATTERN|result={0}\n", result);

            printf("TRACE|SWITCH_MATRIX|ALL_TYPES|END|result={0}\n", result);
            return result;
        }

        public static int RunOperatorMatrix()
        {
            int acc = 0;
            printf("TRACE|OPERATOR_MATRIX|BEGIN\n");
            byte b1 = 12, b2 = 5; printf("TRACE|OPERATOR_MATRIX|BYTE|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}\n", b1 + b2, b1 - b2, b1 * b2, b1 / b2, b1 % b2, b1 & b2, b1 | b2, b1 ^ b2); acc += b1 + b2;
            sbyte sb1 = 12, sb2 = 5; printf("TRACE|OPERATOR_MATRIX|SBYTE|add={0}|sub={1}|neg={2}|not={3}|ushr={4}\n", sb1 + sb2, sb1 - sb2, -sb1, ~sb1, sb1 >>> 1); acc += sb1 + sb2;
            short s1 = 120, s2 = 7; printf("TRACE|OPERATOR_MATRIX|SHORT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|shl={5}|shr={6}|ushr={7}\n", s1 + s2, s1 - s2, s1 * s2, s1 / s2, s1 % s2, s1 << 2, s1 >> 2, s1 >>> 2); acc += s1 + s2;
            ushort us1 = 120, us2 = 7; printf("TRACE|OPERATOR_MATRIX|USHORT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|shl={5}|shr={6}|ushr={7}\n", us1 + us2, us1 - us2, us1 * us2, us1 / us2, us1 % us2, us1 << 2, us1 >> 2, us1 >>> 2); acc += us1 + us2;
            int i1 = -1000, i2 = 37; printf("TRACE|OPERATOR_MATRIX|INT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", i1 + i2, i1 - i2, i1 * i2, i1 / i2, i1 % i2, i1 & i2, i1 | i2, i1 ^ i2, ~i1, i1 << 3, i1 >> 3, i1 >>> 3); acc += i1 + i2;
            uint ui1 = 1000U, ui2 = 37U; printf("TRACE|OPERATOR_MATRIX|UINT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", ui1 + ui2, ui1 - ui2, ui1 * ui2, ui1 / ui2, ui1 % ui2, ui1 & ui2, ui1 | ui2, ui1 ^ ui2, ~ui1, ui1 << 3, ui1 >> 3, ui1 >>> 3); acc += (int)(ui1 + ui2);
            long l1 = -100000L, l2 = 333L; printf("TRACE|OPERATOR_MATRIX|LONG|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", l1 + l2, l1 - l2, l1 * l2, l1 / l2, l1 % l2, l1 & l2, l1 | l2, l1 ^ l2, ~l1, l1 << 4, l1 >> 4, l1 >>> 4); acc += (int)(l1 + l2);
            ulong ul1 = 100000UL, ul2 = 333UL; printf("TRACE|OPERATOR_MATRIX|ULONG|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", ul1 + ul2, ul1 - ul2, ul1 * ul2, ul1 / ul2, ul1 % ul2, ul1 & ul2, ul1 | ul2, ul1 ^ ul2, ~ul1, ul1 << 4, ul1 >> 4, ul1 >>> 4); acc += (int)(ul1 + ul2);
            nint ni1 = (nint)-100, ni2 = (nint)9; printf("TRACE|OPERATOR_MATRIX|NINT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", ni1 + ni2, ni1 - ni2, ni1 * ni2, ni1 / ni2, ni1 % ni2, ni1 & ni2, ni1 | ni2, ni1 ^ ni2, ~ni1, ni1 << 2, ni1 >> 2, ni1 >>> 2); acc += (int)(ni1 + ni2);
            nuint nui1 = (nuint)100, nui2 = (nuint)9; printf("TRACE|OPERATOR_MATRIX|NUINT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|and={5}|or={6}|xor={7}|not={8}|shl={9}|shr={10}|ushr={11}\n", nui1 + nui2, nui1 - nui2, nui1 * nui2, nui1 / nui2, nui1 % nui2, nui1 & nui2, nui1 | nui2, nui1 ^ nui2, ~nui1, nui1 << 2, nui1 >> 2, nui1 >>> 2); acc += (int)(nui1 + nui2);
            char c1 = 'A', c2 = 'C'; printf("TRACE|OPERATOR_MATRIX|CHAR|difference={0}|incBefore={1}\n", c2 - c1, c1); c1++; printf("TRACE|OPERATOR_MATRIX|CHAR|incAfter={0}|compare={1}\n", c1, c1 < c2); acc += c1;
            float f1 = 7.5f, f2 = 2.0f; printf("TRACE|OPERATOR_MATRIX|FLOAT|add={0}|sub={1}|mul={2}|div={3}|mod={4}|lt={5}|gt={6}\n", f1 + f2, f1 - f2, f1 * f2, f1 / f2, f1 % f2, f1 < f2, f1 > f2); acc += (int)(f1 + f2);
            double d1 = 7.5, d2 = 2.0; printf("TRACE|OPERATOR_MATRIX|DOUBLE|add={0}|sub={1}|mul={2}|div={3}|mod={4}|lt={5}|gt={6}\n", d1 + d2, d1 - d2, d1 * d2, d1 / d2, d1 % d2, d1 < d2, d1 > d2); acc += (int)(d1 + d2);
            decimal dec1 = 7.5m, dec2 = 2.0m; printf("TRACE|OPERATOR_MATRIX|DECIMAL|add={0}|sub={1}|mul={2}|div={3}|mod={4}|lt={5}|gt={6}\n", dec1 + dec2, dec1 - dec2, dec1 * dec2, dec1 / dec2, dec1 % dec2, dec1 < dec2, dec1 > dec2); acc += (int)(dec1 + dec2);
            bool bt = true, bf = false; printf("TRACE|OPERATOR_MATRIX|BOOL|not={0}|and={1}|or={2}|xor={3}|conditionalAnd={4}|conditionalOr={5}|eq={6}|neq={7}\n", !bt, bt & bf, bt | bf, bt ^ bf, bt && bf, bt || bf, bt == bf, bt != bf); acc += bt && !bf ? 1 : 0;
            string st1 = "AB", st2 = "CD"; string st3 = st1 + st2; printf("TRACE|OPERATOR_MATRIX|STRING|concat={0}|eq={1}|neq={2}\n", st3, st1 == st2, st1 != st2); acc += st3.Length;
            TestEnum e1 = TestEnum.One, e2 = TestEnum.Two; printf("TRACE|OPERATOR_MATRIX|ENUM|eq={0}|neq={1}|castAdd={2}\n", e1 == e2, e1 != e2, (int)e1 + (int)e2); acc += (int)e1 + (int)e2;
            printf("TRACE|OPERATOR_MATRIX|END|acc={0}\n", acc);
            return acc;
        }

        /// <summary>Runs the core C# 1 through C# 11 positive stress fixture.</summary>
        public static int Main()
        {
            printf("TRACE|PROGRAM|MAIN|BEGIN|version=CSharp11\n");
            int accumulator = 0;

            // Primitive declarations, literal forms, binary literals, digit separators, native integers.
            bool boolTrue = true;
            bool boolFalse = false;
            byte byteValue = 0xFF;
            sbyte sbyteValue = -0x7F;
            short shortValue = -30_000;
            ushort ushortValue = 60_000;
            int intValue = 0b0111_1011_1100_1101;
            uint uintValue = 4_000_000_000U;
            long longValue = 8_000_000_000_000L;
            ulong ulongValue = 16_000_000_000_000UL;
            nint nintValue = (nint)12345;
            nuint nuintValue = (nuint)54321;
            char charValue = 'Q';
            float floatValue = 3.25f;
            double doubleValue = 7.5;
            decimal decimalValue = 9.75m;
            string stringValue = "alpha";
            object objectValue = 123;
            dynamic dynamicValue = 321;

            printf("TRACE|PRIMITIVE|INIT|VALUES|boolTrue={0}|boolFalse={1}|byte={2}|sbyte={3}|short={4}|ushort={5}\n", boolTrue, boolFalse, byteValue, sbyteValue, shortValue, ushortValue);
            printf("TRACE|PRIMITIVE|INIT|NUMERIC|int={0}|uint={1}|long={2}|ulong={3}|nint={4}|nuint={5}\n", intValue, uintValue, longValue, ulongValue, nintValue, nuintValue);
            printf("TRACE|PRIMITIVE|INIT|OTHER|char={0}|float={1}|double={2}|decimal={3}|string={4}\n", charValue, floatValue, doubleValue, decimalValue, stringValue);
            int @class = 321;
            string @new = "VERBATIM_IDENTIFIER";
            string escapedString = "LINE1\nLINE2\t\u0041";
            string verbatimString = @"C:\fixture\path\file.cs";
            string interpolatedVerbatim = $@"ID={@class};NAME={@new};PATH={verbatimString}";
            global::CompilerCoreCSharp11MegaStress.TestClass globalQualified = new global::CompilerCoreCSharp11MegaStress.TestClass(19, "GLOBAL_ALIAS");
            printf("TRACE|LEXICAL|IDENTIFIERS_STRINGS|class={0}|new={1}|nameofClass={2}|escapedLength={3}|verbatim={4}|interpolated={5}|global={6}\n", @class, @new, nameof(@class), escapedString.Length, verbatimString, interpolatedVerbatim, globalQualified.PublicValue);

            int allTypeLoopResult = RunAllTypeLoopMatrix();
            int allTypeSwitchResult = RunAllTypeSwitchMatrix();
            int operatorMatrixResult = RunOperatorMatrix();
            accumulator += allTypeLoopResult + allTypeSwitchResult + operatorMatrixResult;
            printf("TRACE|MATRIX|EARLY_CHECK|loop={0}|switch={1}|operators={2}|acc={3}\n", allTypeLoopResult, allTypeSwitchResult, operatorMatrixResult, accumulator);

            // Complete bitwise/shift family, including C# 11 unsigned right shift.
            int bitSource = -123456789;
            int bitAnd = bitSource & 0x00FF00FF;
            int bitOr = bitSource | 0x0000FFFF;
            int bitXor = bitSource ^ 0x55555555;
            int bitNot = ~bitSource;
            int shiftLeft = bitSource << 3;
            int shiftRight = bitSource >> 3;
            int unsignedShiftRight = bitSource >>> 3;
            printf("TRACE|BITWISE|INT|RESULTS|source={0}|and={1}|or={2}|xor={3}|not={4}|shl={5}|shr={6}|ushr={7}\n", bitSource, bitAnd, bitOr, bitXor, bitNot, shiftLeft, shiftRight, unsignedShiftRight);

            int shiftCompound = bitSource;
            shiftCompound <<= 2;
            printf("TRACE|BITWISE|COMPOUND|SHL_ASSIGN|value={0}\n", shiftCompound);
            shiftCompound >>= 1;
            printf("TRACE|BITWISE|COMPOUND|SHR_ASSIGN|value={0}\n", shiftCompound);
            shiftCompound >>>= 2;
            printf("TRACE|BITWISE|COMPOUND|USHR_ASSIGN|value={0}\n", shiftCompound);
            shiftCompound &= 0x7FFFFFFF;
            printf("TRACE|BITWISE|COMPOUND|AND_ASSIGN|value={0}\n", shiftCompound);
            shiftCompound |= 0x100;
            printf("TRACE|BITWISE|COMPOUND|OR_ASSIGN|value={0}\n", shiftCompound);
            shiftCompound ^= 0x55;
            printf("TRACE|BITWISE|COMPOUND|XOR_ASSIGN|value={0}\n", shiftCompound);

            uint uintShift = 0xF0000000U;
            printf("TRACE|BITWISE|UINT|shl={0}|shr={1}|ushr={2}\n", uintShift << 4, uintShift >> 4, uintShift >>> 4);
            long longShift = -900000000000L;
            printf("TRACE|BITWISE|LONG|shl={0}|shr={1}|ushr={2}\n", longShift << 5, longShift >> 5, longShift >>> 5);
            ulong ulongShift = 0xF000000000000000UL;
            printf("TRACE|BITWISE|ULONG|shl={0}|shr={1}|ushr={2}\n", ulongShift << 5, ulongShift >> 5, ulongShift >>> 5);

            // Checked/unchecked built-in arithmetic and C# 11 checked user-defined operators.
            int checkedValue = checked(1000 + 2000);
            int uncheckedValue = unchecked(int.MaxValue + 1);
            printf("TRACE|CHECKED|BUILTIN|checked={0}|unchecked={1}\n", checkedValue, uncheckedValue);

            OperatorNumber operatorA = new OperatorNumber(100);
            OperatorNumber operatorB = new OperatorNumber(25);
            OperatorNumber operatorUnchecked = unchecked(operatorA + operatorB);
            OperatorNumber operatorChecked = checked(operatorA + operatorB);
            OperatorNumber operatorUnsignedShift = operatorA >>> 2;
            printf("TRACE|CHECKED|USER_OPERATOR|unchecked={0}|checked={1}|ushr={2}\n", operatorUnchecked.Value, operatorChecked.Value, operatorUnsignedShift.Value);

            // Complex short-circuit condition: TraceHelpers proves exact evaluation order.
            bool monsterCondition =
                (
                    (
                        TraceHelpers.Bool(1001, intValue > 0) &&
                        TraceHelpers.Bool(1002, uintValue > 1_000U) &&
                        (
                            TraceHelpers.Bool(1003, ((bitSource << 2) ^ (bitSource >>> 3)) != 0) ||
                            TraceHelpers.Bool(1004, false)
                        )
                    )
                    &&
                    (
                        TraceHelpers.Bool(1005, stringValue is "alpha" or "beta" or "gamma") ||
                        TraceHelpers.Bool(1006, decimalValue is > 100m and < 200m)
                    )
                )
                &&
                !(
                    TraceHelpers.Bool(1007, longValue < 0L) &&
                    (
                        TraceHelpers.Bool(1008, floatValue > 1000f) ||
                        TraceHelpers.Bool(1009, doubleValue < -1000.0)
                    )
                )
                &&
                (
                    TraceHelpers.Bool(1010, charValue is >= 'A' and <= 'Z') &&
                    TraceHelpers.Bool(1011, boolTrue && !boolFalse)
                );

            printf("TRACE|CONDITION|MONSTER_001|RESULT|value={0}\n", monsterCondition);
            if (monsterCondition)
            {
                printf("TRACE|CONDITION|MONSTER_001|TRUE\n");
                accumulator += 101;
            }
            else
            {
                printf("TRACE|CONDITION|MONSTER_001|FALSE\n");
                accumulator -= 101;
            }
            printf("TRACE|CONDITION|MONSTER_001|AFTER|acc={0}\n", accumulator);

            // Switch patterns and switch expressions across primitive/reference/value shapes.
            int[] intPatternValues = new int[] { -777, -5, 0, 4, 15, 16, 101, 1000 };
            for (int i = 0; i < intPatternValues.Length; i++)
            {
                int patternResult = PatternSwitchInt(intPatternValues[i]);
                printf("TRACE|SWITCH_PATTERN|INT|CHECK|index={0}|value={1}|result={2}\n", i, intPatternValues[i], patternResult);
                accumulator += patternResult;
            }

            string?[] stringPatternValues = new string?[] { null, "alpha", "beta", "gamma", "xyz", "LongPatternText", "other-value" };
            for (int i = 0; i < stringPatternValues.Length; i++)
            {
                int patternResult = PatternSwitchString(stringPatternValues[i]);
                printf("TRACE|SWITCH_PATTERN|STRING|CHECK|index={0}|result={1}\n", i, patternResult);
                accumulator += patternResult;
            }

            object?[] objectPatternValues = new object?[]
            {
                null,
                555,
                "text",
                new TestStruct(1, 2),
                new TestRecord(7, "REC") { Score = 9 },
                new DerivedTestClass(3, "DER", 4),
                new TestClass(5, "BASE"),
                2.5
            };
            for (int i = 0; i < objectPatternValues.Length; i++)
            {
                int patternResult = PatternSwitchObject(objectPatternValues[i]);
                printf("TRACE|SWITCH_PATTERN|OBJECT|CHECK|index={0}|result={1}\n", i, patternResult);
                accumulator += patternResult;
            }

            int[][] listPatternValues = new int[][]
            {
                new int[] { },
                new int[] { 1 },
                new int[] { 1, 2 },
                new int[] { 1, 2, 3 },
                new int[] { 2, 3, 4 },
                new int[] { 1, 5, 6, 9 },
                new int[] { 3, 5, 7, 11, 13 }
            };
            for (int i = 0; i < listPatternValues.Length; i++)
            {
                int result = PatternSwitchArray(listPatternValues[i]);
                printf("TRACE|SWITCH_PATTERN|LIST|CHECK|index={0}|length={1}|result={2}\n", i, listPatternValues[i].Length, result);
                accumulator += result;
            }

            accumulator += PatternSwitchNumericTypes(55L, 44U, 33UL, 2.5f, 7.25, 5.5m, 'Q', true, TestEnum.Three);
            printf("TRACE|SWITCH_PATTERN|NUMERIC_TYPES|AFTER|acc={0}\n", accumulator);

            // Tuple and positional patterns.
            (int Left, string Right) tupleValue = (7, "seven");
            int tuplePatternResult = tupleValue switch
            {
                (0, _) => 1,
                (> 0 and < 10, "seven") => 2,
                (> 10, _) => 3,
                _ => 4
            };
            printf("TRACE|PATTERN|TUPLE|left={0}|right={1}|result={2}\n", tupleValue.Left, tupleValue.Right, tuplePatternResult);
            accumulator += tuplePatternResult;

            int inferredTupleLeft = 12;
            string inferredTupleRight = "TUPLE";
            var inferredTuple = (inferredTupleLeft, inferredTupleRight);
            (int deconstructedLeft, string deconstructedRight) = inferredTuple;
            (deconstructedLeft, deconstructedRight) = (deconstructedLeft + 1, deconstructedRight + "X");
            bool tupleEquality = (1, 2, "A") == (1, 2, "A");
            bool tupleInequality = (1, 2) != (2, 1);
            printf("TRACE|TUPLE|DECONSTRUCT_EQUALITY|left={0}|right={1}|eq={2}|neq={3}\n", deconstructedLeft, deconstructedRight, tupleEquality, tupleInequality);

            TestStruct positional = new TestStruct(8, 9);
            bool positionalMatch = positional is (> 0, > 0);
            printf("TRACE|PATTERN|POSITIONAL|x={0}|y={1}|result={2}\n", positional.X, positional.Y, positionalMatch);
            (int positionalX, int positionalY) = positional;
            (int positionalOnlyX, _) = positional;
            _ = positional.Sum();
            printf("TRACE|DECONSTRUCT|CHECK|x={0}|y={1}|onlyX={2}\n", positionalX, positionalY, positionalOnlyX);

            // Primitive loop matrix: for/while/do across numeric, char, bool, string, object, dynamic.
            for (byte v = 0; v < 4; v++) { printf("TRACE|LOOP|FOR_BYTE|ITER|v={0}\n", v); accumulator += v; }
            for (sbyte v = -2; v < 2; v++) { printf("TRACE|LOOP|FOR_SBYTE|ITER|v={0}\n", v); accumulator += v; }
            for (short v = -2; v < 2; v++) { printf("TRACE|LOOP|FOR_SHORT|ITER|v={0}\n", v); accumulator += v; }
            for (ushort v = 0; v < 4; v++) { printf("TRACE|LOOP|FOR_USHORT|ITER|v={0}\n", v); accumulator += v; }
            for (int v = -2; v < 3; v++) { printf("TRACE|LOOP|FOR_INT|ITER|v={0}\n", v); accumulator += v; }
            for (uint v = 0U; v < 4U; v++) { printf("TRACE|LOOP|FOR_UINT|ITER|v={0}\n", v); accumulator += (int)v; }
            for (long v = -2L; v < 3L; v++) { printf("TRACE|LOOP|FOR_LONG|ITER|v={0}\n", v); accumulator += (int)v; }
            for (ulong v = 0UL; v < 4UL; v++) { printf("TRACE|LOOP|FOR_ULONG|ITER|v={0}\n", v); accumulator += (int)v; }
            for (nint v = (nint)0; v < (nint)4; v++) { printf("TRACE|LOOP|FOR_NINT|ITER|v={0}\n", v); accumulator += (int)v; }
            for (nuint v = (nuint)0; v < (nuint)4; v++) { printf("TRACE|LOOP|FOR_NUINT|ITER|v={0}\n", v); accumulator += (int)v; }
            for (char v = 'a'; v <= 'd'; v++) { printf("TRACE|LOOP|FOR_CHAR|ITER|v={0}\n", v); accumulator += v; }
            for (float v = 0.0f; v < 2.0f; v += 0.5f) { printf("TRACE|LOOP|FOR_FLOAT|ITER|v={0}\n", v); accumulator += (int)(v * 10); }
            for (double v = 0.0; v < 2.0; v += 0.5) { printf("TRACE|LOOP|FOR_DOUBLE|ITER|v={0}\n", v); accumulator += (int)(v * 10); }
            for (decimal v = 0.0m; v < 2.0m; v += 0.5m) { printf("TRACE|LOOP|FOR_DECIMAL|ITER|v={0}\n", v); accumulator += (int)(v * 10m); }

