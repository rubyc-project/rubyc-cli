    public struct StaticNumber : IStaticNumber<StaticNumber>
    {
        public int Value;

        public StaticNumber(int value)
        {
            Value = value;
            printf("TRACE|CTOR|StaticNumber|CREATE|value={0}\n", Value);
        }

        public static StaticNumber Zero => new StaticNumber(0);
        public static StaticNumber One => new StaticNumber(1);

        public static StaticNumber operator +(StaticNumber left, StaticNumber right)
        {
            printf("TRACE|OPERATOR|StaticNumber|ADD|left={0}|right={1}\n", left.Value, right.Value);
            return new StaticNumber(left.Value + right.Value);
        }

        public static StaticNumber operator -(StaticNumber left, StaticNumber right)
        {
            printf("TRACE|OPERATOR|StaticNumber|SUB|left={0}|right={1}\n", left.Value, right.Value);
            return new StaticNumber(left.Value - right.Value);
        }

        public static StaticNumber operator *(StaticNumber left, StaticNumber right)
        {
            printf("TRACE|OPERATOR|StaticNumber|MUL|left={0}|right={1}\n", left.Value, right.Value);
            return new StaticNumber(left.Value * right.Value);
        }

        public static StaticNumber operator >>>(StaticNumber value, int amount)
        {
            printf("TRACE|OPERATOR|StaticNumber|USHR|value={0}|amount={1}\n", value.Value, amount);
            return new StaticNumber(value.Value >>> amount);
        }

        public static bool operator >(StaticNumber left, StaticNumber right) => left.Value > right.Value;
        public static bool operator <(StaticNumber left, StaticNumber right) => left.Value < right.Value;
    }

    public struct OperatorNumber
    {
        public int Value;

        public OperatorNumber(int value)
        {
            Value = value;
            printf("TRACE|CTOR|OperatorNumber|CREATE|value={0}\n", Value);
        }

        public static OperatorNumber operator +(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value + right.Value);
        public static OperatorNumber operator checked +(OperatorNumber left, OperatorNumber right) => new OperatorNumber(checked(left.Value + right.Value));
        public static OperatorNumber operator -(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value - right.Value);
        public static OperatorNumber operator checked -(OperatorNumber left, OperatorNumber right) => new OperatorNumber(checked(left.Value - right.Value));
        public static OperatorNumber operator *(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value * right.Value);
        public static OperatorNumber operator checked *(OperatorNumber left, OperatorNumber right) => new OperatorNumber(checked(left.Value * right.Value));
        public static OperatorNumber operator /(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value / right.Value);
        public static OperatorNumber operator checked /(OperatorNumber left, OperatorNumber right) => new OperatorNumber(checked(left.Value / right.Value));
        public static OperatorNumber operator %(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value % right.Value);
        public static OperatorNumber operator &(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value & right.Value);
        public static OperatorNumber operator |(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value | right.Value);
        public static OperatorNumber operator ^(OperatorNumber left, OperatorNumber right) => new OperatorNumber(left.Value ^ right.Value);
        public static OperatorNumber operator ~(OperatorNumber value) => new OperatorNumber(~value.Value);
        public static OperatorNumber operator <<(OperatorNumber value, int amount) => new OperatorNumber(value.Value << amount);
        public static OperatorNumber operator >>(OperatorNumber value, int amount) => new OperatorNumber(value.Value >> amount);
        public static OperatorNumber operator >>>(OperatorNumber value, int amount) => new OperatorNumber(value.Value >>> amount);
        public static OperatorNumber operator ++(OperatorNumber value) => new OperatorNumber(value.Value + 1);
        public static OperatorNumber operator checked ++(OperatorNumber value) => new OperatorNumber(checked(value.Value + 1));
        public static OperatorNumber operator --(OperatorNumber value) => new OperatorNumber(value.Value - 1);
        public static OperatorNumber operator checked --(OperatorNumber value) => new OperatorNumber(checked(value.Value - 1));
        public static OperatorNumber operator -(OperatorNumber value) => new OperatorNumber(-value.Value);
        public static OperatorNumber operator checked -(OperatorNumber value) => new OperatorNumber(checked(-value.Value));
        public static OperatorNumber operator +(OperatorNumber value) => value;
        public static bool operator !(OperatorNumber value) => value.Value == 0;
        public static bool operator true(OperatorNumber value) => value.Value != 0;
        public static bool operator false(OperatorNumber value) => value.Value == 0;
        public static bool operator ==(OperatorNumber left, OperatorNumber right) => left.Value == right.Value;
        public static bool operator !=(OperatorNumber left, OperatorNumber right) => left.Value != right.Value;
        public static bool operator <(OperatorNumber left, OperatorNumber right) => left.Value < right.Value;
        public static bool operator >(OperatorNumber left, OperatorNumber right) => left.Value > right.Value;
        public static bool operator <=(OperatorNumber left, OperatorNumber right) => left.Value <= right.Value;
        public static bool operator >=(OperatorNumber left, OperatorNumber right) => left.Value >= right.Value;
        public static implicit operator OperatorNumber(int value) => new OperatorNumber(value);
        public static implicit operator int(OperatorNumber value) => value.Value;
        public static explicit operator byte(OperatorNumber value) => (byte)value.Value;
        public static explicit operator checked byte(OperatorNumber value) => checked((byte)value.Value);

        public override bool Equals(object? value)
        {
            return value is OperatorNumber other && other.Value == Value;
        }

        public override int GetHashCode() => Value;
    }

    /// <summary>Reference type used for constructor, inheritance, interface and finalizer tests.</summary>
    public class TestClass : IValueProvider, IValueProvider<int>, IDefaultInterface
    {
        private int _privateValue;
        protected int ProtectedValue;
        public int PublicValue;
        public string Name;

        public TestClass()
            : this(10, "DEFAULT")
        {
            printf("TRACE|CTOR|TestClass|PARAMETERLESS|public={0}|name={1}\n", PublicValue, Name);
        }

        public TestClass(int value)
            : this(value, "VALUE")
        {
            printf("TRACE|CTOR|TestClass|ONE_PARAM|value={0}\n", value);
        }

        public TestClass(int value, string name)
        {
            _privateValue = value + 1;
            ProtectedValue = value + 2;
            PublicValue = value;
            Name = name;
            printf("TRACE|CTOR|TestClass|TWO_PARAM|public={0}|protected={1}|private={2}|name={3}\n", PublicValue, ProtectedValue, _privateValue, Name);
        }

        ~TestClass()
        {
            printf("FINALIZER|TestClass|public={0}|name={1}\n", PublicValue, Name);
        }

        public virtual int GetValue()
        {
            int result = _privateValue + ProtectedValue + PublicValue;
            printf("TRACE|METHOD|TestClass.GetValue|RETURN|result={0}\n", result);
            return result;
        }

        int IValueProvider<int>.GetValue()
        {
            printf("TRACE|INTERFACE|TestClass|EXPLICIT_GENERIC_GET|value={0}\n", PublicValue);
            return PublicValue;
        }

        public int GetBaseValue() => PublicValue;

        public int GetPrivateViaPublic()
        {
            printf("TRACE|ACCESS|TestClass|PRIVATE_READ|value={0}\n", _privateValue);
            return _privateValue;
        }

        protected int GetProtectedValue()
        {
            printf("TRACE|ACCESS|TestClass|PROTECTED_READ|value={0}\n", ProtectedValue);
            return ProtectedValue;
        }

        public virtual TestClass Clone()
        {
            printf("TRACE|METHOD|TestClass.Clone|BASE|value={0}|name={1}\n", PublicValue, Name);
            return new TestClass(PublicValue, Name);
        }
    }

    public class DerivedTestClass : TestClass
    {
        public int DerivedValue;

        public DerivedTestClass(int baseValue, string name, int derivedValue)
            : base(baseValue, name)
        {
            DerivedValue = derivedValue;
            printf("TRACE|CTOR|DerivedTestClass|CREATE|base={0}|derived={1}|name={2}\n", PublicValue, DerivedValue, Name);
        }

        ~DerivedTestClass()
        {
            printf("FINALIZER|DerivedTestClass|public={0}|derived={1}|name={2}\n", PublicValue, DerivedValue, Name);
        }

        public override int GetValue()
        {
            int result = base.GetValue() + DerivedValue + GetProtectedValue();
            printf("TRACE|METHOD|DerivedTestClass.GetValue|RETURN|result={0}\n", result);
            return result;
        }

        public override DerivedTestClass Clone()
        {
            printf("TRACE|METHOD|DerivedTestClass.Clone|COVARIANT|public={0}|derived={1}\n", PublicValue, DerivedValue);
            return new DerivedTestClass(PublicValue, Name, DerivedValue);
        }
    }

    public abstract class AbstractBase
    {
        protected int BaseValue;

        protected AbstractBase(int value)
        {
            BaseValue = value;
            printf("TRACE|CTOR|AbstractBase|PROTECTED|value={0}\n", BaseValue);
        }

        public abstract int Compute(int value);

        public virtual int VirtualCompute(int value)
        {
            int result = BaseValue + value;
            printf("TRACE|METHOD|AbstractBase.VirtualCompute|RETURN|result={0}\n", result);
            return result;
        }
    }

    public sealed class ConcreteSealed : AbstractBase
    {
        public ConcreteSealed(int value)
            : base(value)
        {
            printf("TRACE|CTOR|ConcreteSealed|CREATE|value={0}\n", value);
        }

        public override int Compute(int value)
        {
            int result = BaseValue * value;
            printf("TRACE|METHOD|ConcreteSealed.Compute|RETURN|result={0}\n", result);
            return result;
        }

        public sealed override int VirtualCompute(int value)
        {
            int result = BaseValue - value;
            printf("TRACE|METHOD|ConcreteSealed.VirtualCompute|RETURN|result={0}\n", result);
            return result;
        }
    }

    public class AccessBase
    {
        private int _privateBase;
        protected int ProtectedBase;
        internal int InternalBase;
        protected internal int ProtectedInternalBase;
        private protected int PrivateProtectedBase;
        public int PublicBase;

        private AccessBase(int privateValue, int protectedValue, int publicValue, bool privateCtorTag)
        {
            _privateBase = privateValue;
            ProtectedBase = protectedValue;
            InternalBase = protectedValue + 10;
            ProtectedInternalBase = protectedValue + 20;
            PrivateProtectedBase = protectedValue + 30;
            PublicBase = publicValue;
            printf("TRACE|CTOR|AccessBase|PRIVATE|private={0}|protected={1}|internal={2}|protectedInternal={3}|privateProtected={4}|public={5}|tag={6}\n", _privateBase, ProtectedBase, InternalBase, ProtectedInternalBase, PrivateProtectedBase, PublicBase, privateCtorTag);
        }

        protected AccessBase(int protectedValue, int publicValue)
        {
            _privateBase = protectedValue - 1;
            ProtectedBase = protectedValue;
            InternalBase = protectedValue + 10;
            ProtectedInternalBase = protectedValue + 20;
            PrivateProtectedBase = protectedValue + 30;
            PublicBase = publicValue;
            printf("TRACE|CTOR|AccessBase|PROTECTED|private={0}|protected={1}|internal={2}|protectedInternal={3}|privateProtected={4}|public={5}\n", _privateBase, ProtectedBase, InternalBase, ProtectedInternalBase, PrivateProtectedBase, PublicBase);
        }

        public AccessBase(int publicValue)
        {
            _privateBase = publicValue - 2;
            ProtectedBase = publicValue - 1;
            InternalBase = publicValue + 10;
            ProtectedInternalBase = publicValue + 20;
            PrivateProtectedBase = publicValue + 30;
            PublicBase = publicValue;
            printf("TRACE|CTOR|AccessBase|PUBLIC|private={0}|protected={1}|internal={2}|protectedInternal={3}|privateProtected={4}|public={5}\n", _privateBase, ProtectedBase, InternalBase, ProtectedInternalBase, PrivateProtectedBase, PublicBase);
        }

        ~AccessBase()
        {
            printf("FINALIZER|AccessBase|private={0}|protected={1}|public={2}\n", _privateBase, ProtectedBase, PublicBase);
        }

        public static AccessBase CreateWithPrivateConstructor(int seed)
        {
            printf("TRACE|ACCESS|AccessBase|PRIVATE_CTOR_FACTORY|seed={0}\n", seed);
            return new AccessBase(seed, seed + 1, seed + 2, true);
        }

        private int PrivateMethod(int value)
        {
            int result = _privateBase + value;
            printf("TRACE|ACCESS|AccessBase|PRIVATE_METHOD|value={0}|result={1}\n", value, result);
            return result;
        }

        protected int ProtectedMethod(int value)
        {
            int result = ProtectedBase + value;
            printf("TRACE|ACCESS|AccessBase|PROTECTED_METHOD|value={0}|result={1}\n", value, result);
            return result;
        }

        public int PublicMethod(int value)
        {
            int result = PublicBase + value + PrivateMethod(value);
            printf("TRACE|ACCESS|AccessBase|PUBLIC_METHOD|value={0}|result={1}\n", value, result);
            return result;
        }
    }

    public class AccessDerived : AccessBase
    {
        public int Derived;

        public AccessDerived(int protectedBase, int publicBase, int derived)
            : base(protectedBase, publicBase)
        {
            Derived = derived;
            printf("TRACE|CTOR|AccessDerived|CREATE|protectedBase={0}|publicBase={1}|derived={2}\n", protectedBase, publicBase, Derived);
        }

        ~AccessDerived()
        {
            printf("FINALIZER|AccessDerived|publicBase={0}|derived={1}\n", PublicBase, Derived);
        }

        public int CallProtected(int value)
        {
            int result = ProtectedMethod(value) + ProtectedBase + InternalBase + ProtectedInternalBase + PrivateProtectedBase + Derived;
            printf("TRACE|ACCESS|AccessDerived|CALL_PROTECTED|value={0}|protected={1}|internal={2}|protectedInternal={3}|privateProtected={4}|result={5}\n", value, ProtectedBase, InternalBase, ProtectedInternalBase, PrivateProtectedBase, result);
            return result;
        }
    }

    public class StaticConstructorTarget
    {
        public static int StaticValue;
        public int InstanceValue;

        static StaticConstructorTarget()
        {
            StaticValue = 8080;
            printf("TRACE|STATIC_CTOR|StaticConstructorTarget|RUN|staticValue={0}\n", StaticValue);
        }

        public StaticConstructorTarget(int value)
        {
            InstanceValue = value;
            printf("TRACE|CTOR|StaticConstructorTarget|INSTANCE|value={0}|staticValue={1}\n", InstanceValue, StaticValue);
        }
    }

    [System.Runtime.CompilerServices.InterpolatedStringHandler]
    public ref struct TraceInterpolatedStringHandler
    {
        private int _literalLength;
        private int _formattedCount;
        private int _appendCount;
        private int _contextId;

        public TraceInterpolatedStringHandler(int literalLength, int formattedCount, int contextId)
        {
            _literalLength = literalLength;
            _formattedCount = formattedCount;
            _appendCount = 0;
            _contextId = contextId;
            printf("TRACE|INTERPOLATED_HANDLER|CTOR|context={0}|literalLength={1}|formattedCount={2}\n", _contextId, _literalLength, _formattedCount);
        }

        public void AppendLiteral(string value)
        {
            _appendCount++;
            printf("TRACE|INTERPOLATED_HANDLER|APPEND_LITERAL|context={0}|count={1}|length={2}|value={3}\n", _contextId, _appendCount, value.Length, value);
        }

        public void AppendFormatted<T>(T value)
        {
            _appendCount++;
            printf("TRACE|INTERPOLATED_HANDLER|APPEND_FORMATTED|context={0}|count={1}\n", _contextId, _appendCount);
        }

        public int Score => _literalLength + _formattedCount * 100 + _appendCount * 1000 + _contextId;
    }

