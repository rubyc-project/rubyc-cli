            }
            while (doObjectGuard < 3);

            int dynamicGuard = 0;
            do
            {
                printf("TRACE|LOOP|DO_DYNAMIC|ITER|guard={0}|value={1}\n", dynamicGuard, dynamicValue);
                dynamicValue = dynamicValue + 5;
                dynamicGuard++;
                printf("TRACE|LOOP|DO_DYNAMIC|MUTATE|guard={0}|value={1}\n", dynamicGuard, dynamicValue);
            }
            while (dynamicGuard < 3);

            // Arrays: single, multidimensional, jagged, indexing, ranges, list patterns.
            int[] oneDimensional = new int[12];
            for (int i = 0; i < oneDimensional.Length; i++)
            {
                oneDimensional[i] = i * i + 3;
                printf("TRACE|ARRAY|1D|WRITE|index={0}|value={1}\n", i, oneDimensional[i]);
            }

            int[,] twoDimensional = new int[4, 5];
            for (int row = 0; row < 4; row++)
            {
                for (int column = 0; column < 5; column++)
                {
                    twoDimensional[row, column] = row * 100 + column;
                    printf("TRACE|ARRAY|2D|WRITE|row={0}|column={1}|value={2}\n", row, column, twoDimensional[row, column]);
                }
            }

            int[,,] threeDimensional = new int[3, 3, 3];
            for (int x = 0; x < 3; x++)
            {
                for (int y = 0; y < 3; y++)
                {
                    for (int z = 0; z < 3; z++)
                    {
                        threeDimensional[x, y, z] = x * 100 + y * 10 + z;
                        printf("TRACE|ARRAY|3D|WRITE|x={0}|y={1}|z={2}|value={3}\n", x, y, z, threeDimensional[x, y, z]);
                    }
                }
            }

            int[][] jagged = new int[3][];
            jagged[0] = new int[] { 1, 2 };
            jagged[1] = new int[] { 3, 4, 5 };
            jagged[2] = new int[] { 6, 7, 8, 9 };
            for (int i = 0; i < jagged.Length; i++)
            {
                for (int j = 0; j < jagged[i].Length; j++)
                {
                    printf("TRACE|ARRAY|JAGGED|READ|i={0}|j={1}|value={2}\n", i, j, jagged[i][j]);
                }
            }

            int lastValue = oneDimensional[^1];
            int[] middleRange = oneDimensional[2..^2];
            printf("TRACE|RANGE|ARRAY|last={0}|middleLength={1}|middleFirst={2}|middleLast={3}\n", lastValue, middleRange.Length, middleRange[0], middleRange[^1]);

            // Object, collection and index initializers.
            PropertyContainer propertyContainer = new PropertyContainer { Value = 44, Auto = 55, InitOnly = "SET_INIT" };
            printf("TRACE|INITIALIZER|OBJECT|value={0}|auto={1}|getterOnly={2}|initOnly={3}|expression={4}\n", propertyContainer.Value, propertyContainer.Auto, propertyContainer.GetterOnly, propertyContainer.InitOnly, propertyContainer.Expression);

            IntBag bag = new IntBag { 3, 5, 7, 11, 13 };
            printf("TRACE|INITIALIZER|COLLECTION|count={0}\n", bag.Count);
            foreach (int value in bag)
            {
                printf("TRACE|FOREACH|INT_BAG|VALUE|value={0}\n", value);
                accumulator += value;
            }

            IndexedStore indexed = new IndexedStore { [1] = 101, [2] = 202, [3] = 303 };
            printf("TRACE|INITIALIZER|INDEX|v1={0}|v2={1}|v3={2}\n", indexed[1], indexed[2], indexed[3]);

            var anonymousValue = new { Id = 77, Name = "ANON", Nested = new { Value = 88 } };
            printf("TRACE|ANONYMOUS_TYPE|VALUE|id={0}|name={1}|nested={2}\n", anonymousValue.Id, anonymousValue.Name, anonymousValue.Nested.Value);

            // Query expression translated through custom Where/Select pattern.
            IntSequence sequence = new IntSequence(new int[] { 1, 2, 3, 4, 5, 6 }, 6);
            IntSequence queryResult =
                from queryValue in sequence
                where queryValue > 2 && (queryValue & 1) == 0
                select queryValue * 10;
            foreach (int queryValue in queryResult)
            {
                printf("TRACE|QUERY|RESULT|value={0}\n", queryValue);
                accumulator += queryValue;
            }

            // Delegates, anonymous methods, lambdas, closures, method groups, events.
            IntUnary methodGroup = AddOne;
            printf("TRACE|DELEGATE|METHOD_GROUP|result={0}\n", methodGroup(10));
            IntUnary anonymousMethod = delegate(int value)
            {
                int result = value * 2;
                printf("TRACE|DELEGATE|ANONYMOUS_METHOD|value={0}|result={1}\n", value, result);
                return result;
            };
            printf("TRACE|DELEGATE|ANONYMOUS_METHOD_CHECK|result={0}\n", anonymousMethod(12));

            int closureSeed = 5;
            IntUnary lambda = value =>
            {
                int result = value + closureSeed;
                printf("TRACE|LAMBDA|CLOSURE|value={0}|seed={1}|result={2}\n", value, closureSeed, result);
                return result;
            };
            printf("TRACE|LAMBDA|CLOSURE_CHECK|result={0}\n", lambda(20));
            closureSeed = 9;
            printf("TRACE|LAMBDA|CLOSURE_AFTER_MUTATE|result={0}\n", lambda(20));

            IntUnary staticLambda = static value => value * 4;
            printf("TRACE|LAMBDA|STATIC|result={0}\n", staticLambda(7));
            IntUnary explicitReturnLambda = int (int value) => value + 6;
            printf("TRACE|LAMBDA|EXPLICIT_RETURN|result={0}\n", explicitReturnLambda(7));
            IntUnary attributedLambda = [NameMarker("lambda-expression")] (int value) => value + 7;
            IntUnary attributedParameterLambda = ([NameMarker("lambda-parameter")] int value) => value + 8;
            printf("TRACE|LAMBDA|ATTRIBUTES|lambda={0}|parameter={1}\n", attributedLambda(7), attributedParameterLambda(7));
            var naturalLambda = (int value) => value + 9;
            var naturalMethodGroup = AddOne;
            printf("TRACE|LAMBDA|NATURAL_TYPES|lambda={0}|methodGroup={1}\n", naturalLambda(7), naturalMethodGroup(7));

            EventSource eventSource = new EventSource();
            eventSource.Changed += AddOne;
            printf("TRACE|EVENT|SUBSCRIBE|handler=AddOne\n");
            int eventResult = eventSource.Raise(30);
            printf("TRACE|EVENT|CHECK|result={0}\n", eventResult);
            eventSource.Changed -= AddOne;
            printf("TRACE|EVENT|UNSUBSCRIBE|handler=AddOne\n");
            printf("TRACE|EVENT|CHECK_AFTER_REMOVE|result={0}\n", eventSource.Raise(30));

            // Extension methods.
            int tripled = 14.Triple();
            string extendedText = "A".AppendToken("B").AppendToken("C");
            printf("TRACE|EXTENSION|CHECK|tripled={0}|text={1}\n", tripled, extendedText);

            // Local functions, generic local functions and recursion.
            int LocalRecursive(int value)
            {
                printf("TRACE|LOCAL_FUNCTION|RECURSIVE|ENTER|value={0}\n", value);
                if (value <= 1)
                {
                    printf("TRACE|LOCAL_FUNCTION|RECURSIVE|BASE|value={0}\n", value);
                    return 1;
                }
                int result = value * LocalRecursive(value - 1);
                printf("TRACE|LOCAL_FUNCTION|RECURSIVE|RETURN|value={0}|result={1}\n", value, result);
                return result;
            }

            T LocalIdentity<T>(T value)
            {
                printf("TRACE|LOCAL_FUNCTION|GENERIC_IDENTITY|CALL\n");
                return value;
            }

            static int StaticLocal(int value)
            {
                return value * 5;
            }

            int localRecursiveResult = LocalRecursive(5);
            int localGenericInt = LocalIdentity(123);
            string localGenericString = LocalIdentity("LOCAL");
            int staticLocalResult = StaticLocal(8);
            printf("TRACE|LOCAL_FUNCTION|CHECK|recursive={0}|genericInt={1}|genericString={2}|static={3}\n", localRecursiveResult, localGenericInt, localGenericString, staticLocalResult);

            // Named, optional, params arguments.
            int optional1 = OptionalNamedParams(10);
            int optional2 = OptionalNamedParams(required: 10, label: "NAMED", optional: 20);
            int paramsResult = ParamsSum("P", 1, 2, 3, 4, 5);
            printf("TRACE|PARAMS|CHECK|optional1={0}|optional2={1}|params={2}\n", optional1, optional2, paramsResult);

            // ref, out, in, ref locals, conditional refs, ref reassignment and C# 11 scoped refs/ref fields.
            int refInput = 10;
            int inInput = 7;
            RefOutIn(ref refInput, out int outResult, in inInput);
            printf("TRACE|REF|CHECK|ref={0}|out={1}|in={2}\n", refInput, outResult, inInput);

            int[] refArray = new int[] { 10, 20, 30, 40 };
            ref int refElement = ref RefReturn(refArray, 2);
            refElement += 5;
            printf("TRACE|REF|LOCAL_MUTATE|array2={0}\n", refArray[2]);
            ref int conditionalRef = ref (boolTrue ? ref refArray[0] : ref refArray[1]);
            conditionalRef += 9;
            printf("TRACE|REF|CONDITIONAL|array0={0}|array1={1}\n", refArray[0], refArray[1]);
            conditionalRef = ref refArray[3];
            conditionalRef += 11;
            printf("TRACE|REF|REASSIGN|array3={0}\n", refArray[3]);
            ref readonly int readonlyReference = ref RefReadonlyReturn(in inInput);
            printf("TRACE|REF|READONLY|value={0}\n", readonlyReference);

            int refFieldBacking = 50;
