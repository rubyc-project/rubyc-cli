            printf("TRACE|ATTR|NAME_MARKER|CTOR|name={0}\n", name);
        }
    }

    public interface IValueProvider
    {
        int GetValue();
    }

    public interface IValueProvider<T>
    {
        T GetValue();
    }

    public interface IProducer<out T>
    {
        T Produce();
    }

    public interface IConsumer<in T>
    {
        void Consume(T value);
    }

    public interface ITransformer<in TInput, out TOutput>
    {
        TOutput Transform(TInput value);
    }

    public interface IDefaultInterface
    {
        int GetBaseValue();

        int GetDefaultValue()
        {
            printf("TRACE|INTERFACE|DEFAULT|CALL|value=700\n");
            return 700;
        }
    }

    public interface IStaticNumber<TSelf>
        where TSelf : IStaticNumber<TSelf>
    {
        static abstract TSelf Zero { get; }
        static abstract TSelf One { get; }
        static abstract TSelf operator +(TSelf left, TSelf right);
        static abstract TSelf operator -(TSelf left, TSelf right);
        static abstract TSelf operator *(TSelf left, TSelf right);
        static abstract TSelf operator >>>(TSelf value, int amount);
        static virtual int Kind => 314;
        static abstract bool operator >(TSelf left, TSelf right);
        static abstract bool operator <(TSelf left, TSelf right);
    }

    public delegate int IntUnary(int value);
    public delegate int IntBinary(int left, int right);
    public delegate void IntSink(int value);
    public delegate TResult GenericConverter<TInput, TResult>(TInput value);
    public delegate TResult GenericCombiner<T1, T2, TResult>(T1 value1, T2 value2);
    public delegate T GenericIdentityDelegate<T>(T value);
    public delegate TOutput VariantTransformer<in TInput, out TOutput>(TInput value);

    public struct TestStruct
    {
