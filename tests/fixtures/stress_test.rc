            // Local generic function at maximum requested arity; all type parameters are independently bound.
            TResult LocalGeneric10<T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, TResult>(int caseId, T1 value1, T2 value2, T3 value3, T4 value4, T5 value5, T6 value6, T7 value7, T8 value8, T9 value9, T10 value10, TResult result)
            {
                printf("TRACE|LOCAL_GENERIC|A10_RESULT|ENTER|case={0}\n", caseId);
                printf("TRACE|LOCAL_GENERIC|A10_RESULT|SLOTS|case={0}|v1={1}|v2={2}|v3={3}|v4={4}|v5={5}|v6={6}|v7={7}|v8={8}|v9={9}|v10={10}|result={11}\n", caseId, value1, value2, value3, value4, value5, value6, value7, value8, value9, value10, result);
                return result;
            }
            string localGeneric10Result = LocalGeneric10<int, string, long, double, TestStruct, bool, TestClass, decimal, byte, TestEnum, string>(99200, 1, "TWO", 3L, 4.0, new TestStruct(5, 6), true, new TestClass(7, "SEVEN_LOCAL"), 8m, (byte)9, TestEnum.Two, "LOCAL_GENERIC_RESULT");
            printf("TRACE|LOCAL_GENERIC|A10_RESULT|CHECK|result={0}\n", localGeneric10Result);

            // Dynamic: conversion, arithmetic, comparison, member invocation through a dynamic class instance.
            dynamic dynamicNumber = 40;
            dynamic dynamicText = "DYN";
            dynamic dynamicClass = new TestClass(12, "DYNAMIC_CLASS");
            dynamicNumber = dynamicNumber + 2;
            bool dynamicCompare = dynamicNumber > 10;
            string dynamicConcat = dynamicText + "_TEXT";
            int dynamicMethod = dynamicClass.GetValue();
            printf("TRACE|DYNAMIC|CHECK|number={0}|compare={1}|text={2}|method={3}\n", dynamicNumber, dynamicCompare, dynamicConcat, dynamicMethod);

            // Iterator/yield state-machine syntax.
            int yieldAccumulator = 0;
            foreach (int yielded in IteratorTests.YieldValues(10, 5))
            {
                yieldAccumulator += yielded;
                printf("TRACE|YIELD|FOREACH|value={0}|sum={1}\n", yielded, yieldAccumulator);
            }
            accumulator += yieldAccumulator;

            // goto, labels, goto case/default, break, continue.
            int gotoValue = 0;
        GotoStart:
            printf("TRACE|GOTO|LABEL|GotoStart|value={0}\n", gotoValue);
            gotoValue++;
            if (gotoValue < 2)
            {
                printf("TRACE|GOTO|JUMP|target=GotoStart|value={0}\n", gotoValue);
                goto GotoStart;
            }

            int gotoSwitch = 1;
            switch (gotoSwitch)
            {
                case 1:
                    printf("TRACE|GOTO|SWITCH|CASE_1\n");
                    goto case 2;
                case 2:
                    printf("TRACE|GOTO|SWITCH|CASE_2\n");
                    goto default;
                default:
                    printf("TRACE|GOTO|SWITCH|DEFAULT\n");
                    break;
            }

            for (int control = 0; control < 12; control++)
            {
                printf("TRACE|CONTROL|LOOP|ITER|control={0}\n", control);
                if (control == 3 || control == 7)
                {
                    printf("TRACE|CONTROL|CONTINUE|control={0}\n", control);
                    continue;
                }
                if (control == 10)
                {
                    printf("TRACE|CONTROL|BREAK|control={0}\n", control);
                    break;
                }
                accumulator += control;
                printf("TRACE|CONTROL|MUTATE|control={0}|acc={1}\n", control, accumulator);
            }

            // Exception propagation, filters, rethrow, finally and deliberate throws.
            for (int code = 1; code <= 6; code++)
            {
                printf("TRACE|EXCEPTION|LEVEL_CALL|BEGIN|code={0}\n", code);
                try
                {
                    int result = ThrowLevel1(code);
                    printf("TRACE|EXCEPTION|LEVEL_CALL|RESULT|code={0}|result={1}\n", code, result);
                    accumulator += result;
                }
                catch (DerivedCompilerTestException exception)
                {
                    printf("TRACE|EXCEPTION|LEVEL_CALL|FINAL_DERIVED_CATCH|code={0}|detail={1}\n", exception.Code, exception.Detail);
                    accumulator += 5000 + exception.Detail;
                }
                finally
                {
                    printf("TRACE|EXCEPTION|LEVEL_CALL|FINALLY|code={0}|acc={1}\n", code, accumulator);
                }
            }

            int exceptionTortureResult = RunExceptionTorture(accumulator & 255);
            accumulator ^= exceptionTortureResult;
            printf("TRACE|EXCEPTION|TORTURE_CHECK|result={0}|acc={1}\n", exceptionTortureResult, accumulator);

            // Throw expression path: successful and deliberate failure.
            string ensured = EnsureString("NOT_NULL");
            printf("TRACE|THROW_EXPR|SUCCESS|value={0}\n", ensured);
            try
            {
                string shouldThrow = EnsureString(null);
                printf("TRACE|THROW_EXPR|UNEXPECTED|value={0}\n", shouldThrow);
            }
            catch (CompilerTestException exception)
            {
                printf("TRACE|THROW_EXPR|EXPECTED_CATCH|code={0}\n", exception.Code);
                accumulator += exception.Code;
            }

            // Unsafe/pointer/function-pointer tests.
            int unsafeResult = UnsafeTests.Run(33);
            accumulator += unsafeResult;
            printf("TRACE|UNSAFE|CHECK|result={0}|acc={1}\n", unsafeResult, accumulator);

            // Monster nesting for scope, branch, loop and switch tracking.
            int megaNestResult = RunMegaNest(accumulator & 63);
            accumulator ^= megaNestResult;
            printf("TRACE|MEGA_NEST|CHECK|result={0}|acc={1}\n", megaNestResult, accumulator);

            // Miscellaneous expression forms: default literals, conditional, null coalescing, nameof, target typing.
            int defaultInt = default;
            TestStruct defaultStruct = default;
            string nameOfValue = nameof(intValue);
            int conditionalValue = boolTrue ? 111 : 222;
            int targetTypedConditional = boolTrue ? (byte)3 : (short)4;
            printf("TRACE|MISC|EXPRESSIONS|defaultInt={0}|defaultStructX={1}|nameof={2}|conditional={3}|targetConditional={4}\n", defaultInt, defaultStruct.X, nameOfValue, conditionalValue, targetTypedConditional);

            ExtendedNameofAttribute(444);

            // Static/volatile fields.
            StaticMutable += 10;
            VolatileValue = StaticMutable + StaticReadonly;
            printf("TRACE|STATIC|FIELDS|readonly={0}|mutable={1}|volatile={2}\n", StaticReadonly, StaticMutable, VolatileValue);

            printf("TRACE|PROGRAM|MAIN|FINAL|accumulator={0}\n", accumulator);
            printf("TRACE|PROGRAM|MAIN|END|return=0\n");
            return 0;
        }
    }

    #endregion
}
#else
#error COMPILER_MEGA_FIXTURE must be defined
#endif
