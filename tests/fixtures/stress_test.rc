#nullable enable
#define COMPILER_MEGA_FIXTURE

#if COMPILER_MEGA_FIXTURE
namespace CompilerCoreCSharp11MegaStress
{
    /*
     * Positive compiler/runtime stress fixture for C# language features through C# 11.
     *
     * Output format:
     *   TRACE|<category>|<test-id>|<event>|key=value|...
     *   FINALIZER|<type>|<id>|...
     *
     * TRACE records are intended to be deterministic.
     * FINALIZER records are intentionally separate because standard C# does not
     * guarantee finalizer execution at lexical scope exit or finalizer ordering.
     *
     * There are deliberately no using directives in this fixture.
     */

    #region Core enums and declarations

    /// <summary>Primary signed enum used by switch, generic and conversion tests.</summary>
    public enum TestEnum : int
    {
        Zero = 0,
        One = 1,
        Two = 2,
        Three = 3,
        Four = 4,
        Negative = -1
    }

    /// <summary>Byte-backed enum used to test non-default enum underlying types.</summary>
    public enum TestByteEnum : byte
    {
        Zero = 0,
        Low = 1,
        Medium = 127,
        High = 255
    }

    public enum TestLongEnum : long
    {
        Negative = -9000000000000L,
        Zero = 0L,
        Positive = 9000000000000L
    }

    [GenericMarker<int>("generic-attribute-type")]
    [GenericPairMarker<int, string>("generic-attribute-pair")]
    [NameMarker("annotated-base")]
    public class GenericMarkerTarget
    {
        public int Value;
    }

    public sealed class GenericMarkerAttribute<T> : System.Attribute
    {
        public string Name;

        public GenericMarkerAttribute(string name)
        {
            Name = name;
            printf("TRACE|ATTR|GENERIC_MARKER|CTOR|name={0}\n", name);
        }
    }

