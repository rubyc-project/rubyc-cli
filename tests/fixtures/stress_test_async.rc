        public static int RunLanguageFeaturesOnWorkerThread()
        {
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|event=BEGIN");
            int score = 0;

            int? nullable = null;
            nullable ??= 10;
            score += nullable.Value;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=NullableCoalesceAssign|event=RESULT|value={0}", nullable.Value);

            WorkPayload payload = new WorkPayload(1510, "language-worker");
            int? nullConditional = payload?.PublicValue;
            WorkPayload nullPayload = null;
            int nullFallback = nullPayload?.PublicValue ?? -1;
            score += nullConditional ?? 0;
            score += nullFallback;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=NullConditional|event=RESULT|value={0}|fallback={1}", nullConditional, nullFallback);

            (int Left, string Text, long Right) tuple = (11, "tuple", 12L);
            (int tupleLeft, string tupleText, long tupleRight) = tuple;
            score += tupleLeft + (int)tupleRight + tupleText.Length;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=TupleDeconstruct|event=RESULT|left={0}|text={1}|right={2}", tupleLeft, tupleText, tupleRight);

            int[] rangeValues = new int[] { 1, 2, 3, 4, 5, 6 };
            int fromEnd = rangeValues[^2];
            int[] slice = rangeValues[1..^1];
            score += fromEnd + slice.Length;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=IndexRange|event=RESULT|fromEnd={0}|sliceLength={1}", fromEnd, slice.Length);

            var anonymous = new { Id = 13, Name = "anonymous" };
            score += anonymous.Id + anonymous.Name.Length;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=AnonymousType|event=RESULT|id={0}|name={1}", anonymous.Id, anonymous.Name);

            IDefaultThreadBehavior defaultBehavior = new DefaultThreadBehavior();
            int defaultInterfaceResult = defaultBehavior.Compute(14);
            score += defaultInterfaceResult;

            CovariantFactoryBase covariantFactory = new CovariantFactoryDerived();
            WorkPayload covariantPayload = covariantFactory.Create();
            score += covariantPayload.PublicValue;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=CovariantReturn|event=RESULT|public={0}", covariantPayload.PublicValue);

            int extensionResult = 15.ThreadDouble();
            score += extensionResult;

            PartialThreadType partial = new PartialThreadType();
            score += partial.First + partial.Second;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=PartialType|event=RESULT|first={0}|second={1}", partial.First, partial.Second);

            int optionalResult = OptionalParamsProbe(first: 16, rest: new int[] { 1, 2, 3 });
            score += optionalResult;

            int iteratorSum = 0;
            foreach (int value in SynchronousIterator(20, 3)) iteratorSum += value;
            score += iteratorSum;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=Iterator|event=RESULT|sum={0}", iteratorSum);

            CallerExpressionProbe((score & 1) == (score % 2));
            int handlerScore = ConsumeInterpolatedHandler($"worker {score} payload {payload.PublicValue}");
            score += handlerScore;

            var naturalLambda = (int value) => value + 1;
            var explicitReturnLambda = int (int value) => value + 2;
            System.Func<int, int, int> discardLambda = (int _, int _) => 17;
            score += naturalLambda(18);
            score += explicitReturnLambda(19);
            score += discardLambda(1, 2);
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=LambdaImprovements|event=RESULT|score={0}", score);

            dynamic dynamicPayload = payload;
            int dynamicRead = dynamicPayload.PublicValue;
            score += dynamicRead;
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=DynamicMember|event=RESULT|value={0}", dynamicRead);

            string interpolated = $"score={score}|name={nameof(score)}";
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=InterpolationNameof|event=RESULT|text={0}", interpolated);
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|event=END|score={0}", score);
            return score;
        }

        public static async System.Threading.Tasks.Task RunAsyncEventTests()
        {
            printf("TRACE|order=ORDERED|area=ASYNC_EVENT|test=All|event=BEGIN");
            AsyncEventSource source = new AsyncEventSource();
            System.Threading.CountdownEvent completed = new System.Threading.CountdownEvent(2);
            int result = 0;
            source.Work += async id =>
            {
                printf("CONCURRENT|order=UNORDERED|area=ASYNC_EVENT|test=Handler1|event=BEGIN|id={0}", id);
                await System.Threading.Tasks.Task.Yield();
                System.Threading.Interlocked.Add(ref result, id);
                printf("CONCURRENT|order=UNORDERED|area=ASYNC_EVENT|test=Handler1|event=END|id={0}", id);
                completed.Signal();
            };
            source.Work += async id =>
            {
                printf("CONCURRENT|order=UNORDERED|area=ASYNC_EVENT|test=Handler2|event=BEGIN|id={0}", id);
                await System.Threading.Tasks.Task.Delay(1);
                System.Threading.Interlocked.Add(ref result, id * 2);
                printf("CONCURRENT|order=UNORDERED|area=ASYNC_EVENT|test=Handler2|event=END|id={0}", id);
                completed.Signal();
            };
            source.Raise(70);
            bool signaled = completed.Wait(5000);
            printf("TRACE|order=ORDERED|area=ASYNC_EVENT|test=All|event=RESULT|signaled={0}|result={1}|expected=210", signaled, result);
            completed.Dispose();
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=ASYNC_EVENT|test=All|event=END");
        }

        // Direct Thread creation, parameter passing, Join, Interrupt, Yield and spinning.
        public static async System.Threading.Tasks.Task RunThreadPrimitiveTests()
        {
            printf("TRACE|order=ORDERED|area=THREAD|test=Primitives|event=BEGIN");
            SharedCounter = 0;
            System.Threading.Thread basicThread = new System.Threading.Thread(BasicThreadWorker);
            basicThread.Name = "basic-worker";
            printf("TRACE|order=ORDERED|area=THREAD|test=ThreadStart|event=CREATED|name={0}|background={1}", basicThread.Name, basicThread.IsBackground);
            basicThread.Start();
            bool basicJoined = basicThread.Join(5000);
            printf("TRACE|order=ORDERED|area=THREAD|test=ThreadStart|event=JOINED|joined={0}|shared={1}", basicJoined, SharedCounter);

            System.Threading.Thread parameterThread = new System.Threading.Thread(ParameterizedThreadWorker);
            parameterThread.IsBackground = true;
            printf("TRACE|order=ORDERED|area=THREAD|test=ParameterizedThreadStart|event=CREATED|background={0}", parameterThread.IsBackground);
            parameterThread.Start(7);
            bool parameterJoined = parameterThread.Join(5000);
            printf("TRACE|order=ORDERED|area=THREAD|test=ParameterizedThreadStart|event=JOINED|joined={0}|shared={1}", parameterJoined, SharedCounter);

            System.Threading.Thread interruptedThread = new System.Threading.Thread(InterruptedThreadWorker);
            interruptedThread.Start();
            System.Threading.Thread.Sleep(20);
            printf("TRACE|order=ORDERED|area=THREAD_INTERRUPT|event=INTERRUPT_REQUEST");
            interruptedThread.Interrupt();
            bool interruptedJoined = interruptedThread.Join(5000);
            printf("TRACE|order=ORDERED|area=THREAD_INTERRUPT|event=JOINED|joined={0}", interruptedJoined);

            int[] threadStaticResults = new int[2];
            System.Threading.Thread threadStaticA = new System.Threading.Thread(() =>
            {
                GenericThreadStaticState<string>.PerThreadCount = 201;
                threadStaticResults[0] = GenericThreadStaticState<string>.PerThreadCount;
                printf("THREAD|order=UNORDERED|area=THREAD_STATIC|event=SET|logicalId=201|value={0}", threadStaticResults[0]);
            });
            System.Threading.Thread threadStaticB = new System.Threading.Thread(() =>
            {
                GenericThreadStaticState<string>.PerThreadCount = 202;
                threadStaticResults[1] = GenericThreadStaticState<string>.PerThreadCount;
                printf("THREAD|order=UNORDERED|area=THREAD_STATIC|event=SET|logicalId=202|value={0}", threadStaticResults[1]);
            });
            threadStaticA.Start();
            threadStaticB.Start();
            threadStaticA.Join(5000);
            threadStaticB.Join(5000);
            printf("TRACE|order=ORDERED|area=THREAD_STATIC|event=RESULT|workerA={0}|workerB={1}|main={2}", threadStaticResults[0], threadStaticResults[1], GenericThreadStaticState<string>.PerThreadCount);

            bool yieldResult = System.Threading.Thread.Yield();
            printf("TRACE|order=ORDERED|area=THREAD|test=Yield|event=RESULT|value={0}", yieldResult);
            int workerAvailable;
            int ioAvailable;
            int workerMin;
            int ioMin;
            int workerMax;
            int ioMax;
            System.Threading.ThreadPool.GetAvailableThreads(out workerAvailable, out ioAvailable);
            System.Threading.ThreadPool.GetMinThreads(out workerMin, out ioMin);
            System.Threading.ThreadPool.GetMaxThreads(out workerMax, out ioMax);
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=Stats|event=VALUES|workerAvailable={0}|ioAvailable={1}|workerMin={2}|ioMin={3}|workerMax={4}|ioMax={5}", workerAvailable, ioAvailable, workerMin, ioMin, workerMax, ioMax);
            System.Threading.Thread.SpinWait(100);
            printf("TRACE|order=ORDERED|area=THREAD|test=StaticSpinWait|event=COMPLETE");
            System.Threading.SpinWait spinWait = new System.Threading.SpinWait();
            for (int index = 0; index < 5; index++)
            {
                spinWait.SpinOnce();
                printf("TRACE|order=ORDERED|area=THREAD|test=SpinWait|event=SPIN|index={0}|nextYield={1}", index, spinWait.NextSpinWillYield);
            }
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=THREAD|test=Primitives|event=END|shared={0}", SharedCounter);
        }

        // Mutual exclusion and monitor condition-variable behavior.
        public static async System.Threading.Tasks.Task RunLockAndMonitorTests()
        {
            printf("TRACE|order=ORDERED|area=LOCK|test=LockMonitor|event=BEGIN");
            SharedCounter = 0;
            System.Threading.Thread[] workers = new System.Threading.Thread[4];
            for (int index = 0; index < workers.Length; index++)
            {
                int logicalId = index + 1;
                workers[index] = new System.Threading.Thread(LockedIncrementWorker);
                workers[index].Start(logicalId);
            }
            for (int index = 0; index < workers.Length; index++)
            {
                bool joined = workers[index].Join(5000);
                printf("TRACE|order=ORDERED|area=LOCK|test=LockedIncrement|event=JOIN|logicalId={0}|joined={1}", index + 1, joined);
            }
            printf("TRACE|order=ORDERED|area=LOCK|test=LockedIncrement|event=RESULT|shared={0}|expected=80", SharedCounter);

            bool lockTaken = false;
            try
            {
                System.Threading.Monitor.Enter(SecondaryLock, ref lockTaken);
                printf("TRACE|order=ORDERED|area=MONITOR|test=EnterExit|event=ENTER|taken={0}", lockTaken);
                bool reentrant = System.Threading.Monitor.TryEnter(SecondaryLock);
                printf("TRACE|order=ORDERED|area=MONITOR|test=EnterExit|event=TRY_REENTER|taken={0}", reentrant);
                if (reentrant)
                {
                    System.Threading.Monitor.Exit(SecondaryLock);
                    printf("TRACE|order=ORDERED|area=MONITOR|test=EnterExit|event=EXIT_REENTER");
                }
            }
            finally
            {
                if (lockTaken)
                {
                    System.Threading.Monitor.Exit(SecondaryLock);
                    printf("TRACE|order=ORDERED|area=MONITOR|test=EnterExit|event=EXIT");
                }
            }

            MonitorReady = false;
            MonitorValue = 0;
            System.Threading.Thread consumer = new System.Threading.Thread(MonitorConsumer);
            System.Threading.Thread producer = new System.Threading.Thread(MonitorProducer);
            consumer.Start();
            System.Threading.Thread.Sleep(10);
            producer.Start();
            bool consumerJoined = consumer.Join(5000);
            bool producerJoined = producer.Join(5000);
            printf("TRACE|order=ORDERED|area=MONITOR|test=WaitPulse|event=JOINED|consumer={0}|producer={1}|ready={2}|value={3}", consumerJoined, producerJoined, MonitorReady, MonitorValue);

            try
            {
                lock (SecondaryLock)
                {
                    printf("TRACE|order=ORDERED|area=LOCK|test=ExceptionRelease|event=LOCKED");
                    throw new ThreadStressException(9001);
                }
            }
            catch (ThreadStressException exception)
            {
                printf("TRACE|order=ORDERED|area=LOCK|test=ExceptionRelease|event=CAUGHT|code={0}", exception.Code);
            }
            bool acquiredAfterException = System.Threading.Monitor.TryEnter(SecondaryLock, 1000);
            printf("TRACE|order=ORDERED|area=LOCK|test=ExceptionRelease|event=TRY_AFTER_EXCEPTION|acquired={0}", acquiredAfterException);
            if (acquiredAfterException) System.Threading.Monitor.Exit(SecondaryLock);
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=LOCK|test=LockMonitor|event=END");
        }

        // Atomic read/modify/write operations and volatile memory visibility.
        public static async System.Threading.Tasks.Task RunAtomicAndVolatileTests()
        {
            printf("TRACE|order=ORDERED|area=ATOMIC|test=InterlockedVolatile|event=BEGIN");
            SharedCounter = 0;
            SharedLongCounter = 0L;
            int exchangeTarget = 10;
            int oldExchange = System.Threading.Interlocked.Exchange(ref exchangeTarget, 20);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=ExchangeInt|event=RESULT|old={0}|new={1}", oldExchange, exchangeTarget);
            int compareTarget = 30;
            int compareOld1 = System.Threading.Interlocked.CompareExchange(ref compareTarget, 40, 30);
            int compareOld2 = System.Threading.Interlocked.CompareExchange(ref compareTarget, 50, 30);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=CompareExchangeInt|event=RESULT|old1={0}|old2={1}|new={2}", compareOld1, compareOld2, compareTarget);
            int increment = System.Threading.Interlocked.Increment(ref SharedCounter);
            int decrement = System.Threading.Interlocked.Decrement(ref SharedCounter);
            int add = System.Threading.Interlocked.Add(ref SharedCounter, 5);
            long longAdd = System.Threading.Interlocked.Add(ref SharedLongCounter, 100L);
            long interlockedRead = System.Threading.Interlocked.Read(ref SharedLongCounter);
            System.Threading.Thread.MemoryBarrier();
            System.Threading.Interlocked.MemoryBarrier();
            printf("TRACE|order=ORDERED|area=ATOMIC|test=IncDecAdd|event=RESULT|inc={0}|dec={1}|add={2}|longAdd={3}|read={4}", increment, decrement, add, longAdd, interlockedRead);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=MemoryBarrier|event=COMPLETE");
            object objectTarget = (object)"first";
            object oldObject = System.Threading.Interlocked.Exchange(ref objectTarget, (object)"second");
            object compareObject = System.Threading.Interlocked.CompareExchange(ref objectTarget, (object)"third", (object)"second");
            printf("TRACE|order=ORDERED|area=ATOMIC|test=ObjectExchange|event=RESULT|old={0}|compareOld={1}|new={2}", oldObject, compareObject, objectTarget);
            VolatileBool = false;
            VolatileByte = (byte)1;
            VolatileSByte = (sbyte)-2;
            VolatileShort = (short)-3;
            VolatileUShort = (ushort)4;
            VolatileInt = 0;
            VolatileUInt = 5U;
            VolatileChar = 'V';
            VolatileFloat = 6.5f;
            VolatileMode = WorkerMode.Signal;
            VolatileReference = new WorkPayload(77, "volatile");
            System.Threading.Volatile.Write(ref VolatileInt, 123);
            System.Threading.Volatile.Write(ref VolatileBool, true);
            int volatileRead = System.Threading.Volatile.Read(ref VolatileInt);
            bool volatileBoolRead = System.Threading.Volatile.Read(ref VolatileBool);
            WorkPayload volatileReferenceRead = System.Threading.Volatile.Read(ref VolatileReference);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=Volatile|event=RESULT|bool={0}|byte={1}|sbyte={2}|short={3}|ushort={4}|int={5}|uint={6}|char={7}|float={8}|mode={9}|refPublic={10}", VolatileBool, VolatileByte, VolatileSByte, VolatileShort, VolatileUShort, volatileRead, VolatileUInt, VolatileChar, VolatileFloat, (int)VolatileMode, volatileReferenceRead.PublicValue);

            SharedCounter = 0;
            System.Threading.Tasks.Task[] tasks = new System.Threading.Tasks.Task[8];
            for (int worker = 0; worker < tasks.Length; worker++)
            {
                int logicalId = worker;
                tasks[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    for (int index = 0; index < 100; index++) System.Threading.Interlocked.Increment(ref SharedCounter);
                    printf("CONCURRENT|order=UNORDERED|area=ATOMIC|test=ParallelInterlocked|event=WORKER_END|logicalId={0}", logicalId);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(tasks);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=ParallelInterlocked|event=RESULT|shared={0}|expected=800", SharedCounter);
            printf("TRACE|order=ORDERED|area=ATOMIC|test=InterlockedVolatile|event=END");
        }

        // Event, semaphore, countdown, barrier and mutex synchronization.
        public static async System.Threading.Tasks.Task RunSynchronizationPrimitiveTests()
        {
            printf("TRACE|order=ORDERED|area=SYNC_PRIMITIVE|test=All|event=BEGIN");
            System.Threading.ManualResetEvent manual = new System.Threading.ManualResetEvent(false);
            System.Threading.AutoResetEvent auto = new System.Threading.AutoResetEvent(false);
            System.Threading.ManualResetEventSlim manualSlim = new System.Threading.ManualResetEventSlim(false);
            System.Threading.Semaphore semaphore = new System.Threading.Semaphore(0, 2);
            System.Threading.SemaphoreSlim semaphoreSlim = new System.Threading.SemaphoreSlim(0, 2);
            System.Threading.CountdownEvent countdown = new System.Threading.CountdownEvent(3);
            System.Threading.Barrier barrier = new System.Threading.Barrier(3, b => printf("CONCURRENT|order=UNORDERED|area=BARRIER|event=POST_PHASE|phase={0}", b.CurrentPhaseNumber));
            System.Threading.Mutex mutex = new System.Threading.Mutex(false);

            System.Threading.Tasks.Task manualWaiter = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=ManualResetEvent|event=WAIT_BEGIN|logicalId=1");
                manual.WaitOne();
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=ManualResetEvent|event=WAIT_END|logicalId=1");
            });
            System.Threading.Tasks.Task autoWaiter = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=AutoResetEvent|event=WAIT_BEGIN|logicalId=2");
                auto.WaitOne();
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=AutoResetEvent|event=WAIT_END|logicalId=2");
            });
            System.Threading.Tasks.Task slimWaiter = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=ManualResetEventSlim|event=WAIT_BEGIN|logicalId=3");
                manualSlim.Wait();
                printf("CONCURRENT|order=UNORDERED|area=EVENT|test=ManualResetEventSlim|event=WAIT_END|logicalId=3");
            });
            await System.Threading.Tasks.Task.Delay(5);
            manual.Set();
            auto.Set();
            manualSlim.Set();
            printf("TRACE|order=ORDERED|area=EVENT|test=Signals|event=SET_ALL");
            await System.Threading.Tasks.Task.WhenAll(manualWaiter, autoWaiter, slimWaiter);
            manual.Reset();
            manualSlim.Reset();
            printf("TRACE|order=ORDERED|area=EVENT|test=Reset|event=RESET_MANUALS");

            System.Threading.Tasks.Task semaphoreWaiter = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=SEMAPHORE|test=Semaphore|event=WAIT_BEGIN|logicalId=4");
                semaphore.WaitOne();
                printf("CONCURRENT|order=UNORDERED|area=SEMAPHORE|test=Semaphore|event=WAIT_END|logicalId=4");
            });
            System.Threading.Tasks.Task semaphoreSlimWaiter = System.Threading.Tasks.Task.Run(async () =>
            {
                printf("CONCURRENT|order=UNORDERED|area=SEMAPHORE|test=SemaphoreSlim|event=WAIT_BEGIN|logicalId=5");
                await semaphoreSlim.WaitAsync();
                printf("CONCURRENT|order=UNORDERED|area=SEMAPHORE|test=SemaphoreSlim|event=WAIT_END|logicalId=5");
            });
            await System.Threading.Tasks.Task.Delay(5);
            int previousSemaphore = semaphore.Release();
            int previousSlim = semaphoreSlim.Release();
            printf("TRACE|order=ORDERED|area=SEMAPHORE|test=Release|event=RESULT|previousSemaphore={0}|previousSlim={1}", previousSemaphore, previousSlim);
            await System.Threading.Tasks.Task.WhenAll(semaphoreWaiter, semaphoreSlimWaiter);
            bool slimTimedOut = await semaphoreSlim.WaitAsync(2);
            printf("TRACE|order=ORDERED|area=SEMAPHORE|test=SemaphoreSlimTimeout|event=RESULT|acquired={0}", slimTimedOut);
            semaphoreSlim.Release();
            bool slimAcquired = await semaphoreSlim.WaitAsync(1000);
            printf("TRACE|order=ORDERED|area=SEMAPHORE|test=SemaphoreSlimTimedWait|event=RESULT|acquired={0}|current={1}", slimAcquired, semaphoreSlim.CurrentCount);
            System.Threading.CancellationTokenSource slimCts = new System.Threading.CancellationTokenSource();
            System.Threading.Tasks.Task slimCancelWait = semaphoreSlim.WaitAsync(slimCts.Token);
            slimCts.Cancel();
            try
            {
                await slimCancelWait;
            }
            catch (System.OperationCanceledException)
            {
                printf("TRACE|order=ORDERED|area=SEMAPHORE|test=SemaphoreSlimCancellation|event=CAUGHT");
            }
            slimCts.Dispose();

            System.Threading.Tasks.Task[] countdownTasks = new System.Threading.Tasks.Task[3];
            for (int worker = 0; worker < 3; worker++)
            {
                int logicalId = worker;
                countdownTasks[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    printf("CONCURRENT|order=UNORDERED|area=COUNTDOWN|event=SIGNAL|logicalId={0}", logicalId);
                    countdown.Signal();
                });
            }
            countdown.Wait();
            await System.Threading.Tasks.Task.WhenAll(countdownTasks);
            printf("TRACE|order=ORDERED|area=COUNTDOWN|event=COMPLETE|count={0}|isSet={1}", countdown.CurrentCount, countdown.IsSet);

            System.Threading.Tasks.Task[] barrierTasks = new System.Threading.Tasks.Task[3];
            for (int worker = 0; worker < 3; worker++)
            {
                int logicalId = worker;
                barrierTasks[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    printf("CONCURRENT|order=UNORDERED|area=BARRIER|event=BEFORE|logicalId={0}", logicalId);
                    barrier.SignalAndWait();
                    printf("CONCURRENT|order=UNORDERED|area=BARRIER|event=AFTER|logicalId={0}", logicalId);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(barrierTasks);
            printf("TRACE|order=ORDERED|area=BARRIER|event=COMPLETE|phase={0}", barrier.CurrentPhaseNumber);

            bool mutexTaken = mutex.WaitOne(1000);
            printf("TRACE|order=ORDERED|area=MUTEX|event=WAIT|taken={0}", mutexTaken);
            if (mutexTaken)
            {
                mutex.ReleaseMutex();
                printf("TRACE|order=ORDERED|area=MUTEX|event=RELEASE");
            }

            System.Threading.Mutex abandonedMutex = new System.Threading.Mutex(false);
            System.Threading.Thread abandoner = new System.Threading.Thread(() =>
            {
                abandonedMutex.WaitOne();
                printf("CONCURRENT|order=UNORDERED|area=MUTEX|test=Abandoned|event=ACQUIRED_AND_EXITING");
            });
            abandoner.Start();
            abandoner.Join(5000);
            try
            {
                bool abandonedTaken = abandonedMutex.WaitOne(1000);
                printf("TRACE|order=ORDERED|area=MUTEX|test=Abandoned|event=WAIT_RETURNED|taken={0}", abandonedTaken);
                if (abandonedTaken) abandonedMutex.ReleaseMutex();
            }
            catch (System.Threading.AbandonedMutexException)
            {
                printf("TRACE|order=ORDERED|area=MUTEX|test=Abandoned|event=CAUGHT");
                abandonedMutex.ReleaseMutex();
            }
            abandonedMutex.Dispose();

            System.Threading.ManualResetEvent waitA = new System.Threading.ManualResetEvent(true);
            System.Threading.ManualResetEvent waitB = new System.Threading.ManualResetEvent(true);
            System.Threading.WaitHandle[] waitHandles = new System.Threading.WaitHandle[] { waitA, waitB };
            int waitAnyIndex = System.Threading.WaitHandle.WaitAny(waitHandles, 1000);
            bool waitAllResult = System.Threading.WaitHandle.WaitAll(waitHandles, 1000);
            printf("TRACE|order=ORDERED|area=WAIT_HANDLE|test=WaitAnyWaitAll|event=RESULT|anyIndex={0}|all={1}", waitAnyIndex, waitAllResult);
            waitA.Dispose();
            waitB.Dispose();

            System.Threading.AutoResetEvent signalSource = new System.Threading.AutoResetEvent(false);
            System.Threading.AutoResetEvent signalReply = new System.Threading.AutoResetEvent(false);
            System.Threading.Tasks.Task signalWorker = System.Threading.Tasks.Task.Run(() =>
            {
                signalSource.WaitOne();
                printf("CONCURRENT|order=UNORDERED|area=WAIT_HANDLE|test=SignalAndWait|event=WORKER_SIGNAL_REPLY");
                signalReply.Set();
            });
            bool signalAndWaitResult = System.Threading.WaitHandle.SignalAndWait(signalSource, signalReply, 1000, false);
            await signalWorker;
            printf("TRACE|order=ORDERED|area=WAIT_HANDLE|test=SignalAndWait|event=RESULT|value={0}", signalAndWaitResult);
            signalSource.Dispose();
            signalReply.Dispose();

            System.Threading.ManualResetEvent registeredEvent = new System.Threading.ManualResetEvent(false);
            System.Threading.ManualResetEventSlim registeredDone = new System.Threading.ManualResetEventSlim(false);
            System.Threading.RegisteredWaitHandle registered = System.Threading.ThreadPool.RegisterWaitForSingleObject(registeredEvent, (state, timedOut) =>
            {
                printf("CONCURRENT|order=UNORDERED|area=WAIT_HANDLE|test=RegisteredWait|event=CALLBACK|timedOut={0}", timedOut);
                registeredDone.Set();
            }, null, 1000, true);
            registeredEvent.Set();
            bool registeredCompleted = registeredDone.Wait(5000);
            bool unregisterResult = registered.Unregister(null);
            printf("TRACE|order=ORDERED|area=WAIT_HANDLE|test=RegisteredWait|event=RESULT|completed={0}|unregister={1}", registeredCompleted, unregisterResult);
            registeredEvent.Dispose();
            registeredDone.Dispose();

            manual.Dispose();
            auto.Dispose();
            manualSlim.Dispose();
            semaphore.Dispose();
            semaphoreSlim.Dispose();
            countdown.Dispose();
            barrier.Dispose();
            mutex.Dispose();
            printf("TRACE|order=ORDERED|area=SYNC_PRIMITIVE|test=All|event=END");
        }

        // Reader/writer and spin-lock paths use different acquisition APIs.
        public static async System.Threading.Tasks.Task RunAdvancedLockTests()
        {
            printf("TRACE|order=ORDERED|area=ADV_LOCK|test=All|event=BEGIN");
            System.Threading.ReaderWriterLockSlim rw = new System.Threading.ReaderWriterLockSlim(System.Threading.LockRecursionPolicy.SupportsRecursion);
            int value = 0;
            rw.EnterWriteLock();
            try
            {
                value = 10;
                printf("TRACE|order=ORDERED|area=RWLOCK|event=WRITE|value={0}|writeHeld={1}", value, rw.IsWriteLockHeld);
            }
            finally { rw.ExitWriteLock(); }
            rw.EnterReadLock();
            try
            {
                printf("TRACE|order=ORDERED|area=RWLOCK|event=READ|value={0}|readHeld={1}", value, rw.IsReadLockHeld);
            }
            finally { rw.ExitReadLock(); }
            bool tryRead = rw.TryEnterReadLock(1000);
            printf("TRACE|order=ORDERED|area=RWLOCK|event=TRY_READ|acquired={0}", tryRead);
            if (tryRead) rw.ExitReadLock();
            bool tryWrite = rw.TryEnterWriteLock(1000);
            printf("TRACE|order=ORDERED|area=RWLOCK|event=TRY_WRITE|acquired={0}", tryWrite);
            if (tryWrite) rw.ExitWriteLock();
            bool tryUpgradeable = rw.TryEnterUpgradeableReadLock(1000);
            printf("TRACE|order=ORDERED|area=RWLOCK|event=TRY_UPGRADEABLE|acquired={0}", tryUpgradeable);
            if (tryUpgradeable) rw.ExitUpgradeableReadLock();

            rw.EnterUpgradeableReadLock();
            try
            {
                printf("TRACE|order=ORDERED|area=RWLOCK|event=UPGRADEABLE|value={0}", value);
                rw.EnterWriteLock();
                try
                {
                    value += 5;
                    printf("TRACE|order=ORDERED|area=RWLOCK|event=UPGRADED_WRITE|value={0}", value);
                }
                finally { rw.ExitWriteLock(); }
            }
            finally { rw.ExitUpgradeableReadLock(); }
            rw.Dispose();

            System.Threading.SpinLock spinLock = new System.Threading.SpinLock(true);
            bool lockTaken = false;
            try
            {
                spinLock.Enter(ref lockTaken);
                value += 2;
                printf("TRACE|order=ORDERED|area=SPINLOCK|event=ENTER|taken={0}|value={1}|tracking={2}", lockTaken, value, spinLock.IsThreadOwnerTrackingEnabled);
            }
            finally
            {
                if (lockTaken)
                {
                    spinLock.Exit();
                    printf("TRACE|order=ORDERED|area=SPINLOCK|event=EXIT");
                }
            }
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=ADV_LOCK|test=All|event=END|value={0}", value);
        }

        // Task creation, composition, continuations and blocking observation.
        public static async System.Threading.Tasks.Task RunTaskApiTests()
        {
            printf("TRACE|order=ORDERED|area=TASK_API|test=All|event=BEGIN");
            System.Threading.Tasks.Task<int> fromResult = System.Threading.Tasks.Task.FromResult(123);
            int fromResultValue = await fromResult;
            printf("TRACE|order=ORDERED|area=TASK_API|test=FromResult|event=RESULT|value={0}|status={1}", fromResultValue, (int)fromResult.Status);
            await System.Threading.Tasks.Task.CompletedTask;
            printf("TRACE|order=ORDERED|area=TASK_API|test=CompletedTask|event=AWAITED");

            System.Threading.Tasks.Task<int> runTask = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=Run|event=BODY|logicalId=1");
                return 321;
            });
            int runValue = await runTask;
            printf("TRACE|order=ORDERED|area=TASK_API|test=Run|event=RESULT|value={0}", runValue);

            System.Threading.Tasks.Task<int> startNew = System.Threading.Tasks.Task.Factory.StartNew(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=StartNew|event=BODY|logicalId=2");
                return 654;
            });
            int startNewValue = await startNew;
            printf("TRACE|order=ORDERED|area=TASK_API|test=StartNew|event=RESULT|value={0}", startNewValue);

            System.Threading.Tasks.Task<int> continuation = runTask.ContinueWith(previous =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=ContinueWith|event=BODY|previous={0}", previous.Result);
                return previous.Result + 1;
            });
            int continuationValue = await continuation;
            printf("TRACE|order=ORDERED|area=TASK_API|test=ContinueWith|event=RESULT|value={0}", continuationValue);

            System.Threading.Tasks.Task<int>[] many = new System.Threading.Tasks.Task<int>[5];
            for (int index = 0; index < many.Length; index++)
            {
                int logicalId = index;
                many[index] = DelayedEchoAsync(logicalId, index * 10);
            }
            System.Threading.Tasks.Task<int[]> allTask = System.Threading.Tasks.Task.WhenAll(many);
            System.Threading.Tasks.Task<int> firstTask = await System.Threading.Tasks.Task.WhenAny(many);
            printf("TRACE|order=ORDERED|area=TASK_API|test=WhenAny|event=COMPLETE|firstResult={0}", await firstTask);
            int[] allValues = await allTask;
            int allSum = 0;
            for (int index = 0; index < allValues.Length; index++)
            {
                allSum += allValues[index];
                printf("TRACE|order=ORDERED|area=TASK_API|test=WhenAll|event=VALUE|index={0}|value={1}", index, allValues[index]);
            }
            printf("TRACE|order=ORDERED|area=TASK_API|test=WhenAll|event=SUM|value={0}", allSum);

            System.Threading.Tasks.TaskCompletionSource<int> tcs = new System.Threading.Tasks.TaskCompletionSource<int>(System.Threading.Tasks.TaskCreationOptions.RunContinuationsAsynchronously);
            System.Threading.Tasks.Task setter = System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=TCS|event=SET|logicalId=3");
                tcs.SetResult(777);
            });
            int tcsValue = await tcs.Task;
            await setter;
            printf("TRACE|order=ORDERED|area=TASK_API|test=TCS|event=RESULT|value={0}", tcsValue);

            System.Threading.Tasks.Task longRunning = System.Threading.Tasks.Task.Factory.StartNew(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=LongRunning|event=BODY|logicalId=4");
            }, System.Threading.CancellationToken.None, System.Threading.Tasks.TaskCreationOptions.LongRunning, System.Threading.Tasks.TaskScheduler.Default);
            await longRunning;
            printf("TRACE|order=ORDERED|area=TASK_API|test=LongRunning|event=COMPLETE");

            System.Threading.Tasks.Task waitTask1 = System.Threading.Tasks.Task.Delay(1);
            System.Threading.Tasks.Task waitTask2 = System.Threading.Tasks.Task.Delay(2);
            int waitAnyTaskIndex = System.Threading.Tasks.Task.WaitAny(new System.Threading.Tasks.Task[] { waitTask1, waitTask2 }, 5000);
            bool waitAllTasks = System.Threading.Tasks.Task.WaitAll(new System.Threading.Tasks.Task[] { waitTask1, waitTask2 }, 5000);
            printf("TRACE|order=ORDERED|area=TASK_API|test=WaitAnyWaitAll|event=RESULT|anyIndex={0}|all={1}", waitAnyTaskIndex, waitAllTasks);

            System.Threading.Tasks.Task<System.Threading.Tasks.Task<int>> nestedTask = System.Threading.Tasks.Task.Factory.StartNew(async () =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=NestedTask|event=BEGIN|currentId={0}", System.Threading.Tasks.Task.CurrentId);
                await System.Threading.Tasks.Task.Yield();
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=NestedTask|event=END|currentId={0}", System.Threading.Tasks.Task.CurrentId);
                return 889;
            });
            System.Threading.Tasks.Task<int> unwrapped = System.Threading.Tasks.TaskExtensions.Unwrap(nestedTask);
            int unwrappedResult = await unwrapped;
            printf("TRACE|order=ORDERED|area=TASK_API|test=Unwrap|event=RESULT|value={0}", unwrappedResult);

            int attachedValue = 0;
            System.Threading.Tasks.Task parent = System.Threading.Tasks.Task.Factory.StartNew(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=AttachedChild|event=PARENT_BEGIN|currentId={0}", System.Threading.Tasks.Task.CurrentId);
                System.Threading.Tasks.Task.Factory.StartNew(() =>
                {
                    attachedValue = 890;
                    printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=AttachedChild|event=CHILD|value={0}|currentId={1}", attachedValue, System.Threading.Tasks.Task.CurrentId);
                }, System.Threading.CancellationToken.None, System.Threading.Tasks.TaskCreationOptions.AttachedToParent, System.Threading.Tasks.TaskScheduler.Current);
                printf("CONCURRENT|order=UNORDERED|area=TASK_API|test=AttachedChild|event=PARENT_BODY_END|currentId={0}", System.Threading.Tasks.Task.CurrentId);
            });
            await parent;
            printf("TRACE|order=ORDERED|area=TASK_API|test=AttachedChild|event=RESULT|value={0}|parentStatus={1}", attachedValue, (int)parent.Status);
            printf("TRACE|order=ORDERED|area=TASK_API|test=Scheduler|event=INFO|defaultEqualsCurrent={0}", System.Threading.Tasks.TaskScheduler.Default == System.Threading.Tasks.TaskScheduler.Current);

            System.Threading.Tasks.Task<int> fromException = System.Threading.Tasks.Task.FromException<int>(new ThreadStressException(891));
            try { await fromException; }
            catch (ThreadStressException exception) { printf("TRACE|order=ORDERED|area=TASK_API|test=FromException|event=CAUGHT|code={0}|faulted={1}", exception.Code, fromException.IsFaulted); }
            System.Threading.CancellationTokenSource canceledSource = new System.Threading.CancellationTokenSource();
            canceledSource.Cancel();
            System.Threading.Tasks.Task<int> fromCanceled = System.Threading.Tasks.Task.FromCanceled<int>(canceledSource.Token);
            try { await fromCanceled; }
            catch (System.OperationCanceledException) { printf("TRACE|order=ORDERED|area=TASK_API|test=FromCanceled|event=CAUGHT|canceled={0}", fromCanceled.IsCanceled); }
            canceledSource.Dispose();

            System.Threading.Tasks.Task<int> blockingTask = System.Threading.Tasks.Task.FromResult(888);
            int resultProperty = blockingTask.Result;
            blockingTask.Wait();
            int awaiterResult = blockingTask.GetAwaiter().GetResult();
            printf("TRACE|order=ORDERED|area=TASK_API|test=Blocking|event=RESULT|property={0}|awaiter={1}", resultProperty, awaiterResult);
            printf("TRACE|order=ORDERED|area=TASK_API|test=All|event=END");
        }

        // Fault and cancellation paths deliberately throw and propagate exceptions.
        public static async System.Threading.Tasks.Task RunTaskExceptionAndCancellationTests()
        {
            printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=All|event=BEGIN");
            try
            {
                await ThrowAfterAwaitAsync(1001);
            }
            catch (ThreadStressException exception)
            {
                printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=AwaitThrowAfter|event=CAUGHT|code={0}", exception.Code);
            }
            try
            {
                await ThrowBeforeFirstAwaitAsync(1002);
            }
            catch (DerivedThreadStressException exception)
            {
                printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=AwaitThrowBefore|event=CAUGHT|code={0}", exception.Code);
            }
            int tryResult1 = await AsyncTryCatchFinally(3, false);
            int tryResult2 = await AsyncTryCatchFinally(4, true);
            printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=TryCatchFinally|event=RESULT|normal={0}|thrown={1}", tryResult1, tryResult2);

            System.Threading.Tasks.Task faulted = ThrowAfterAwaitAsync(2001);
            try
            {
                faulted.Wait();
            }
            catch (System.AggregateException aggregate)
            {
                printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=WaitAggregate|event=CAUGHT|innerCount={0}", aggregate.InnerExceptions.Count);
            }

            System.Threading.Tasks.Task<int>[] faultTasks = new System.Threading.Tasks.Task<int>[3];
            faultTasks[0] = ThrowAfterAwaitAsync(2101);
            faultTasks[1] = ThrowAfterAwaitAsync(2102);
            faultTasks[2] = ThrowAfterAwaitAsync(2103);
            System.Threading.Tasks.Task<int[]> allFaults = System.Threading.Tasks.Task.WhenAll(faultTasks);
            try
            {
                await allFaults;
            }
            catch (ThreadStressException exception)
            {
                int innerCount = allFaults.Exception == null ? 0 : allFaults.Exception.InnerExceptions.Count;
                printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=WhenAllFaults|event=CAUGHT|code={0}|aggregateCount={1}", exception.Code, innerCount);
            }

            System.Threading.CancellationTokenSource cts = new System.Threading.CancellationTokenSource();
            int callbackCount = 0;
            System.Threading.CancellationTokenRegistration registration = cts.Token.Register(() =>
            {
                System.Threading.Interlocked.Increment(ref callbackCount);
                printf("CONCURRENT|order=UNORDERED|area=CANCELLATION|test=Registration|event=CALLBACK|count={0}", callbackCount);
            });
            System.Threading.Tasks.Task<int> cancellable = CancellableWorkerAsync(3001, cts.Token);
            await System.Threading.Tasks.Task.Delay(3);
            cts.Cancel();
            try
            {
                await cancellable;
            }
            catch (System.OperationCanceledException exception)
            {
                printf("TRACE|order=ORDERED|area=CANCELLATION|test=Cancel|event=CAUGHT|requested={0}|callbackCount={1}", exception.CancellationToken.IsCancellationRequested, callbackCount);
            }
            registration.Dispose();
            cts.Dispose();

            System.Threading.CancellationTokenSource linkedA = new System.Threading.CancellationTokenSource();
            System.Threading.CancellationTokenSource linkedB = new System.Threading.CancellationTokenSource();
            System.Threading.CancellationTokenSource linked = System.Threading.CancellationTokenSource.CreateLinkedTokenSource(linkedA.Token, linkedB.Token);
            linkedB.Cancel();
            printf("TRACE|order=ORDERED|area=CANCELLATION|test=Linked|event=RESULT|linked={0}|a={1}|b={2}", linked.IsCancellationRequested, linkedA.IsCancellationRequested, linkedB.IsCancellationRequested);
            linked.Dispose();
            linkedA.Dispose();
            linkedB.Dispose();
            printf("TRACE|order=ORDERED|area=TASK_EXCEPTION|test=All|event=END");
        }

        // Thread-pool work items and timer callbacks execute on pool threads.
        public static async System.Threading.Tasks.Task RunThreadPoolAndTimerTests()
        {
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=All|event=BEGIN");
            System.Threading.ManualResetEventSlim poolDone = new System.Threading.ManualResetEventSlim(false);
            int poolValue = 0;
            bool queued = System.Threading.ThreadPool.QueueUserWorkItem(state =>
            {
                int value = (int)state;
                poolValue = value * 2;
                printf("CONCURRENT|order=UNORDERED|area=THREADPOOL|test=QueueUserWorkItem|event=BODY|value={0}|result={1}", value, poolValue);
                poolDone.Set();
            }, 12);
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=QueueUserWorkItem|event=QUEUED|result={0}", queued);
            poolDone.Wait();
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=QueueUserWorkItem|event=COMPLETE|poolValue={0}", poolValue);

            System.Threading.ManualResetEventSlim unsafeDone = new System.Threading.ManualResetEventSlim(false);
            System.Threading.ThreadPool.UnsafeQueueUserWorkItem(state =>
            {
                printf("CONCURRENT|order=UNORDERED|area=THREADPOOL|test=UnsafeQueueUserWorkItem|event=BODY|state={0}", state);
                unsafeDone.Set();
            }, 13);
            unsafeDone.Wait();
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=UnsafeQueueUserWorkItem|event=COMPLETE");

            int timerCount = 0;
            System.Threading.ManualResetEventSlim timerDone = new System.Threading.ManualResetEventSlim(false);
            System.Threading.Timer timer = new System.Threading.Timer(_ =>
            {
                int current = System.Threading.Interlocked.Increment(ref timerCount);
                printf("CONCURRENT|order=UNORDERED|area=TIMER|event=TICK|count={0}", current);
                if (current >= 3) timerDone.Set();
            }, null, 1, 2);
            timerDone.Wait(5000);
            timer.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            timer.Dispose();
            printf("TRACE|order=ORDERED|area=TIMER|event=COMPLETE|count={0}", timerCount);
            poolDone.Dispose();
            unsafeDone.Dispose();
            timerDone.Dispose();
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=THREADPOOL|test=All|event=END");
        }

        // Parallel loops and concurrent containers exercise contention-heavy library paths.
        public static async System.Threading.Tasks.Task RunParallelAndConcurrentCollectionTests()
        {
            printf("TRACE|order=ORDERED|area=PARALLEL|test=All|event=BEGIN");
            int parallelSum = 0;
            System.Threading.Tasks.Parallel.For(0, 20, index =>
            {
                System.Threading.Interlocked.Add(ref parallelSum, index);
                if (index % 7 == 0) printf("CONCURRENT|order=UNORDERED|area=PARALLEL|test=For|event=ITERATION|index={0}", index);
            });
            printf("TRACE|order=ORDERED|area=PARALLEL|test=For|event=RESULT|sum={0}|expected=190", parallelSum);
            System.Threading.Tasks.ParallelLoopResult breakResult = System.Threading.Tasks.Parallel.For(0, 100, (index, state) =>
            {
                if (index == 10) state.Break();
            });
            long lowestBreak = breakResult.LowestBreakIteration.HasValue ? breakResult.LowestBreakIteration.Value : -1L;
            printf("TRACE|order=ORDERED|area=PARALLEL|test=Break|event=RESULT|completed={0}|lowestBreak={1}", breakResult.IsCompleted, lowestBreak);
            System.Threading.Tasks.ParallelLoopResult stopResult = System.Threading.Tasks.Parallel.For(0, 100, (index, state) =>
            {
                if (index == 10) state.Stop();
            });
            printf("TRACE|order=ORDERED|area=PARALLEL|test=Stop|event=RESULT|completed={0}", stopResult.IsCompleted);

            int[] parallelValues = new int[] { 1, 2, 3, 4, 5, 6 };
            int forEachSum = 0;
            System.Threading.Tasks.Parallel.ForEach(parallelValues, value =>
            {
                System.Threading.Interlocked.Add(ref forEachSum, value * 2);
            });
            printf("TRACE|order=ORDERED|area=PARALLEL|test=ForEach|event=RESULT|sum={0}|expected=42", forEachSum);

            int invokeCount = 0;
            System.Threading.Tasks.Parallel.Invoke(
                () => { System.Threading.Interlocked.Increment(ref invokeCount); printf("CONCURRENT|order=UNORDERED|area=PARALLEL|test=Invoke|event=ACTION|logicalId=1"); },
                () => { System.Threading.Interlocked.Increment(ref invokeCount); printf("CONCURRENT|order=UNORDERED|area=PARALLEL|test=Invoke|event=ACTION|logicalId=2"); },
                () => { System.Threading.Interlocked.Increment(ref invokeCount); printf("CONCURRENT|order=UNORDERED|area=PARALLEL|test=Invoke|event=ACTION|logicalId=3"); }
            );
            printf("TRACE|order=ORDERED|area=PARALLEL|test=Invoke|event=RESULT|count={0}|expected=3", invokeCount);

            System.Collections.Concurrent.ConcurrentQueue<int> queue = new System.Collections.Concurrent.ConcurrentQueue<int>();
            System.Collections.Concurrent.ConcurrentStack<int> stack = new System.Collections.Concurrent.ConcurrentStack<int>();
            System.Collections.Concurrent.ConcurrentBag<int> bag = new System.Collections.Concurrent.ConcurrentBag<int>();
            System.Collections.Concurrent.ConcurrentDictionary<int, int> dictionary = new System.Collections.Concurrent.ConcurrentDictionary<int, int>();
            System.Threading.Tasks.Task[] collectionWorkers = new System.Threading.Tasks.Task[4];
            for (int worker = 0; worker < collectionWorkers.Length; worker++)
            {
                int logicalId = worker;
                collectionWorkers[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    for (int index = 0; index < 10; index++)
                    {
                        int value = logicalId * 100 + index;
                        queue.Enqueue(value);
                        stack.Push(value);
                        bag.Add(value);
                        dictionary[value] = value * 2;
                    }
                    printf("CONCURRENT|order=UNORDERED|area=CONCURRENT_COLLECTION|event=WORKER_END|logicalId={0}", logicalId);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(collectionWorkers);
            int queueCount = 0;
            int queueValue;
            while (queue.TryDequeue(out queueValue)) queueCount++;
            int stackCount = 0;
            int stackValue;
            while (stack.TryPop(out stackValue)) stackCount++;
            int bagCount = 0;
            int bagValue;
            while (bag.TryTake(out bagValue)) bagCount++;
            int getOrAdd = dictionary.GetOrAdd(999, key => key * 2);
            int addOrUpdate = dictionary.AddOrUpdate(999, key => key * 2, (key, oldValue) => oldValue + 1);
            int removedValue;
            bool removed = dictionary.TryRemove(999, out removedValue);
            printf("TRACE|order=ORDERED|area=CONCURRENT_COLLECTION|event=DICTIONARY_OPS|getOrAdd={0}|addOrUpdate={1}|removed={2}|removedValue={3}", getOrAdd, addOrUpdate, removed, removedValue);
            printf("TRACE|order=ORDERED|area=CONCURRENT_COLLECTION|event=COUNTS|queue={0}|stack={1}|bag={2}|dictionary={3}", queueCount, stackCount, bagCount, dictionary.Count);

            System.Collections.Concurrent.BlockingCollection<int> blocking = new System.Collections.Concurrent.BlockingCollection<int>(4);
            int blockingSum = 0;
            System.Threading.Tasks.Task blockingProducer = System.Threading.Tasks.Task.Run(() =>
            {
                for (int index = 1; index <= 6; index++)
                {
                    blocking.Add(index);
                    printf("CONCURRENT|order=UNORDERED|area=BLOCKING_COLLECTION|event=ADD|value={0}", index);
                }
                blocking.CompleteAdding();
                printf("CONCURRENT|order=UNORDERED|area=BLOCKING_COLLECTION|event=COMPLETE_ADDING");
            });
            System.Threading.Tasks.Task blockingConsumer = System.Threading.Tasks.Task.Run(() =>
            {
                foreach (int value in blocking.GetConsumingEnumerable())
                {
                    blockingSum += value;
                    printf("CONCURRENT|order=UNORDERED|area=BLOCKING_COLLECTION|event=TAKE|value={0}", value);
                }
            });
            await System.Threading.Tasks.Task.WhenAll(blockingProducer, blockingConsumer);
            printf("TRACE|order=ORDERED|area=BLOCKING_COLLECTION|event=RESULT|sum={0}|expected=21|completed={1}", blockingSum, blocking.IsAddingCompleted);
            blocking.Dispose();
            printf("TRACE|order=ORDERED|area=PARALLEL|test=All|event=END");
        }

        // ExecutionContext, AsyncLocal, ThreadLocal and SynchronizationContext flow.
        public static async System.Threading.Tasks.Task RunContextFlowTests()
        {
            printf("TRACE|order=ORDERED|area=CONTEXT|test=All|event=BEGIN");
            AsyncLocalValue.Value = 1234;
            ThreadLocalValue.Value = 5678;
            printf("TRACE|order=ORDERED|area=CONTEXT|test=Initial|event=VALUES|asyncLocal={0}|threadLocal={1}", AsyncLocalValue.Value, ThreadLocalValue.Value);
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=CONTEXT|test=AfterAwait|event=VALUES|asyncLocal={0}|threadLocal={1}", AsyncLocalValue.Value, ThreadLocalValue.Value);
            int flowed = await System.Threading.Tasks.Task.Run(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=CONTEXT|test=TaskRunFlow|event=VALUE|asyncLocal={0}", AsyncLocalValue.Value);
                return AsyncLocalValue.Value;
            });
            printf("TRACE|order=ORDERED|area=CONTEXT|test=TaskRunFlow|event=RESULT|value={0}", flowed);

            System.Threading.Tasks.Task<int> suppressedTask;
            using (System.Threading.ExecutionContext.SuppressFlow())
            {
                suppressedTask = System.Threading.Tasks.Task.Run(() =>
                {
                    printf("CONCURRENT|order=UNORDERED|area=CONTEXT|test=SuppressedFlow|event=VALUE|asyncLocal={0}", AsyncLocalValue.Value);
                    return AsyncLocalValue.Value;
                });
            }
            int suppressed = await suppressedTask;
            printf("TRACE|order=ORDERED|area=CONTEXT|test=SuppressedFlow|event=RESULT|value={0}", suppressed);

            System.Threading.ExecutionContext capturedContext = System.Threading.ExecutionContext.Capture();
            int executionRunValue = 0;
            System.Threading.ExecutionContext.Run(capturedContext, _ =>
            {
                executionRunValue = AsyncLocalValue.Value;
                printf("TRACE|order=ORDERED|area=CONTEXT|test=ExecutionContextRun|event=BODY|value={0}", executionRunValue);
            }, null);
            printf("TRACE|order=ORDERED|area=CONTEXT|test=ExecutionContextRun|event=RESULT|value={0}", executionRunValue);

            ProbeSynchronizationContext context = new ProbeSynchronizationContext();
            System.Threading.SynchronizationContext previous = System.Threading.SynchronizationContext.Current;
            System.Threading.SynchronizationContext.SetSynchronizationContext(context);
            context.Send(_ => printf("TRACE|order=ORDERED|area=SYNC_CONTEXT|test=Send|event=CALLBACK"), null);
            try
            {
                printf("TRACE|order=ORDERED|area=SYNC_CONTEXT|test=Capture|event=BEFORE_AWAIT");
                await System.Threading.Tasks.Task.Delay(1);
                printf("TRACE|order=ORDERED|area=SYNC_CONTEXT|test=Capture|event=AFTER_AWAIT|postCount={0}", context.PostCount);
                await System.Threading.Tasks.Task.Delay(1).ConfigureAwait(false);
                printf("TRACE|order=ORDERED|area=SYNC_CONTEXT|test=ConfigureAwaitFalse|event=AFTER_AWAIT|postCount={0}", context.PostCount);
            }
            finally
            {
                System.Threading.SynchronizationContext.SetSynchronizationContext(previous);
            }
            System.Lazy<WorkPayload> lazyPayload = new System.Lazy<WorkPayload>(() =>
            {
                printf("CONCURRENT|order=UNORDERED|area=LAZY|event=FACTORY");
                return new WorkPayload(1300, "lazy");
            }, System.Threading.LazyThreadSafetyMode.ExecutionAndPublication);
            System.Threading.Tasks.Task[] lazyTasks = new System.Threading.Tasks.Task[4];
            for (int index = 0; index < lazyTasks.Length; index++)
            {
                int logicalId = index;
                lazyTasks[index] = System.Threading.Tasks.Task.Run(() =>
                {
                    int publicValue = lazyPayload.Value.PublicValue;
                    printf("CONCURRENT|order=UNORDERED|area=LAZY|event=READ|logicalId={0}|public={1}", logicalId, publicValue);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(lazyTasks);
            printf("TRACE|order=ORDERED|area=LAZY|event=RESULT|created={0}|public={1}", lazyPayload.IsValueCreated, lazyPayload.Value.PublicValue);
            printf("TRACE|order=ORDERED|area=CONTEXT|test=All|event=END");
        }

        public static int RunCSharp11SynchronousThreadHelper()
        {
            printf("TRACE|order=ORDERED|area=CS11|test=SynchronousHelper|event=BEGIN");
            string raw = """async|raw|string""";
            System.ReadOnlySpan<byte> utf8 = "async-u8"u8;
            int rawPattern = raw switch { "async|raw|string" => 1, _ => 0 };
            int shift = -1024;
            int unsignedShift = shift >>> 3;
            shift >>>= 2;
            printf("TRACE|order=ORDERED|area=CS11|test=RawUtf8|event=RESULT|rawPattern={0}|utf8Length={1}", rawPattern, utf8.Length);
            printf("TRACE|order=ORDERED|area=CS11|test=UnsignedShift|event=RESULT|first={0}|compound={1}", unsignedShift, shift);
            printf("TRACE|order=ORDERED|area=CS11|test=SynchronousHelper|event=END");
            return rawPattern + utf8.Length + unsignedShift + shift;
        }

