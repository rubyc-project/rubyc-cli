        public static async System.Collections.Generic.IAsyncEnumerable<int> GenerateAsyncSequence(int start, int count)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateAsyncSequence|event=BEGIN|start={0}|count={1}", start, count);
            for (int index = 0; index < count; index++)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateAsyncSequence|event=BEFORE_AWAIT|index={0}", index);
                await System.Threading.Tasks.Task.Yield();
                int value = start + index;
                printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateAsyncSequence|event=YIELD|index={0}|value={1}", index, value);
                yield return value;
            }
            printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateAsyncSequence|event=END");
        }

        public static async System.Collections.Generic.IAsyncEnumerable<int> GenerateCancellableAsyncSequence(
            int start,
            int count,
            [System.Runtime.CompilerServices.EnumeratorCancellationAttribute] System.Threading.CancellationToken token = default)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateCancellable|event=BEGIN|start={0}|count={1}", start, count);
            for (int index = 0; index < count; index++)
            {
                token.ThrowIfCancellationRequested();
                await System.Threading.Tasks.Task.Delay(1, token);
                int value = start + index;
                printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateCancellable|event=YIELD|index={0}|value={1}", index, value);
                yield return value;
            }
            printf("TRACE|order=ORDERED|area=ASYNC_STREAM|test=GenerateCancellable|event=END");
        }

        public static async System.Threading.Tasks.Task<int> ThrowAfterAwaitAsync(int code)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=ThrowAfterAwaitAsync|event=BEGIN|code={0}", code);
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=ThrowAfterAwaitAsync|event=THROW|code={0}", code);
            throw new ThreadStressException(code);
        }

        public static async System.Threading.Tasks.Task<int> ThrowBeforeFirstAwaitAsync(int code)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=ThrowBeforeFirstAwaitAsync|event=BEGIN|code={0}", code);
            if (code > 0)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=ThrowBeforeFirstAwaitAsync|event=THROW_BEFORE_AWAIT|code={0}", code);
                throw new DerivedThreadStressException(code);
            }
            await System.Threading.Tasks.Task.Yield();
            return code;
        }

        public static async System.Threading.Tasks.Task<int> AsyncTryCatchFinally(int id, bool throwInside)
        {
            int value = id;
            printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=BEGIN|id={0}|throw={1}", id, throwInside);
            try
            {
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=TRY_BEFORE_AWAIT|id={0}", id);
                await System.Threading.Tasks.Task.Yield();
                value += 10;
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=TRY_AFTER_AWAIT|id={0}|value={1}", id, value);
                if (throwInside)
                {
                    printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=THROW|id={0}", id);
                    throw new ThreadStressException(id);
                }
            }
            catch (ThreadStressException exception) when (exception.Code == id && id >= 0)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=CATCH_FILTER_TRUE|id={0}|code={1}", id, exception.Code);
                await System.Threading.Tasks.Task.Yield();
                value += 100;
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=CATCH_AFTER_AWAIT|id={0}|value={1}", id, value);
            }
            finally
            {
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=FINALLY_BEFORE_AWAIT|id={0}|value={1}", id, value);
                await System.Threading.Tasks.Task.Yield();
                value += 1000;
                printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=FINALLY_AFTER_AWAIT|id={0}|value={1}", id, value);
            }
            printf("TRACE|order=ORDERED|area=ASYNC_EXCEPTION|test=AsyncTryCatchFinally|event=END|id={0}|value={1}", id, value);
            return value;
        }

        public static async System.Threading.Tasks.Task<int> CancellableWorkerAsync(int id, System.Threading.CancellationToken token)
        {
            printf("TRACE|order=ORDERED|area=CANCELLATION|test=CancellableWorkerAsync|event=BEGIN|id={0}", id);
            int total = 0;
            for (int index = 0; index < 10; index++)
            {
                printf("TRACE|order=ORDERED|area=CANCELLATION|test=CancellableWorkerAsync|event=CHECK|id={0}|index={1}", id, index);
                token.ThrowIfCancellationRequested();
                await System.Threading.Tasks.Task.Delay(1, token);
                total += index;
                printf("TRACE|order=ORDERED|area=CANCELLATION|test=CancellableWorkerAsync|event=ITERATION|id={0}|index={1}|total={2}", id, index, total);
            }
            printf("TRACE|order=ORDERED|area=CANCELLATION|test=CancellableWorkerAsync|event=END|id={0}|total={1}", id, total);
            return total;
        }

        public static async System.Threading.Tasks.Task<T> DelayedEchoAsync<T>(int logicalId, T value)
        {
            printf("ASYNC|order=UNORDERED|area=ECHO|event=BEGIN|logicalId={0}", logicalId);
            await System.Threading.Tasks.Task.Delay((logicalId % 3) + 1).ConfigureAwait(false);
            printf("ASYNC|order=UNORDERED|area=ECHO|event=END|logicalId={0}", logicalId);
            return value;
        }

