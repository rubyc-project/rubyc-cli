    public class GenericMarkerAttribute<T> : System.Attribute
    {
    }

    public interface IAsyncNumber<TSelf> where TSelf : IAsyncNumber<TSelf>
    {
        static abstract TSelf Zero { get; }
        static abstract TSelf operator +(TSelf left, TSelf right);
        static abstract TSelf operator -(TSelf left, TSelf right);
        static abstract TSelf operator *(TSelf left, TSelf right);
    }

    public readonly struct AsyncNumber : IAsyncNumber<AsyncNumber>
    {
        public readonly int Value;
        public AsyncNumber(int value) { Value = value; }
        public static AsyncNumber Zero => new AsyncNumber(0);
        public static AsyncNumber operator +(AsyncNumber left, AsyncNumber right) => new AsyncNumber(left.Value + right.Value);
        public static AsyncNumber operator -(AsyncNumber left, AsyncNumber right) => new AsyncNumber(left.Value - right.Value);
        public static AsyncNumber operator *(AsyncNumber left, AsyncNumber right) => new AsyncNumber(left.Value * right.Value);
    }

    /// <summary>An awaitable that always completes synchronously.</summary>
    public readonly struct ImmediateAwaitable<T>
    {
        private readonly T _value;
        public ImmediateAwaitable(T value) { _value = value; }
        public ImmediateAwaiter<T> GetAwaiter() => new ImmediateAwaiter<T>(_value);
    }

    public readonly struct ImmediateAwaiter<T> : System.Runtime.CompilerServices.INotifyCompletion
    {
        private readonly T _value;
        public ImmediateAwaiter(T value) { _value = value; }
        public bool IsCompleted => true;
        public T GetResult() => _value;
        public void OnCompleted(System.Action continuation) { continuation(); }
    }

    /// <summary>An awaitable that completes asynchronously on the thread pool.</summary>
    public readonly struct ThreadPoolAwaitable<T>
    {
        private readonly T _value;
        public ThreadPoolAwaitable(T value) { _value = value; }
        public ThreadPoolAwaiter<T> GetAwaiter() => new ThreadPoolAwaiter<T>(_value);
    }

    public readonly struct ThreadPoolAwaiter<T> : System.Runtime.CompilerServices.ICriticalNotifyCompletion
    {
        private readonly T _value;
        public ThreadPoolAwaiter(T value) { _value = value; }
        public bool IsCompleted => false;
        public T GetResult() => _value;
        public void OnCompleted(System.Action continuation)
        {
            System.Threading.ThreadPool.QueueUserWorkItem(_ => continuation());
        }
        public void UnsafeOnCompleted(System.Action continuation)
        {
            System.Threading.ThreadPool.UnsafeQueueUserWorkItem(_ => continuation(), null);
        }
    }

    [System.Runtime.CompilerServices.AsyncMethodBuilder(typeof(CustomTaskMethodBuilder<>))]
    public readonly struct CustomTask<T>
    {
        private readonly System.Threading.Tasks.Task<T> _task;
        public CustomTask(System.Threading.Tasks.Task<T> task) { _task = task; }
        public System.Runtime.CompilerServices.TaskAwaiter<T> GetAwaiter() => _task.GetAwaiter();
    }

    public struct CustomTaskMethodBuilder<T>
    {
        private System.Runtime.CompilerServices.AsyncTaskMethodBuilder<T> _builder;
        public static CustomTaskMethodBuilder<T> Create()
        {
            CustomTaskMethodBuilder<T> result = new CustomTaskMethodBuilder<T>();
            result._builder = System.Runtime.CompilerServices.AsyncTaskMethodBuilder<T>.Create();
            return result;
        }
        public CustomTask<T> Task => new CustomTask<T>(_builder.Task);
        public void SetResult(T result) { _builder.SetResult(result); }
        public void SetException(System.Exception exception) { _builder.SetException(exception); }
        public void SetStateMachine(System.Runtime.CompilerServices.IAsyncStateMachine stateMachine) { _builder.SetStateMachine(stateMachine); }
        public void Start<TStateMachine>(ref TStateMachine stateMachine) where TStateMachine : System.Runtime.CompilerServices.IAsyncStateMachine { _builder.Start(ref stateMachine); }
        public void AwaitOnCompleted<TAwaiter, TStateMachine>(ref TAwaiter awaiter, ref TStateMachine stateMachine) where TAwaiter : System.Runtime.CompilerServices.INotifyCompletion where TStateMachine : System.Runtime.CompilerServices.IAsyncStateMachine { _builder.AwaitOnCompleted(ref awaiter, ref stateMachine); }
        public void AwaitUnsafeOnCompleted<TAwaiter, TStateMachine>(ref TAwaiter awaiter, ref TStateMachine stateMachine) where TAwaiter : System.Runtime.CompilerServices.ICriticalNotifyCompletion where TStateMachine : System.Runtime.CompilerServices.IAsyncStateMachine { _builder.AwaitUnsafeOnCompleted(ref awaiter, ref stateMachine); }
    }

    public sealed class AsyncDisposableProbe : System.IAsyncDisposable, System.IDisposable
    {
        public int Id;
        public AsyncDisposableProbe(int id)
        {
            Id = id;
            printf("TRACE|order=ORDERED|area=ASYNC_DISPOSE|test=Probe|event=CTOR|id={0}", Id);
        }
        public void Dispose()
        {
            printf("TRACE|order=ORDERED|area=ASYNC_DISPOSE|test=Probe|event=DISPOSE_SYNC|id={0}", Id);
        }
        public async System.Threading.Tasks.ValueTask DisposeAsync()
        {
            printf("TRACE|order=ORDERED|area=ASYNC_DISPOSE|test=Probe|event=DISPOSE_ASYNC_BEGIN|id={0}", Id);
            await System.Threading.Tasks.Task.Yield();
            printf("TRACE|order=ORDERED|area=ASYNC_DISPOSE|test=Probe|event=DISPOSE_ASYNC_END|id={0}", Id);
        }
    }

    public sealed class ProbeSynchronizationContext : System.Threading.SynchronizationContext
    {
        public int PostCount;
        public int SendCount;

        public override void Post(System.Threading.SendOrPostCallback callback, object state)
        {
            System.Threading.Interlocked.Increment(ref PostCount);
            printf("CONCURRENT|order=UNORDERED|area=SYNC_CONTEXT|event=POST|count={0}", PostCount);
            System.Threading.ThreadPool.QueueUserWorkItem(_ =>
            {
                System.Threading.SynchronizationContext previous = System.Threading.SynchronizationContext.Current;
                System.Threading.SynchronizationContext.SetSynchronizationContext(this);
                try { callback(state); }
                finally { System.Threading.SynchronizationContext.SetSynchronizationContext(previous); }
            });
        }

        public override void Send(System.Threading.SendOrPostCallback callback, object state)
        {
            System.Threading.Interlocked.Increment(ref SendCount);
            printf("TRACE|order=ORDERED|area=SYNC_CONTEXT|event=SEND|count={0}", SendCount);
            callback(state);
        }
    }

