        public static int RunCSharp11LowLevelThreadHelper()
        {
            printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|event=BEGIN");
            AutoDefaultStruct autoDefault = new AutoDefaultStruct(1401);
            printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|test=AutoDefaultStruct|event=RESULT|assigned={0}|defaulted={1}", autoDefault.Assigned, autoDefault.AutoDefaulted);

            int refTarget = 1402;
            RefFieldHolder holder = new RefFieldHolder(ref refTarget);
            ref int holderReference = ref holder.Value;
            holderReference += 10;
            printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|test=RefField|event=RESULT|target={0}|refValue={1}", refTarget, holderReference);

            CheckedNumber checkedLeft = new CheckedNumber(100);
            CheckedNumber checkedRight = new CheckedNumber(200);
            CheckedNumber uncheckedResult = unchecked(checkedLeft + checkedRight);
            CheckedNumber checkedResult = checked(checkedLeft + checkedRight);
            printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|test=CheckedOperator|event=RESULT|unchecked={0}|checked={1}", uncheckedResult.Value, checkedResult.Value);
            try
            {
                CheckedNumber overflow = checked(new CheckedNumber(int.MaxValue) + new CheckedNumber(1));
                printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|test=CheckedOperatorOverflow|event=UNEXPECTED|value={0}", overflow.Value);
            }
            catch (System.OverflowException)
            {
                printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|test=CheckedOperatorOverflow|event=CAUGHT");
            }

            var naturalMethodGroup = UnsafeFunctionPointerTarget;
            int naturalMethodGroupResult = naturalMethodGroup(1403);
            printf("TRACE|order=ORDERED|area=CS10|test=NaturalMethodGroup|event=RESULT|value={0}", naturalMethodGroupResult);
            printf("TRACE|order=ORDERED|area=CS11_LOW_LEVEL|event=END");
            return autoDefault.Assigned + autoDefault.AutoDefaulted + refTarget + checkedResult.Value + naturalMethodGroupResult;
        }

        // Async language lowering: custom awaiters, ValueTask, dynamic await, streams and disposal.
        [GenericMarkerAttribute<string>]
        public static async System.Threading.Tasks.Task RunAsyncLanguageFeatureTests()
        {
            printf("TRACE|order=ORDERED|area=ASYNC_LANGUAGE|test=All|event=BEGIN");
            int languageWorkerResult = await System.Threading.Tasks.Task.Run(() => RunLanguageFeaturesOnWorkerThread());
            printf("TRACE|order=ORDERED|area=ASYNC_LANGUAGE|test=LanguageWorker|event=RESULT|value={0}", languageWorkerResult);
            int awaitConditionResult = await RunAwaitInConditionTests();
            printf("TRACE|order=ORDERED|area=ASYNC_LANGUAGE|test=AwaitConditions|event=RESULT|value={0}", awaitConditionResult);
            WorkPayload newConstraintClass = await AsyncCreateWithNew<WorkPayload>();
            SmallValue newConstraintStruct = await AsyncCreateWithNew<SmallValue>();
            int constrainedStruct = await AsyncStructConstraint(123);
            string constrainedClass = await AsyncClassConstraint("constraint-class");
            long constrainedUnmanaged = await AsyncUnmanagedConstraint(456L);
            string constrainedNotNull = await AsyncNotNullConstraint("not-null");
