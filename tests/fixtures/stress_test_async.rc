/*
 * C# 1 through C# 11 asynchronous and threading compiler stress fixture.
 * No using directives are present. All framework types are fully qualified.
 * TRACE records are intended to be deterministic. CONCURRENT and FINALIZER
 * records may arrive in scheduler-dependent order and carry stable logical IDs.
 */
namespace CompilerAsyncThreadStressTest
{
    /// <summary>Modes used by threaded switch and pattern tests.</summary>
    public enum WorkerMode : int
    {
        None = 0,
        Compute = 1,
        Wait = 2,
        Signal = 3,
        Fault = 4,
        Cancel = 5,
        Complete = 6
    }

    /// <summary>Small value type used by generic and inter-thread transfer tests.</summary>
    public struct SmallValue
    {
        public int Id;
        public long Value;

        public SmallValue(int id, long value)
        {
            Id = id;
            Value = value;
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=SmallValue|event=CTOR|id={0}|value={1}", Id, Value);
        }
    }

    public readonly struct ReadonlySmallValue
    {
        public readonly int Id;
        public readonly double Value;

        public ReadonlySmallValue(int id, double value)
        {
            Id = id;
            Value = value;
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=ReadonlySmallValue|event=CTOR|id={0}|value={1}", Id, Value);
        }
    }

    public struct AutoDefaultStruct
    {
        public int Assigned;
        public int AutoDefaulted;

        public AutoDefaultStruct(int assigned)
        {
            Assigned = assigned;
            // C# 11 automatically initializes AutoDefaulted when this constructor omits it.
        }
    }

    public ref struct RefFieldHolder
    {
        private ref int _value;

        public RefFieldHolder(ref int value)
        {
            _value = ref value;
        }

        public ref int Value => ref _value;
    }

    public readonly struct CheckedNumber
    {
        public readonly int Value;
        public CheckedNumber(int value) { Value = value; }
        public static CheckedNumber operator +(CheckedNumber left, CheckedNumber right) => new CheckedNumber(left.Value + right.Value);
        public static CheckedNumber operator checked +(CheckedNumber left, CheckedNumber right) => new CheckedNumber(checked(left.Value + right.Value));
    }

    public record ThreadRecord(int Id, string Name);
    public readonly record struct ThreadRecordStruct(int Id, long Value);

    public class WorkPayload
    {
        private int _privateValue;
        protected int ProtectedValue;
        public int PublicValue;
        public string Name;

        public WorkPayload() : this(0, 0, 0, "default")
        {
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=WorkPayload|event=CTOR_DEFAULT|public={0}", PublicValue);
        }

        public WorkPayload(int publicValue, string name) : this(publicValue + 100, publicValue + 10, publicValue, name)
        {
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=WorkPayload|event=CTOR_PUBLIC|public={0}|name={1}", PublicValue, Name);
        }

        protected WorkPayload(int privateValue, int protectedValue, int publicValue, string name)
        {
            _privateValue = privateValue;
            ProtectedValue = protectedValue;
            PublicValue = publicValue;
            Name = name;
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=WorkPayload|event=CTOR_PROTECTED|private={0}|protected={1}|public={2}|name={3}", _privateValue, ProtectedValue, PublicValue, Name);
        }

        private int ReadPrivate()
        {
            printf("TRACE|order=ORDERED|area=ACCESS|test=WorkPayload|event=PRIVATE_METHOD|value={0}", _privateValue);
            return _privateValue;
        }

        protected int ReadProtected()
        {
            printf("TRACE|order=ORDERED|area=ACCESS|test=WorkPayload|event=PROTECTED_METHOD|value={0}", ProtectedValue);
            return ProtectedValue;
        }

        public int ReadAll()
        {
            int result = ReadPrivate() + ReadProtected() + PublicValue;
            printf("TRACE|order=ORDERED|area=ACCESS|test=WorkPayload|event=PUBLIC_METHOD|result={0}", result);
            return result;
        }

        ~WorkPayload()
        {
            printf("FINALIZER|order=UNORDERED|type=WorkPayload|name={0}|public={1}", Name, PublicValue);
        }
    }

    public class DerivedWorkPayload : WorkPayload
    {
        public int DerivedValue;

        public DerivedWorkPayload(int baseValue, int derivedValue, string name) : base(baseValue + 1000, baseValue + 100, baseValue, name)
        {
            DerivedValue = derivedValue;
            printf("TRACE|order=ORDERED|area=LIFECYCLE|test=DerivedWorkPayload|event=CTOR|basePublic={0}|derived={1}|name={2}", PublicValue, DerivedValue, Name);
        }

        public int ReadProtectedFromDerived()
        {
            int result = ProtectedValue;
            printf("TRACE|order=ORDERED|area=ACCESS|test=DerivedWorkPayload|event=READ_PROTECTED|value={0}", result);
            return result;
        }

        ~DerivedWorkPayload()
        {
            printf("FINALIZER|order=UNORDERED|type=DerivedWorkPayload|name={0}|derived={1}", Name, DerivedValue);
        }
    }

