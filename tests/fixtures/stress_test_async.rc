            while (value)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=bool|loop=WHILE|event=ITERATION|count={0}", count);
                await System.Threading.Tasks.Task.Yield();
                value = false;
                count++;
            }
            bool doValue = true;
            do
            {
                printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=bool|loop=DO_WHILE|event=ITERATION|count={0}", count);
                await System.Threading.Tasks.Task.Yield();
                doValue = false;
                count++;
            } while (doValue);
            printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=bool|event=END|count={0}", count);
            return count;
        }

        public static async System.Threading.Tasks.Task<int> AsyncPatternSwitch(object value, int id)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_PATTERN|test=AsyncPatternSwitch|event=BEGIN|id={0}", id);
            await System.Threading.Tasks.Task.Yield();
            int result = value switch
            {
                null => 0,
                int number when number > 100 && number < 1000 => 1,
                int number when (number & 1) == 0 => 2,
                string { Length: > 5 } text when text is not "ignore" => 3,
                string "A" or "B" or "C" => 4,
                SmallValue { Id: > 0, Value: >= 0 } => 5,
                ThreadRecord(var recordId, var name) when recordId > 0 && name is not null => 6,
                WorkerMode.Compute or WorkerMode.Wait => 7,
                _ => 8
            };
            printf("TRACE|order=ORDERED|area=ASYNC_PATTERN|test=AsyncPatternSwitch|event=END|id={0}|result={1}", id, result);
            return result;
        }

        public static async System.Threading.Tasks.Task<int> AsyncLambdaAndLocalFunctionTests(int input)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=LambdaLocal|event=BEGIN|input={0}", input);
            async System.Threading.Tasks.Task<int> LocalAsync<T>(T ignored, int value)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=LocalAsync|event=BEGIN|value={0}", value);
                await System.Threading.Tasks.Task.Yield();
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=LocalAsync|event=END|value={0}", value);
                return value + 1;
            }
            int captured = input;
            System.Func<int, System.Threading.Tasks.Task<int>> lambda = async value =>
            {
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=AsyncLambda|event=BEGIN|value={0}|captured={1}", value, captured);
                await System.Threading.Tasks.Task.Yield();
                int result = value + captured;
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=AsyncLambda|event=END|result={0}", result);
                return result;
            };
            System.Func<int, System.Threading.Tasks.Task<int>> anonymous = async delegate(int value)
            {
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=AsyncAnonymous|event=BEGIN|value={0}", value);
                await System.Threading.Tasks.Task.Yield();
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=AsyncAnonymous|event=END|value={0}", value);
                return value * 2;
            };
            System.Func<int, System.Threading.Tasks.Task<int>> staticLambda = static async (int value) =>
            {
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=StaticAsyncLambda|event=BEGIN|value={0}", value);
                await System.Threading.Tasks.Task.Yield();
                printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=StaticAsyncLambda|event=END|value={0}", value);
                return value + 3;
            };
            int a = await LocalAsync<int>(0, input);
            int b = await lambda(input + 1);
            int c = await anonymous(input + 2);
            int d = await staticLambda(input + 3);
            int total = a + b + c + d;
            printf("TRACE|order=ORDERED|area=ASYNC_FUNCTIONS|test=LambdaLocal|event=END|total={0}", total);
            return total;
        }

