        public static async System.Threading.Tasks.Task<int> MegaNestedAsyncThreadFlow(int seed)
        {
            printf("TRACE|order=ORDERED|area=MEGA_NEST|test=MegaNestedAsyncThreadFlow|event=BEGIN|seed={0}", seed);
            int accumulator = seed;
            for (int outerFor = 0; outerFor < 3; outerFor++)
            {
                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=1|event=FOR|outerFor={0}|acc={1}", outerFor, accumulator);
                await System.Threading.Tasks.Task.Yield();
                long outerWhile = 0L;
                while (outerWhile < 3L)
                {
                    printf("TRACE|order=ORDERED|area=MEGA_NEST|level=2|event=WHILE|outerFor={0}|outerWhile={1}|acc={2}", outerFor, outerWhile, accumulator);
                    double outerDo = 0.0;
                    do
                    {
                        printf("TRACE|order=ORDERED|area=MEGA_NEST|level=3|event=DO|outerFor={0}|outerWhile={1}|outerDo={2}|acc={3}", outerFor, outerWhile, outerDo, accumulator);
                        bool condition =
                            (((outerFor + (int)outerWhile) & 1) == 0 && outerDo < 2.0 && ((accumulator ^ outerFor) & 3) != 3) ||
                            ((outerFor == 2 && outerWhile >= 1L) && (accumulator % 5 == 0 || accumulator % 7 != 3));
                        printf("TRACE|order=ORDERED|area=MEGA_NEST|level=4|event=IF_EVAL|result={0}|acc={1}", condition, accumulator);
                        if (condition)
                        {
                            printf("TRACE|order=ORDERED|area=MEGA_NEST|level=4|event=IF_TRUE|acc={0}", accumulator);
                            for (uint innerFor = 0U; innerFor < 3U; innerFor++)
                            {
                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=5|event=FOR|innerFor={0}|acc={1}", innerFor, accumulator);
                                decimal innerWhile = 0m;
                                while (innerWhile < 2m)
                                {
                                    printf("TRACE|order=ORDERED|area=MEGA_NEST|level=6|event=WHILE|innerWhile={0}|acc={1}", innerWhile, accumulator);
                                    string innerDo = "A";
                                    do
                                    {
                                        printf("TRACE|order=ORDERED|area=MEGA_NEST|level=7|event=DO|string={0}|acc={1}", innerDo, accumulator);
                                        int switchValue = (accumulator + outerFor + (int)innerFor + (int)innerWhile) & 7;
                                        switch (switchValue)
                                        {
                                            case 0 or 1 when innerDo is "A":
                                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=8|event=SWITCH|case=0_OR_1_A|value={0}", switchValue);
                                                accumulator += 11;
                                                break;
                                            case >= 2 and <= 4:
                                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=8|event=SWITCH|case=2_TO_4|value={0}", switchValue);
                                                accumulator ^= switchValue << 2;
                                                break;
                                            case 5:
                                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=8|event=SWITCH|case=5|value={0}", switchValue);
                                                accumulator = accumulator >>> 1;
                                                break;
                                            default:
                                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=8|event=SWITCH|case=DEFAULT|value={0}", switchValue);
                                                accumulator += switchValue;
                                                break;
                                        }
                                        try
                                        {
                                            printf("TRACE|order=ORDERED|area=MEGA_NEST|level=9|event=TRY|acc={0}", accumulator);
                                            int taskValue = await System.Threading.Tasks.Task.Run(() =>
                                            {
                                                printf("CONCURRENT|order=UNORDERED|area=MEGA_NEST|level=10|event=TASK_RUN|logicalId={0}", switchValue);
                                                return switchValue * 3 + 1;
                                            });
                                            accumulator += taskValue;
                                            if (outerFor == 2 && outerWhile == 2L && innerFor == 2U && innerWhile == 1m && innerDo == "B")
                                            {
                                                printf("TRACE|order=ORDERED|area=MEGA_NEST|level=9|event=THROW_PURPOSE|acc={0}", accumulator);
                                                throw new ThreadStressException(accumulator & 255);
                                            }
                                        }
                                        catch (ThreadStressException exception) when (exception.Code >= 0)
                                        {
                                            printf("TRACE|order=ORDERED|area=MEGA_NEST|level=9|event=CATCH|code={0}|acc={1}", exception.Code, accumulator);
                                            await System.Threading.Tasks.Task.Yield();
                                            accumulator += exception.Code;
                                        }
                                        finally
                                        {
                                            printf("TRACE|order=ORDERED|area=MEGA_NEST|level=9|event=FINALLY|acc={0}", accumulator);
                                        }
                                        innerDo = innerDo == "A" ? "B" : "DONE";
                                        printf("TRACE|order=ORDERED|area=MEGA_NEST|level=7|event=STRING_MUTATE|string={0}", innerDo);
                                    }
                                    while (innerDo != "DONE");
                                    innerWhile += 1m;
                                }
                            }
                        }
                        else
                        {
                            printf("TRACE|order=ORDERED|area=MEGA_NEST|level=4|event=IF_FALSE|acc={0}", accumulator);
                            accumulator -= 7;
                        }
                        outerDo += 1.0;
                    }
                    while (outerDo < 3.0);
                    outerWhile++;
                }
            }
            printf("TRACE|order=ORDERED|area=MEGA_NEST|test=MegaNestedAsyncThreadFlow|event=END|result={0}", accumulator);
            return accumulator;
        }

