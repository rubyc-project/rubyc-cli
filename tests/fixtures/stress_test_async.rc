        public static async System.Threading.Tasks.Task<int> AsyncStringLoop()
        {
            printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=string|event=BEGIN");
            int count = 0;
            string value = "A";
            while (value != "DONE")
            {
                printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=string|loop=WHILE|event=ITERATION|value={0}|count={1}", value, count);
                await System.Threading.Tasks.Task.Yield();
                value = value switch { "A" => "B", "B" => "C", _ => "DONE" };
                count++;
            }
            string doValue = "X";
            do
            {
                printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=string|loop=DO_WHILE|event=ITERATION|value={0}|count={1}", doValue, count);
                await System.Threading.Tasks.Task.Yield();
                doValue = doValue == "X" ? "Y" : "DONE";
                count++;
            } while (doValue != "DONE");
            printf("TRACE|order=ORDERED|area=ASYNC_LOOP|test=string|event=END|count={0}", count);
            return count;
        }

