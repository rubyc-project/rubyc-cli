    public sealed class AsyncEventSource
    {
        public event AsyncVoidDelegate Work;

        public void Raise(int id)
        {
            printf("TRACE|order=ORDERED|area=ASYNC_EVENT|test=Source|event=RAISE|id={0}", id);
            AsyncVoidDelegate handler = Work;
            if (handler is not null)
            {
                handler(id);
            }
