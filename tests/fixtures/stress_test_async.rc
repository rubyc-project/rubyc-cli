            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=struct|event=STATEMENT_BEGIN");
            switch (switchType17)
            {
                case SmallValue { Id: > 0, Value: > 0 } current:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=struct|event=CASE|case=PROPERTY|id={0}", current.Id);
                    accumulator += current.Id;
                    break;
                default:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=struct|event=CASE|case=DEFAULT");
                    break;
            }
            await System.Threading.Tasks.Task.Yield();
            int switchType17Expression = switchType17 switch { { Id: > 0, Value: > 0 } => 41, { Id: 0 } => 42, _ => 43 };
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=struct|event=EXPRESSION|result={0}", switchType17Expression);
            accumulator += switchType17Expression;
            ThreadRecord switchType18 = new ThreadRecord(17,"switch-record");
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=record|event=STATEMENT_BEGIN");
            switch (switchType18)
            {
                case ThreadRecord(var id, var name) when id > 0 && name.Length > 0:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=record|event=CASE|case=POSITIONAL|id={0}|name={1}", id, name);
                    accumulator += id;
                    break;
                default:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=record|event=CASE|case=DEFAULT");
                    break;
            }
            await System.Threading.Tasks.Task.Yield();
            int switchType18Expression = switchType18 switch { ThreadRecord(> 0, string name) when name.Length > 0 => 51, _ => 52 };
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=record|event=EXPRESSION|result={0}", switchType18Expression);
            accumulator += switchType18Expression;
            object switchType19 = (object)18;
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=object|event=STATEMENT_BEGIN");
            switch (switchType19)
            {
                case int number when number > 10:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=object|event=CASE|case=INT_PATTERN|value={0}", number);
                    accumulator += number;
                    break;
                case string text:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=object|event=CASE|case=STRING_PATTERN|value={0}", text);
                    accumulator += text.Length;
                    break;
                default:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=object|event=CASE|case=DEFAULT");
                    break;
            }
            await System.Threading.Tasks.Task.Yield();
            int switchType19Expression = switchType19 switch { int number when number > 10 => 61, string { Length: > 0 } => 62, null => 63, _ => 64 };
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=object|event=EXPRESSION|result={0}", switchType19Expression);
            accumulator += switchType19Expression;
            dynamic dynamicValue = (dynamic)123;
            switch (dynamicValue)
            {
                case int number when number > 100:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=dynamic|event=CASE|case=INT_GT_100|value={0}", number);
                    accumulator += number;
                    break;
                default:
                    printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=dynamic|event=CASE|case=DEFAULT");
                    break;
            }
            int[] listPatternValue = new int[] { 1, 2, 3, 4, 5 };
            int listPatternResult = listPatternValue switch { [1, 2, .. var rest] when rest.Length == 3 => 91, [var first, .., var last] when first < last => 92, [] => 93, _ => 94 };
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|type=array|event=LIST_PATTERN|result={0}", listPatternResult);
            accumulator += listPatternResult;
            printf("TRACE|order=ORDERED|area=SWITCH_TYPE_MATRIX|event=END|accumulator={0}", accumulator);
            return accumulator;
        }

        // Pattern matching after suspension tests boxed values, records, structs, enums and strings.
