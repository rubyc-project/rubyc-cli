            int loop_ushort = await AsyncLoopUSHORT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=ushort|count={0}", loop_ushort);
            int loop_int = await AsyncLoopINT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=int|count={0}", loop_int);
            int loop_uint = await AsyncLoopUINT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=uint|count={0}", loop_uint);
            int loop_long = await AsyncLoopLONG();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=long|count={0}", loop_long);
            int loop_ulong = await AsyncLoopULONG();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=ulong|count={0}", loop_ulong);
            int loop_nint = await AsyncLoopNINT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=nint|count={0}", loop_nint);
            int loop_nuint = await AsyncLoopNUINT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=nuint|count={0}", loop_nuint);
            int loop_char = await AsyncLoopCHAR();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=char|count={0}", loop_char);
            int loop_float = await AsyncLoopFLOAT();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=float|count={0}", loop_float);
            int loop_double = await AsyncLoopDOUBLE();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=double|count={0}", loop_double);
            int loop_decimal = await AsyncLoopDECIMAL();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=decimal|count={0}", loop_decimal);
            int loopString = await AsyncStringLoop();
            int loopBool = await AsyncBoolLoop();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=string|count={0}", loopString);
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=bool|count={0}", loopBool);

            int lambdaLocalResult = await AsyncLambdaAndLocalFunctionTests(60);
            printf("TRACE|order=ORDERED|area=SUITE|event=LAMBDA_LOCAL_RESULT|value={0}", lambdaLocalResult);
            int megaNestedResult = await MegaNestedAsyncThreadFlow(61);
            printf("TRACE|order=ORDERED|area=SUITE|event=MEGA_NEST_RESULT|value={0}", megaNestedResult);

            await RunThreadPrimitiveTests();
            await RunLockAndMonitorTests();
            await RunAtomicAndVolatileTests();
            await RunSynchronizationPrimitiveTests();
            await RunAdvancedLockTests();
            await RunTaskApiTests();
            await RunTaskExceptionAndCancellationTests();
            await RunThreadPoolAndTimerTests();
            await RunParallelAndConcurrentCollectionTests();
            await RunContextFlowTests();
            await RunRaceConditionTests();
            await RunThreadedLifecycleTests();

            printf("TRACE|order=ORDERED|area=SUITE|event=FINAL|sharedCounter={0}|sharedLong={1}|volatileInt={2}|volatileBool={3}", SharedCounter, SharedLongCounter, VolatileInt, VolatileBool);
            printf("TRACE|order=ORDERED|area=SUITE|event=END|return=0");
            return 0;
        }
    }

    file static class FileLocalConcurrencyHelper
    {
        public static int Transform(int value) => (value >>> 1) + 1;
    }
