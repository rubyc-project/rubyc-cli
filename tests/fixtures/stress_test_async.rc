    public class AsyncGeneric5<T1, T2, T3, T4, T5>
    {
        public T1 Value1;
        public T2 Value2;
        public T3 Value3;
        public T4 Value4;
        public T5 Value5;
        public AsyncGeneric5(T1 value1, T2 value2, T3 value3, T4 value4, T5 value5)
        {
            Value1 = value1;
            Value2 = value2;
            Value3 = value3;
