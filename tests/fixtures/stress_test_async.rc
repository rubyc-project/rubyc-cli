                    }
                }
            }
        }

        public static unsafe int UnsafeThreadHelper(int input)
        {
            printf("TRACE|order=ORDERED|area=UNSAFE|test=UnsafeThreadHelper|event=BEGIN|input={0}", input);
            int local = input;
            int* pointer = &local;
            *pointer += 5;
            int* values = stackalloc int[4];
            for (int index = 0; index < 4; index++)
            {
                values[index] = local + index;
                printf("TRACE|order=ORDERED|area=UNSAFE|test=UnsafeThreadHelper|event=STACKALLOC_WRITE|index={0}|value={1}", index, values[index]);
            }
            delegate*<int, int> functionPointer = &UnsafeFunctionPointerTarget;
            int result = functionPointer(values[3]);
            printf("TRACE|order=ORDERED|area=UNSAFE|test=UnsafeThreadHelper|event=END|result={0}", result);
            return result;
        }

        private static int UnsafeFunctionPointerTarget(int value)
        {
            return value * 2;
        }

