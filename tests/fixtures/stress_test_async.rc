        private static void MonitorConsumer()
        {
            printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=CONSUMER_BEGIN|logicalId=10");
            lock (GlobalLock)
            {
                printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=CONSUMER_LOCKED|logicalId=10");
                while (!MonitorReady)
                {
                    printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=WAIT|logicalId=10");
                    System.Threading.Monitor.Wait(GlobalLock);
                    printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=WAKE|logicalId=10");
                }
                int value = MonitorValue;
                printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=CONSUME|logicalId=10|value={0}", value);
            }
            printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=CONSUMER_END|logicalId=10");
        }

        private static void MonitorProducer()
        {
            printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=PRODUCER_BEGIN|logicalId=11");
            lock (GlobalLock)
            {
                MonitorValue = 4242;
                MonitorReady = true;
                printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=PRODUCE|logicalId=11|value={0}", MonitorValue);
                System.Threading.Monitor.PulseAll(GlobalLock);
                printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=PULSE_ALL|logicalId=11");
            }
            printf("THREAD|order=UNORDERED|area=MONITOR|test=WaitPulse|event=PRODUCER_END|logicalId=11");
        }

