    [System.Runtime.CompilerServices.InterpolatedStringHandlerAttribute]
    public ref struct StressInterpolatedStringHandler
    {
        private int _literalLength;
        private int _formattedCount;
        private int _appendCount;

        public StressInterpolatedStringHandler(int literalLength, int formattedCount)
        {
            _literalLength = literalLength;
            _formattedCount = formattedCount;
            _appendCount = 0;
            printf("TRACE|order=ORDERED|area=CS10_HANDLER|event=CTOR|literalLength={0}|formattedCount={1}", literalLength, formattedCount);
        }

        public void AppendLiteral(string text)
        {
            _appendCount++;
            printf("TRACE|order=ORDERED|area=CS10_HANDLER|event=APPEND_LITERAL|length={0}|count={1}", text.Length, _appendCount);
        }

        public void AppendFormatted<T>(T value)
        {
            _appendCount++;
            printf("TRACE|order=ORDERED|area=CS10_HANDLER|event=APPEND_FORMATTED|count={0}", _appendCount);
        }

        public int Score => _literalLength + _formattedCount * 10 + _appendCount * 100;
    }

    public static class ThreadExtensions
    {
        public static int ThreadDouble(this int value)
        {
            printf("TRACE|order=ORDERED|area=LANGUAGE_WORKER|test=ExtensionMethod|event=BODY|value={0}", value);
            return value * 2;
        }
    }

