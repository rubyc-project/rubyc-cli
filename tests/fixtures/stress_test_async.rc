        public static async System.Threading.Tasks.Task<int> RunAwaitInConditionTests()
        {
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=All|event=BEGIN");
            int accumulator = 0;
            bool monster =
                (
                    (await AsyncBoolProbe(60001, true)) &&
                    (
                        (await AsyncBoolProbe(60002, true)) ||
                        (await AsyncBoolProbe(60003, false))
                    ) &&
                    (
                        (await AsyncBoolProbe(60004, false)) ||
                        (
                            (await AsyncBoolProbe(60005, true)) &&
                            (await AsyncBoolProbe(60006, true))
                        )
                    )
                )
                &&
                !
                (
                    (await AsyncBoolProbe(60007, false)) &&
                    (await AsyncBoolProbe(60008, true))
                )
                &&
                (
                    (await AsyncIntProbe(60009, 17)) > 10 &&
                    (await AsyncIntProbe(60010, 23)) < 30 &&
                    (
                        ((await AsyncIntProbe(60011, 7)) & 1) == 1 ||
                        ((await AsyncIntProbe(60012, 8)) & 1) == 0
                    )
                );
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=Monster|event=EVALUATED|result={0}", monster);
            if (monster)
            {
                printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=Monster|event=TRUE");
                accumulator += 100;
            }
            else
            {
                printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=Monster|event=FALSE");
                accumulator -= 100;
            }

            int forIndex = 0;
            for (; await AsyncBoolProbe(60100 + forIndex, forIndex < 4); forIndex++)
            {
                printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=ForCondition|event=BODY|index={0}", forIndex);
                accumulator += forIndex;
                await System.Threading.Tasks.Task.Delay(1);
            }
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=ForCondition|event=END|index={0}", forIndex);

            int whileIndex = 0;
            while (await AsyncBoolProbe(60200 + whileIndex, whileIndex < 4))
            {
                printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=WhileCondition|event=BODY|index={0}", whileIndex);
                accumulator ^= whileIndex + 1;
                whileIndex++;
            }
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=WhileCondition|event=END|index={0}", whileIndex);

            int doIndex = 0;
            do
            {
                printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=DoWhileCondition|event=BODY|index={0}", doIndex);
                accumulator += doIndex * 2;
                doIndex++;
            }
            while (await AsyncBoolProbe(60300 + doIndex, doIndex < 4));
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=DoWhileCondition|event=END|index={0}", doIndex);

            int awaitedSwitchValue = await AsyncIntProbe(60400, 5);
            switch (awaitedSwitchValue)
            {
                case 0:
                    printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=AwaitedSwitch|event=CASE|case=0");
                    accumulator += 1;
                    break;
                case > 0 and < 5:
                    printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=AwaitedSwitch|event=CASE|case=1_TO_4");
                    accumulator += 2;
                    break;
                case >= 5 and <= 10:
                    printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=AwaitedSwitch|event=CASE|case=5_TO_10");
                    accumulator += 3;
                    break;
                default:
                    printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=AwaitedSwitch|event=CASE|case=DEFAULT");
                    accumulator += 4;
                    break;
            }

            WorkerMode mode = WorkerMode.Compute;
            int switchExpressionAwait = mode switch
            {
                WorkerMode.Compute => await AsyncIntProbe(60501, 31),
                WorkerMode.Wait => await AsyncIntProbe(60502, 32),
                WorkerMode.Fault => await AsyncIntProbe(60503, 33),
                _ => await AsyncIntProbe(60504, 34)
            };
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=SwitchExpressionAwait|event=RESULT|value={0}", switchExpressionAwait);
            accumulator += switchExpressionAwait;

            int conditionalAwait = await AsyncBoolProbe(60600, true)
                ? await AsyncIntProbe(60601, 41)
                : await AsyncIntProbe(60602, 42);
            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=ConditionalAwait|event=RESULT|value={0}", conditionalAwait);
            accumulator += conditionalAwait;

            printf("TRACE|order=ORDERED|area=AWAIT_CONDITION|test=All|event=END|accumulator={0}", accumulator);
            return accumulator;
        }

