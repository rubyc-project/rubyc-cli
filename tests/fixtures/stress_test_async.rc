            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=string|event=RESULT|value={0}", patternResult3);
            SmallValue patternValue4 = new SmallValue(19, 20L);
            int patternResult4 = await AsyncPatternSwitch(patternValue4, 4);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=struct|event=RESULT|value={0}", patternResult4);
            ThreadRecord patternValue5 = new ThreadRecord(21,"pattern-record");
            int patternResult5 = await AsyncPatternSwitch(patternValue5, 5);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=record|event=RESULT|value={0}", patternResult5);
            int[] patternValue6 = new int[] { 1, 2, 3, 4 };
            int patternResult6 = await AsyncPatternSwitch(patternValue6, 6);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=array|event=RESULT|value={0}", patternResult6);
            WorkerMode patternValue7 = WorkerMode.Compute;
            int patternResult7 = await AsyncPatternSwitch(patternValue7, 7);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=enum|event=RESULT|value={0}", patternResult7);
            object patternValue8 = (object)999;
            int patternResult8 = await AsyncPatternSwitch(patternValue8, 8);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=object|event=RESULT|value={0}", patternResult8);
            object patternValue9 = null;
            int patternResult9 = await AsyncPatternSwitch(patternValue9, 9);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=null|event=RESULT|value={0}", patternResult9);
            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|event=END");
        }

        // The first counter is intentionally racy; the second uses Interlocked as the control case.
        public static async System.Threading.Tasks.Task RunRaceConditionTests()
        {
            printf("TRACE|order=ORDERED|area=RACE|test=All|event=BEGIN");
            int racyCounter = 0;
            System.Threading.Tasks.Task[] raceTasks = new System.Threading.Tasks.Task[8];
            for (int worker = 0; worker < raceTasks.Length; worker++)
            {
                int logicalId = worker;
                raceTasks[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    for (int index = 0; index < 1000; index++) racyCounter++;
                    printf("CONCURRENT|order=UNORDERED|area=RACE|test=Unsynchronized|event=WORKER_END|logicalId={0}", logicalId);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(raceTasks);
            printf("RACE|order=ORDERED|area=RACE|test=Unsynchronized|event=RESULT|actual={0}|theoreticalMax=8000|comparison=NONDETERMINISTIC", racyCounter);
            SharedCounter = 0;
            for (int worker = 0; worker < raceTasks.Length; worker++)
            {
                int logicalId = worker;
                raceTasks[worker] = System.Threading.Tasks.Task.Run(() =>
                {
                    for (int index = 0; index < 1000; index++) System.Threading.Interlocked.Increment(ref SharedCounter);
                    printf("CONCURRENT|order=UNORDERED|area=RACE|test=Interlocked|event=WORKER_END|logicalId={0}", logicalId);
                });
            }
            await System.Threading.Tasks.Task.WhenAll(raceTasks);
            printf("TRACE|order=ORDERED|area=RACE|test=Interlocked|event=RESULT|actual={0}|expected=8000", SharedCounter);
            printf("TRACE|order=ORDERED|area=RACE|test=All|event=END");
        }

        // Objects are constructed in nested scopes and consumed by worker tasks before finalization.
        public static async System.Threading.Tasks.Task RunThreadedLifecycleTests()
        {
            printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=BEGIN");
            for (int scopeId = 0; scopeId < 40; scopeId++)
            {
                printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=SCOPE_BEGIN|scope={0}", scopeId);
                {
                    printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=CREATE_BASE|scope={0}", scopeId);
                    WorkPayload payload = new WorkPayload(scopeId, "scope-base");
                    int read = payload.ReadAll();
                    printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=BASE_READY|scope={0}|read={1}", scopeId, read);
                    {
                        printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=CREATE_DERIVED|scope={0}", scopeId);
                        DerivedWorkPayload derived = new DerivedWorkPayload(scopeId + 10, scopeId + 20, "scope-derived");
                        int protectedValue = derived.ReadProtectedFromDerived();
                        printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=DERIVED_READY|scope={0}|protected={1}", scopeId, protectedValue);
                        int taskResult = await System.Threading.Tasks.Task.Run(() =>
                        {
                            printf("CONCURRENT|order=UNORDERED|area=THREADED_LIFECYCLE|event=TASK_USE|scope={0}|public={1}|derived={2}", scopeId, derived.PublicValue, derived.DerivedValue);
                            return derived.PublicValue + derived.DerivedValue;
                        });
                        printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=TASK_RESULT|scope={0}|result={1}", scopeId, taskResult);
                    }
                    printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=DERIVED_SCOPE_END|scope={0}", scopeId);
                }
                printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=BASE_SCOPE_END|scope={0}", scopeId);
            }
            System.GC.Collect();
            System.GC.WaitForPendingFinalizers();
            printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=FINALIZER_DRAIN_REQUESTED");
            printf("TRACE|order=ORDERED|area=THREADED_LIFECYCLE|event=END");
        }

        // Run sections sequentially so section boundaries remain easy for fixture parsers to identify.
        public static async System.Threading.Tasks.Task<int> Main()
        {
            printf("TRACE|order=ORDERED|area=SUITE|event=BEGIN|name=CoreCSharp11AsyncThreadMegaStress");
            printf("TRACE|order=ORDERED|area=SUITE|event=OUTPUT_SCHEMA|ordered=TRACE|unordered=CONCURRENT|race=RACE|finalizer=FINALIZER");

            await RunAsyncLanguageFeatureTests();
            await RunAsyncEventTests();
            await RunAsyncGenericMatrix();
            await RunAsyncPatternMatrix();
            int switchMatrixResult = await RunAsyncSwitchTypeMatrix();
            printf("TRACE|order=ORDERED|area=SUITE|event=SWITCH_MATRIX_RESULT|value={0}", switchMatrixResult);

            int loop_byte = await AsyncLoopBYTE();
            printf("TRACE|order=ORDERED|area=SUITE|event=LOOP_RESULT|type=byte|count={0}", loop_byte);
            int loop_sbyte = await AsyncLoopSBYTE();
