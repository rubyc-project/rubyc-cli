            printf("TRACE|order=ORDERED|area=PATTERN_MATRIX|type=long|event=RESULT|value={0}", patternResult1);
            double patternValue2 = 350.5;
            int patternResult2 = await AsyncPatternSwitch(patternValue2, 2);
